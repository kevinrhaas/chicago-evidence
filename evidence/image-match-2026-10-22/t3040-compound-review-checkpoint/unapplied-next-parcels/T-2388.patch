+def _cupola(b: MeshBuilder, p: FortStructureParams, ridge_z: float) -> None:
+    """An opt-in timber drum and pyramidal cap, not a lighthouse lantern.
+
+    T-2388: occurrence follows the second-fort blockhouse in Kurz & Allison
+    panel 5. The dimensions, central mounting, three vent bands per face and
+    cap overhang are reconstructed; L-second-fort-cupola-2388 owns them.
+    The drum's skirt intersects the main roof instead of floating over its
+    sloping corners. Existing structures with cupola=False emit no new faces.
+    """
+    conf = p.worst_conf("cupola", "cupola_width_m", "cupola_height_m",
+                        "cupola_roof_pitch_deg", "roof_pitch_deg")
+    width = p.cupola_width_m
+    half = width / 2.0
+    cx, cy = p.width_m / 2.0, p.depth_m / 2.0
+    x0, x1, y0, y1 = cx - half, cx + half, cy - half, cy + half
+    # The 0.05 m buried margin closes the roof/drum junction at every edge.
+    base = ridge_z - half * math.tan(math.radians(p.roof_pitch_deg)) - 0.05
+    head = ridge_z + p.cupola_height_m
+    b.add_box(x0, y0, base, x1, y1, head, conf, M_WALL,
+              skip=("bottom", "top"))
+    # The print cannot resolve a vent pattern. These bands represent a
+    # ventilated wooden drum; they are not counted historical openings.
+    inset = width * 0.16
+    for i in range(3):
+        z0 = ridge_z + p.cupola_height_m * (0.18 + 0.24 * i)
+        z1 = z0 + p.cupola_height_m * 0.10
+        for plane, outward in ((y0 - 0.012, -1), (y1 + 0.012, 1)):
+            _panel(b, "y", plane, x0 + inset, x1 - inset,
+                   z0, z1, outward, conf, M_DARK)
+        for plane, outward in ((x0 - 0.012, -1), (x1 + 0.012, 1)):
+            _panel(b, "x", plane, y0 + inset, y1 - inset,
+                   z0, z1, outward, conf, M_DARK)
+    _hip_roof(b, x0, y0, x1, y1, head, p.cupola_roof_pitch_deg,
+              conf, pyramid=True, overhang=0.12)
 
 

+              'run_id':os.environ['RUN_ID'],'run_attempt':os.environ['RUN_ATTEMPT'],
+              'source_files':{f:hashlib.sha256((app/f).read_bytes()).hexdigest() for f in files}}
+          (root/'source-binding.json').write_text(json.dumps(binding,indent=2)+'\n')

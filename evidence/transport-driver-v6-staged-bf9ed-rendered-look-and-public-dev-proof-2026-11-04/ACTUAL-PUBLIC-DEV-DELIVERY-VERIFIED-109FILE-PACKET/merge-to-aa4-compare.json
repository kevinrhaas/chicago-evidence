l":"https://github.com/kevinrhaas/chicago/commit/9881d782370d612c3ca521df383d67b1bb48487f"}]}],"files":[{"sha":"86b4f3b86c0bc6179eba9dcc597a8d4b1ba00109","filename":"chicago/4d/changelog.d/T-3088.json","status":"removed","additions":0,"deletions":10,"changes":10,"blob_url":"https://github.com/kevinrhaas/chicago/blob/9881d782370d612c3ca521df383d67b1bb48487f/chicago%2F4d%2Fchangelog.d%2FT-3088.json","raw_url":"https://github.com/kevinrhaas/chicago/raw/9881d782370d612c3ca521df383d67b1bb48487f/chicago%2F4d%2Fchangelog.d%2FT-3088.json","contents_url":"https://api.github.com/repos/kevinrhaas/chicago/contents/chicago%2F4d%2Fchangelog.d%2FT-3088.json?ref=9881d782370d612c3ca521df383d67b1bb48487f","patch":"@@ -1,10 +0,0 @@\n-{\n-  \"title\": \"Otis and Hans drive through town\",\n-  \"kind\": \"change\",\n-  \"items\": [\n-    \"The horse in the Western Hotel wagon yard has a thinner upper eyelid and a less raised upper-eye contour while retaining its eye opening, body proportions and planted stance.\",\n-    \"The horse in the Western Hotel yard can make reconstructed gentle head and neck movements while standing with planted hooves.\",\n-    \"Otis Bardwell looks around and breathes while standing in the tavern yard. His appearance and actions remain reconstructions.\",\n-    \"In Full or Balanced detail, Otis Bardwell and Hans Johnson drive reconstructed circuits in1835 and1904. Walk up and use Interact to stop or continue a vehicle, or open its driver’s person card.\"\n-  ]\n-}"},{"sha":"e414d41c44f51f7edc0fc320ff0ad5ab17f0ac25","filename":"chicago/4d/renderers/web/js/changelog.js","status":"modified","additions":7,"deletions":0,"changes":7,"blob_url":"https://github.com/kevinrhaas/chicago/blob/aa4f5cc8057bdd04a20c832a05bf4e4195807347/chicago%2F4d%2Frenderers%2Fweb%2Fjs%2Fchangelog.js","raw_url":"https://github.com/kevinrhaas/chicago/raw/aa4f5cc8057bdd04a20c832a05bf4e4195807347/chicago%2F4d%2Frenderers%2Fweb%2Fjs%2Fchangelog.js","contents_url":"https://api.github.com/repos/kevinrhaas/chicago/contents/chicago%2F4d%2Frenderers%2Fweb%2Fjs%2Fchangelog.js?ref=aa4f5cc8057bdd04a20c832a05bf4e4195807347","patch":"@@ -1,4 +1,11 @@\n export const CHANGELOG = [ // newest first\n+  { v: 2634, ts: '2026-11-04T01:30:25.653Z', date: 'Nov 3, 2026, 7:30 PM CT', title: 'Otis and Hans drive through town', kind: 'change',\n+    items: [\n+      'The horse in the Western Hotel wagon yard has a thinner upper eyelid and a less raised upper-eye contour while retaining its eye opening, body proportions and planted stance.',\n+      'The horse in the Western Hotel yard can make reconstructed gentle head and neck movements while standing with planted hooves.',\n+      'Otis Bardwell looks around and breathes while standing in the tavern yard. His appearance and actions remain reconstructions.',\n+      'In Full or Balanced detail, Otis Bardwell and Hans Johnson drive reconstructed circuits in1835 and1904. Walk up and use Interact to stop or continue a vehicle, or open its driver’s person card.',\n+    ] },\n   { v: 2633, ts: '2026-11-04T00:40:20.258Z', date: 'Nov 3, 2026, 6:40 PM CT', title: '1919 Prairie: stone corners and bands on its rear wings', kind: 'feature',\n     items: [\n       'Along the north side of Marshall Field Jr.\\'s house at 1919 Prairie Avenue, the corners of both rear wings now rise in pale stone blocks, long and short in turn, from the ground to the eaves, as a 1919 picture of the house shows them.',"}]}
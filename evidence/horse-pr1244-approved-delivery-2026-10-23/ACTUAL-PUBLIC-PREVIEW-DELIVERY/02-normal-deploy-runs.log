ml_url":"https://github.com/kevinrhaas","followers_url":"https://api.github.com/users/kevinrhaas/followers","following_url":"https://api.github.com/users/kevinrhaas/following{/other_user}","gists_url":"https://api.github.com/users/kevinrhaas/gists{/gist_id}","starred_url":"https://api.github.com/users/kevinrhaas/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kevinrhaas/subscriptions","organizations_url":"https://api.github.com/users/kevinrhaas/orgs","repos_url":"https://api.github.com/users/kevinrhaas/repos","events_url":"https://api.github.com/users/kevinrhaas/events{/privacy}","received_events_url":"https://api.github.com/users/kevinrhaas/received_events","type":"User","user_view_type":"public","site_admin":false},"run_attempt":1,"referenced_workflows":[],"run_started_at":"2026-10-23T16:15:07Z","triggering_actor":{"login":"kevinrhaas","id":4193586,"node_id":"MDQ6VXNlcjQxOTM1ODY=","avatar_url":"https://avatars.githubusercontent.com/u/4193586?v=4","gravatar_id":"","url":"https://api.github.com/users/kevinrhaas","html_url":"https://github.com/kevinrhaas","followers_url":"https://api.github.com/users/kevinrhaas/followers","following_url":"https://api.github.com/users/kevinrhaas/following{/other_user}","gists_url":"https://api.github.com/users/kevinrhaas/gists{/gist_id}","starred_url":"https://api.github.com/users/kevinrhaas/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kevinrhaas/subscriptions","organizations_url":"https://api.github.com/users/kevinrhaas/orgs","repos_url":"https://api.github.com/users/kevinrhaas/repos","events_url":"https://api.github.com/users/kevinrhaas/events{/privacy}","received_events_url":"https://api.github.com/users/kevinrhaas/received_events","type":"User","user_view_type":"public","site_admin":false},"jobs_url":"https://api.github.com/repos/kevinrhaas/chicago/actions/runs/39985213079/jobs","logs_url":"https://api.github.com/repos/kevinrhaas/chicago/actions/runs/39985213079/logs","check_suite_url":"https://api.github.com/repos/kevinrhaas/chicago/check-suites/108380575204","artifacts_url":"https://api.github.com/repos/kevinrhaas/chicago/actions/runs/39985213079/artifacts","cancel_url":"https://api.github.com/repos/kevinrhaas/chicago/actions/runs/39985213079/cancel","rerun_url":"https://api.github.com/repos/kevinrhaas/chicago/actions/runs/39985213079/rerun","previous_attempt_url":null,"workflow_url":"https://api.github.com/repos/kevinrhaas/chicago/actions/workflows/365585059","head_commit":{"id":"ea22b3c3055d0c6d40f213273138103fbc98cee3","tree_id":"8d3b97506ae0ddd9db79ae6b81559ac7314ff876","message":"T-3070: the gate asserts a nested .git stays out of the roof-id sweeps (#1241)\n\nThe PR and dev gate died with exit 143 (\"the runner has received a shutdown\nsignal\") on every run from about 09:50 to 13:08 UTC on 2026-10-23. T-3069 (#1238)\nfound the cause: `execute_roof_redeal.py --check-migration` and `--check-blocks`\nread the tickets clone's 1.9 GB `.git` object pack as text, about 10 GB resident\neach, and a 16 GB runner ran out of memory. It fixed that by adding \".git\" to\n`roof_id_pins.NOT_A_SOURCE_DIR`. All nine gate runs since it merged (dev\n587d8f331 through 793804312 and five PR heads) are green, so the gate reaches a\nverdict again. T-3071's blobless tickets clone is a second, independent defence\n(tickets/.git is now about 29 MB).\n\nNothing asserted the rule, so a later edit to NOT_A_SOURCE_DIR could have brought\nthe failure back without any test noticing. The pins self-test now checks that\na nested pack and HEAD are outside the sweep, that ticket files and a `.gitkeep`\nare still inside it, and that the live tree's source list holds no `.git`\nsegment. It also runs a mutation: with \".git\" removed, the pack is swept again.\nReverting the T-3069 line by hand makes the self-test fail.\n\nChangelog: none, because this only changes the gate and visitors see nothing.\n\nCo-authored-by: polecat-steward <steward@polecat.live>\nCo-authored-by: Claude Opus 5.5 <noreply@anthropic.com>","timestamp":"2026-10-23T16:15:04Z","author":{"name":"Kevin Haas","email":"kevinroberthaas@gmail.com"},"committer":{"name":"GitHub","email":"noreply@github.com"}},"repository":{"id":1384299918,"node_id":"R_kgDOUoK9jg","name":"chicago","full_name":"kevinrhaas/chicago","private":false,"owner":{"login":"kevinrhaas","id":4193586,"node_id":"MDQ6VXNlcjQxOTM1ODY=","avatar_url":"https://avatars.githubusercontent.com/u/4193586?v=4","gravatar_id":"","url":"https://api.github.com/users/kevinrhaas","html_url":"https://github.com/kevinrhaas","followers_url":"https://api.github.com/users/kevinrhaas/followers","following_url":"https://api.github.com/users/kevinrhaas/following{/other_user}","gists_url":"https://api.github.com/users/kevinrhaas/gists{/gist_id}","starred_url":"https://api.github.com/users/kevinrhaas/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kevinrhaas/subscriptions","organizations_url":"https://api.github.com/users/kevinrhaas/orgs","repos_url":"https://api.github.com/users/kevinrhaas/repos","events_url":"https://api.github.com/users/kevinrhaas/events{/privacy}","received_events_url":"https://api.github.com/users/kevinrhaas/received_events","type":"User","user_view_type":"public","site_admin":false},"html_url":"https://github.com/kevinrhaas/chicago","description":null,"fork":false,"url":"https://api.github.com/repos/kevinrhaas/chicago","forks_url":"https://api.github.com/repos/kevinrhaas/chicago/forks","keys_url":"https://api.github.com/repos/kevinrhaas/chicago/keys{/key_id}","collaborators_url":"https://api.github.com/repos/kevinrhaas/chicago/collaborators{/collaborator}","teams_url":"https://api.github.com/repos/kevinrhaas/chicago/teams","hooks_url":"https://api.github.com/repos/kevinrhaas/chicago/hooks","issue_events_url":"https://api.github.com/repos/kevinrhaas/chicago/issues/events{/number}","events_url":"https://api.github.com/repos/kevinrhaas/chicago/events","assignees_url":"https://api
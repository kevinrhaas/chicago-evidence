sts{/gist_id}","starred_url":"https://api.github.com/users/kevinrhaas/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kevinrhaas/subscriptions","organizations_url":"https://api.github.com/users/kevinrhaas/orgs","repos_url":"https://api.github.com/users/kevinrhaas/repos","events_url":"https://api.github.com/users/kevinrhaas/events{/privacy}","received_events_url":"https://api.github.com/users/kevinrhaas/received_events","type":"User","user_view_type":"public","site_admin":false},"jobs_url":"https://api.github.com/repos/kevinrhaas/chicago/actions/runs/40003107986/jobs","logs_url":"https://api.github.com/repos/kevinrhaas/chicago/actions/runs/40003107986/logs","check_suite_url":"https://api.github.com/repos/kevinrhaas/chicago/check-suites/108430829658","artifacts_url":"https://api.github.com/repos/kevinrhaas/chicago/actions/runs/40003107986/artifacts","cancel_url":"https://api.github.com/repos/kevinrhaas/chicago/actions/runs/40003107986/cancel","rerun_url":"https://api.github.com/repos/kevinrhaas/chicago/actions/runs/40003107986/rerun","previous_attempt_url":null,"workflow_url":"https://api.github.com/repos/kevinrhaas/chicago/actions/workflows/365585059","head_commit":{"id":"e13219c706b5bfb7d65c795e7c04b7bdb84ac454","tree_id":"5d87466d5aeda84c30a60f6cf14dbebaef00ffbc","message":"T-3025: Glessner's roofs ruled red tile; the prints' grey is not shown (#1245)\n\nThe roofs, the stable cupola's pyramid included, read slate-grey in every print\nwhere the record lays red baked, unglazed terracotta tile. Ruled on the two\nwritten sources: Glessner's 1923 description of the house as built (\"The roofs\nare of red baked tiles, unglazed\", re-read in the HABS transcription, data\np. 13) and HABS's 1963 survey, which found terracotta under tar (data p. 21)\nand so excludes slate. Every print is monochrome: the 1963-65 HABS prints show\nthe tar, and the record's red tile reduced to luminance through the Cornell\ncamera reads the same slate-grey. Nothing in the record moves; nothing is\nrebaked. The three match records' covering items close as `not shown` with\nthe ruling.\n\nThe Cornell print's courses read about 6.4 in against the model's 5 in\n(three column bands, ratio 1.28); that is a module question, filed as T-3072.\n\nCo-authored-by: polecat-steward <steward@polecat.live>\nCo-authored-by: Claude Opus 5.5 <noreply@anthropic.com>","timestamp":"2026-10-23T18:25:04Z","author":{"name":"Kevin Haas","email":"kevinroberthaas@gmail.com"},"committer":{"name":"GitHub","email":"noreply@github.com"}},"repository":{"id":1384299918,"node_id":"R_kgDOUoK9jg","name":"chicago","full_name":"kevinrhaas/chicago","private":false,"owner":{"login":"kevinrhaas","id":4193586,"node_id":"MDQ6VXNlcjQxOTM1ODY=","avatar_url":"https://avatars.githubusercontent.com/u/4193586?v=4","gravatar_id":"","url":"https://api.github.com/users/kevinrhaas","html_url":"https://github.com/kevinrhaas","followers_url":"https://api.github.com/users/kevinrhaas/followers","following_url":"https://api.github.com/users/kevinrhaas/following{/other_user}","gists_url":"https://api.github.com/users/kevinrhaas/gists{/gist_id}","starred_url":"https://api.github.com/users/kevinrhaas/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kevinrhaas/subscriptions","organizations_url":"https://api.github.com/users/kevinrhaas/orgs","repos_url":"https://api.github.com/users/kevinrhaas/repos","events_url":"https://api.github.com/users/kevinrhaas/events{/privacy}","received_events_url":"https://api.github.com/users/kevinrhaas/received_events","type":"User","user_view_type":"public","site_admin":false},"html_url":"https://github.com/kevinrhaas/chicago","description":null,"fork":false,"url":"https://api.github.com/repos/kevinrhaas/chicago","forks_url":"https://api.github.com/repos/kevinrhaas/chicago/forks","keys_url":"https://api.github.com/repos/kevinrhaas/chicago/keys{/key_id}","collaborators_url":"https://api.github.com/repos/kevinrhaas/chicago/collaborators{/
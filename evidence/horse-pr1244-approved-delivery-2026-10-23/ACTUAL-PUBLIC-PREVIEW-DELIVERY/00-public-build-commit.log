{"sha":"eb1a0d11a96767a715a136ee43d94097ddf5b9cd","node_id":"C_kwDOUoK9jtoAKGViMWEwZDExYTk2NzY3YTcxNWExMzZlZTQzZDk0MDk3ZGRmNWI5Y2Q","commit":{"author":{"name":"polecat-ci","email":"ci@polecat.live","date":"2026-10-23T18:29:15Z"},"committer":{"name":"polecat-ci","email":"ci@polecat.live","date":"2026-10-23T18:29:15Z"},"message":"changelog: fold entry files into changelog.js; re-derive merged counts\n\nFolded and stamped by chicago-4d-changelog-fold.yml after the merge; data/liberties.json and source_use_coverage.md re-derived.","tree":{"sha":"bd481e244701075d1a398c12f934d9e85a87de22","url":"https://api.github.com/repos/kevinrhaas/chicago/git/trees/bd481e244701075d1a398c12f934d9e85a87de22"},"url":"https://api.github.com/repos/kevinrhaas/chicago/git/commits/eb1a0d11a96767a715a136ee43d94097ddf5b9cd","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/kevinrhaas/chicago/commits/eb1a0d11a96767a715a136ee43d94097ddf5b9cd","html_url":"https://github.com/kevinrhaas/chicago/commit/eb1a0d11a96767a715a136ee43d94097ddf5b9cd","comments_url":"https://api.github.com/repos/kevinrhaas/chicago/commits/eb1a0d11a96767a715a136ee43d94097ddf5b9cd/comments","author":null,"committer":null,"parents":[{"sha":"e3baf9323b06a1fb66d3a506b7430f9f10cd7854","url":"https://api.github.com/repos/kevinrhaas/chicago/commits/e3baf9323b06a1fb66d3a506b7430f9f10cd7854","html_url":"https://github.com/kevinrhaas/chicago/commit/e3baf9323b06a1fb66d3a506b7430f9f10cd7854"}],"stats":{"total":22,"additions":8,"deletions":14},"files":[{"sha":"b11f693f7de8b83b1a9b072509a93e238b7aadac","filename":"chicago/4d/changelog.d/T-3025.json","status":"removed","additions":0,"deletions":7,"changes":7,"blob_url":"https://github.com/kevinrhaas/chicago/blob/e3baf9323b06a1fb66d3a506b7430f9f10cd7854/chicago%2F4d%2Fchangelog.d%2FT-3025.json","raw_url":"https://github.com/kevinrhaas/chicago/raw/e3baf9323b06a1fb66d3a506b7430f9f10cd7854/chicago%2F4d%2Fchangelog.d%2FT-3025.json","contents_url":"https://api.github.com/repos/kevinrhaas/chicago/contents/chicago%2F4d%2Fchangelog.d%2FT-3025.json?ref=e3baf9323b06a1fb66d3a506b7430f9f10cd7854","patch":"@@ -1,7 +0,0 @@\n-{\n-  \"title\": \"Glessner's roofs ruled red tile, though every old print shows grey\",\n-  \"kind\": \"change\",\n-  \"items\": [\n-    \"Glessner House keeps its red, unglazed clay tile roofs, the stable cupola's included. Glessner's own account of the house names them, and the 1963 survey found clay tile under a later coat of tar. Old photographs show the roofs grey because they are black and white, and the 1960s ones show the tar.\"\n-  ]\n-}"},{"sha":"1ae67226bd3f27a82c667c5e780e52fe45dc5883","filename":"chicago/4d/changelog.d/T-3063.json","status":"removed","additions":0,"deletions":7,"changes":7,"blob_url":"https://github.com/kevinrhaas/chicago/blob/e3baf9323b06a1fb66d3a506b7430f9f10cd7854/chicago%2F4d%2Fchangelog.d%2FT-3063.json","raw_url":"https://github.com/kevinrhaas/chicago/raw/e3baf9323b06a1fb66d3a506b7430f9f10cd7854/chicago%2F4d%2Fchangelog.d%2FT-3063.json","contents_url":"https://api.github.com/repos/kevinrhaas/chicago/contents/chicago%2F4d%2Fchangelog.d%2FT-3063.json?ref=e3baf9323b06a1fb66d3a506b7430f9f10cd7854","patch":"@@ -1,7 +0,0 @@\n-{\n-  \"title\": \"1811 Prairie's south wall now runs level behind its tall chimney\",\n-  \"kind\": \"improvement\",\n-  \"items\": [\n-    \"Behind the tall chimney, the top of 1811 Prairie's brick south wall no longer slopes down toward the back. It now runs level back to the end of the front block, as both old photographs show it, with the second chimney standing up from it.\"\n-  ]\n-}"},{"sha":"571ed50f195ee0741841921d64a79da0e0d1b852","filename":"chicago/4d/renderers/web/js/changelog.js","status":"modified","additions":8,"deletions":0,"changes":8,"blob_url":"https://github.com/kevinrhaas/chicago/blob/eb1a0d11a96767a715a136ee43d94097ddf5b9cd/chicago%2F4d%2Frenderers%2Fweb%2Fjs%2Fchangelog.js","raw_url":"https://github.com/kevinrhaas/chicago/raw/eb1a0d11a96767a715a136ee43d94097ddf5b9cd/chicago%2F4d%2Frenderers%2Fweb%2Fjs%2Fchangelog.js","contents_url":"https://api.github.com/repos/kevinrhaas/chicago/contents/chicago%2F4d%2Frenderers%2Fweb%2Fjs%2Fchangelog.js?ref=eb1a0d11a96767a715a136ee43d94097ddf5b9cd","patch":"@@ -1,4 +1,12 @@\n export const CHANGELOG = [ // newest first\n+  { v: 2225, ts: '2026-10-23T18:28:23.022Z', date: 'Oct 23, 2026, 1:28 PM CT', title: '1811 Prairie\\'s south wall now runs level behind its tall chimney', kind: 'improvement',\n+    items: [\n+      'Behind the tall chimney, the top of 1811 Prairie\\'s brick south wall no longer slopes down toward the back. It now runs level back to the end of the front block, as both old photographs show it, with the second chimney standing up from it.',\n+    ] },\n+  { v: 2224, ts: '2026-10-23T18:28:23.022Z', date: 'Oct 23, 2026, 1:28 PM CT', title: 'Glessner\\'s roofs ruled red tile, though every old print shows grey', kind: 'change',\n+    items: [\n+      'Glessner House keeps its red, unglazed clay tile roofs, the stable cupola\\'s included. Glessner\\'s own account of the house names them, and the 1963 survey found clay tile under a later coat of tar. Old photographs show the roofs grey because they are black and white, and the 1960s ones show the tar.',\n+    ] },\n   { v: 2223, ts: '2026-10-23T16:13:10.592Z', date: 'Oct 23, 2026, 11:13 AM CT', title: 'Indiana Avenue fills in from 16th to 18th Street', kind: 'feature',\n     items: [\n       'Look west between the houses on Prairie\\'s west side from 16th to 18th Street: Indiana Avenue\\'s east side is no longer bare ground behind them. Five brick houses stand at 1615-1617, 1623, 1703 and 1713, and a row of five more at 209-217 East 16th Street, with six stables on the alley.',"}]}
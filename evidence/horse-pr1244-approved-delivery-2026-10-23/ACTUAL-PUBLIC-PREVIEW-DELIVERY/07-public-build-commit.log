1828785,\n+    \"three_mm_segment_error_m\": 0.0029031427887960537\n+  },\n+  \"loop\": {\n+    \"loopP\": 0,\n+    \"loopR\": 0,\n+    \"loopSkin\": 0\n+  },\n+  \"neutral_residual_m\": 1.5933575216839742e-07,\n+  \"original_physical_limits\": {\n+    \"stance_patch_drift_m\": 1e-05,\n+    \"segment_length_error_m\": 1e-09,\n+    \"loop_position_m\": 1e-09,\n+    \"loop_rotation_matrix_abs\": 1e-09,\n+    \"negative_control_min_detected_m\": 0.001,\n+    \"minimum_triangle_edge_ratio\": 0.9,\n+    \"maximum_triangle_edge_ratio\": 1.1,\n+    \"minimum_triangle_area_ratio\": 0.8,\n+    \"maximum_triangle_area_ratio\": 1.2,\n+    \"allowed_rest_relative_triangle_normal_dot_negative\": 0,\n+    \"minimum_all_surface_y_m\": -1e-05,\n+    \"minimum_seam_gap_tolerance_m\": 1e-06\n+  },\n+  \"elapsed_ms\": 4051.0999999940395,\n+  \"scope\": \"Actual standard-loader/Mixer imported13track standing clip at65keys+64midpoints. No renderer/GPUfloat-arithmetic/continuous collision/photographic/app/independentheadtail/walking acceptance.\",\n+  \"raw_result_sha256\": \"52841c26764f1ef88def84275da992cc3d51d1289b62cde3d6976155f8e55997\",\n+  \"summary_scope\": \"Exact top-level results copied from actual root-run loaded129 V2, excluding large pose/matrix list; no new evaluation.\"\n+}"},{"sha":"1abb80e30ccb4c95e6518ba069439a7e63f35264","filename":"chicago/4d/data/transport/parked/standing-horses.json","status":"added","additions":77,"deletions":0,"changes":77,"blob_url":"https://github.com/kevinrhaas/chicago/blob/fa115d72534e234fe5ac7b94fd2f1a3eb38065c8/chicago%2F4d%2Fdata%2Ftransport%2Fparked%2Fstanding-horses.json","raw_url":"https://github.com/kevinrhaas/chicago/raw/fa115d72534e234fe5ac7b94fd2f1a3eb38065c8/chicago%2F4d%2Fdata%2Ftransport%2Fparked%2Fstanding-horses.json","contents_url":"https://api.github.com/repos/kevinrhaas/chicago/contents/chicago%2F4d%2Fdata%2Ftransport%2Fparked%2Fstanding-horses.json?ref=fa115d72534e234fe5ac7b94fd2f1a3eb38065c8","patch":"@@ -0,0 +1,77 @@\n+{\n+  \"schema\": \"standing_horse_placements_v1\",\n+  \"status\": \"Conditional replacement of same1835development horse with reconstructed planted body shifts; actual loaded129 V2 passed. App/yard/mobile/render/photo qualification remains pending.\",\n+  \"models\": {\n+    \"sevket_horse_standing_development_01\": {\n+      \"file\": \"transport/standing-horse/horse-sevket-v16-planted-standing-v1.glb\",\n+      \"sidecar\": \"transport/parked/horse-sevket-sidecar.json\"\n+    }\n+  },\n+  \"scenes\": {\n+    \"1835\": [\n+      {\n+        \"id\": \"western_hotel_yard_standing_horse_01\",\n+        \"model\": \"sevket_horse_standing_development_01\",\n+        \"name\": \"Horse in the Western Hotel wagon yard\",\n+        \"belongs_to\": \"western_hotel\",\n+        \"ground_record_id\": \"western_hotel_wagon_yard\",\n+        \"at_local_enu_m\": [\n+          -127.5,\n+          -296.0\n+        ],\n+        \"bearing_deg\": 90,\n+        \"support_quaternion_xyzw\": [\n+          0.0034569299659433193,\n+          8.186949270382101e-08,\n+          2.3682575088531932e-05,\n+          0.9999940245193165\n+        ],\n+        \"support_confidence\": \"reconstructed\",\n+        \"support_note\": \"Same whole-root rigid0.396145-degree support fit at unchanged canonical neutral hoof coordinates. Support placement adds no per-leg offset or mesh adjustment; new26rig/V16skin and planted clip are declared separately.\",\n+        \"support_limits\": {\n+          \"status\": \"Root accepted development-placement1mm per-foot sampled MINIMUM and no sampled penetration; not continuous-contact/anatomy/photo approval\",\n+          \"maximum_per_hoof_minimum_gap_m\": 0.001,\n+          \"minimum_sample_clearance_m\": -1e-05\n+        },\n+        \"material_variant\": \"organic_dielectric_v1\",\n+        \"material_variant_status\": \"Root selected explicit organic_dielectric_v1 after actual four-image flat-plane matched material study; image filenames side denote FRONT, not broadside. Actual yard/phone and photographic master remain open.\",\n+        \"location\": \"Western Hotel wagon yard, near the stable and existing reconstructed parked wagons\",\n+        \"source_ids\": [\n+          \"chicagology_prefire278\"\n+        ],\n+        \"confidence\": \"reconstructed\",\n+        \"note\": \"The existing yard record cites recollections of the Western Hotel stable, trains and farmers/teamsters. A standing horse is plausible context; this exact animal, chestnut coat/blaze/stockings, stature, grooming, stand and date are reconstructed. No historical breed, owner, attachment, tie rope, halter, tack, rider or driver is assigned. belongs_to filters the host location only and does not assert horse ownership.\",\n+        \"capabilities\": {\n+          \"static_standing\": true,\n+          \"skinned_hierarchy_preserved\": false,\n+          \"source_clips_preserved\": false,\n+          \"playback_enabled\": true,\n+          \"walk_trot_gallop_approved\": false,\n+          \"hitching\": false,\n+          \"riding\": false,\n+          \"boarding\": false,\n+          \"tying\": false,\n+          \"halter_or_harness_fitted\": false,\n+          \"certified_sockets\": false,\n+          \"driver_interface\": false,\n+          \"collision_physics\": false,\n+          \"historical_individual_or_breed_identified\": false,\n+          \"photographic_master_complete\": false,\n+          \"head_tail_idle\": false,\n+          \"skin_joint_hierarchy_preserved\": false,\n+          \"original_mesh_node_parenting_preserved\": false,\n+          \"standing_weight_shift\": true,\n+          \"original_source_preserved_separately\": true,\n+          \"reconstructed26_hierarchy\": true\n+        },\n+        \"ground_support_region_id\": \"western_hotel_yard_horse_support_01\",\n+        \"liberty\": \"L-standing-horse-development-2800\",\n+        \"animation\": {\n+          \"enabled\": true,\n+          \"clip\": \"sevket_reconstructed_planted_posture_v1\",\n+          \"confidence\": \"reconstructed\"\n+        }\n+      }\n+    ]\n+  }\n+}"},{"sha":"aacc7b2523248483a4b97908efd110305b14032f","filename":"chicago/4d/docs/LIBERTIES.md","status":"modified","additions":13,"deletions":0,"changes":13,"blob_url":"https://github.com/kevinrhaas/chicago/blob/fa115d72534e234fe5ac7b94fd2f1a3eb38065c8/chicago%2F4d%2Fdocs%2FLIBERTIES.md","raw_url":"https://github.com/kevinrhaas/chicago/raw/fa115d72534e234fe5ac7b94fd2f1a3eb38065c8/chicago%2F4d%2Fdocs%2FLIBERTIES.md","contents_url":"https://api.github.com/repos/kevinrhaas/chicago/contents/chicago%2F4d%2Fdocs%2FLIBERTIES.md?ref=fa115d72534e234fe5ac7b94fd2f1a3eb38065c8","patch":"@@ -31587,6 +31587,19 @@ Taylor camera's south-west bearing against the chamfer's near end.\n **Review:** `docs/RESEARCH/photo-match/kimball_house_1801_prairie/taylor_c1895_northwest-side-by-side.jpg`.\n **Recorded:** 2026-10-23 (T-3047).\n \n+\n+### L-standing-horse-development-2800 — a planted-standing horse in the Western Hotel yard\n+\n+**Decision:** Add one reconstructed, unidentified horse at E−127.5,N−296.0,heading90degrees in the1835Western Hotel wagon yard, using the existing host/yard record as context rather than evidence of an individual or ownership. The chestnut coat/blaze/stockings, grooming,1.55m withers proxy, exact stand and date are reconstructed. It is unhitched, untied and unmounted.\n+\n+**What is reconstructed:** Licensed modern sevketkabatas Horse rest surface baked to canonical metres and adapted to project26 controls/V16skin; the already baked0.3644068837native scale is NOT applied again. The selected b479 derivative plays one12s planted body shift (4mm lateral,2mm longitudinal,4mm compression) with no original head/tail composition or walking. Existing0.396145degree whole-root support and cloned-material metalness0 are declared adaptations. Rig hierarchy analogy credits antemeossa CC BY4.0; no donor mesh/Walk keys were copied. Modern credit is not an historically graded animal attribute.\n+\n+**Bounds and limits:** Original stationary65 CPU and actual standardGLTFLoader/Mixer65keys+64midpoints passed unchanged surface/contact/loop/normal/meaningful controls, maximum loaded hoof contact8.6523737e−6m. This is not GPU/photo or actual-yard acceptance. One declared0.866317m² support region retains actual drawn yard triangles before normal GPU upload release, under32triangles/4096typed-array bytes and with disposal; no town-wide geometry retention is added. One-instance/reach70/40/0m and full-only30m shadow limits remain. Actual app yard/mobile visual, performance, photographic master, gaits, tack/teams/riders/boarding remain open. Earlier failed walking fields/poses remain failed.\n+\n+**Sources:** sevketkabatas_2021_horse_model supplies modern source/rights only; chicagology_prefire278 supplies historical horsekeeping context only.\n+**Ticket:** T-2800/T-2803, partial standing increment; both master/gait acceptance remain open.\n+**Recorded:**2026-10-23.\n+\n ### L-glessner-course-relief-3046 — Glessner's high courses crowned deeper than its low ones, fitted to Taylor 2135's shadows\n \n **Decision:** Taylor 2135 (c. 1887-89, `taylor_2135_glessner_exterior_1887_1889`), read through its T-2858 camera on three clear piers of the Prairie front, shows a course printed 11.5 in or over throwing about a third more shadow under its lower lip than a low course does: 1.32 times, re-read on the beds as T-3045 lays them (docs/RESEARCH/glessner-course-relief-T-3046/). The render read 0.86. The cause was in the build. Every course's bow was capped at 60 mm, and its lower face rose to the crown over 44 % of the course's height, so a tall course's lip came out gentler than a short one's. A course printed 11.5 in or over now crowns 1.25 times its stones' bow and rises to it over at most 0.09 m (`v4_detail.ashlar_crown_by_course`). That is about the lower face a 7.5 in course already has. Through the same camera the render now reads 1.33. The low courses are unchanged, at 0.359 before and 0.353 after (the occlusion re-bake). Both granite faces take it, because one coursing turns the NE corner (T-3044 § 2)."},{"sha":"55d44581bb0eb247741cb003c7089c3935cee9c5","filename":"chicago/4d/docs/ROADMAP.md","status":"modified","additions":5,"deletions":0,"changes":5,"blob_url":"https://github.com/kevinrhaas/chicago/blob/fa115d72534e234fe5ac7b94fd2f1a3eb38065c8/chicago%2F4d%2Fdocs%2FROADMAP.md","raw_url":"https://github.com/kevinrhaas/chicago/raw/fa115d72534e234fe5ac7b94fd2f1a3eb38065c8/chicago%2F4d%2Fdocs%2FROADMAP.md","contents_url":"https://api.github.com/repos/kevinrhaas/chicago/contents/chicago%2F4d%2Fdocs%2FROADMAP.md?ref=fa115d72534e234fe5ac7b94fd2f1a3eb38065c8","patch":"@@ -5679,3 +5679,8 @@ with peer-mesh/placement freshness checks. The initial 30-member first-fort and\n [The checkpoint](RESEARCH/fort-reference-groups-T-3040/README.md) preserves source/date\n findings and next work across T-2372 through T-2388. T-3041 and T-2388 retain\n the full model-matching acceptance; this prerequisite changes no building.\n+\n+\n+### Standing-horse integration checkpoint - T-2800/T-2803,2026-10-23\n+\n+Canonical26 planted-standing increment: licensed b479/V16 field, unit runtime coordinates and existing Western Hotel yard position. Original CPU65 and actual standard GLTFLoader/Mixer65keys+64midpoints pass; published yard/mobile/render/performance and photographic gates remain open. Queue/tickets remain the work authority. Walking/trot/tack/teams/riders/boarding remain open. See STATUS and L-standing-horse-development-2800; earlier walking failures remain failures."},{"sha":"ab0070d2074e536257009bec20e6bb6baafd7f36","filename":"chicago/4d/docs/STATUS.md","status":"modified","additions":46,"deletions":0,"changes":46,"blob_url":"https://github.com/kevinrhaas/chicago/blob/fa115d72534e234fe5ac7b94fd2f1a3eb38065c8/chicago%2F4d%2Fdocs%2FSTATUS.md","raw_url":"https://github.com/kevinrhaas/chicago/raw/fa115d72534e234fe5ac7b94fd2f1a3eb38065c8/chicago%2F4d%2Fdocs%2FSTATUS.md","contents_url":"https://api.github.com/repos/kevinrhaas/chicago/contents/chicago%2F4d%2Fdocs%2FSTATUS.md?ref=fa115d72534e234fe5ac7b94fd2f1a3eb38065c8","patch":"@@ -1,3 +1,36 @@\n+## T-2800 — planted standing horse integration (2026-10-23)\n+\n+One reconstructed horse is placed in the 1835 Western Hotel yard with a\n+12-second planted weight shift, a selectable provenance card and the existing\n+host visibility, pause and resource-lifetime policies. The licensed canonical\n+asset is `b479442c`. Its standard-loader standing check passed all 65 keys and\n+64 midpoints. Actual published mobile/desktop qualification is still pending;\n+photographic anatomy, walking, tack, teams and riding remain open.\n+\n+The complete serial preflight on the preceding tree finished with three failures\n+among 1054 steps. Two exposed a test that mistook the deliberately inherited\n+`CHECK_JOBS=1` for the default policy. Its child-local four-core and one-core\n+fixtures now test the documented defaults independently of caller settings;\n+the production harness is unchanged. Both focused harness modes pass, and a\n+forced-serial-default negative control still fails the four-core assertion.\n+\n+The lap-lock fixture also failed its mid-rebuild case. Its original nested-CLI\n+diagnostic passed on the subsequent quiet reproduction, so neither a production\n+locking defect nor a particular resource failure is established. The fixture now\n+executes the real sibling CLI in the rebuild process on its first `--run`, then\n+independently verifies the real live marker before the original race assertions.\n+This removes one nested Node process. Production lock scripts are unchanged;\n+the integrated test passes and omitting the lock still fails both setup and race\n+checks. All original nonpasses are retained. These focused results do not replace\n+the new exact-tree complete preflight required before committing this change.\n+\n+The most recent complete run failed only the stale-marker lap case (1/1054).\n+A quiet reproduction verified that same sandbox's real stale marker and passed\n+the push and all live-lock guards. The test now checks aged-marker creation,\n+asserts the same-sandbox stale premise and retains full output and process status\n+on a failed push. No production lock behavior or assertion is relaxed. The fresh\n+complete gate and exact-commit CI receipts belong to the resulting PR.\n+\n ## T-1789 — connected Bardwell waistcoat source repair (2026-10-22)\n \n Actual published-town front inspection of the qualified Bardwell asset showed a\n@@ -24576,3 +24609,16 @@ The owner found 1736 Prairie's card saying \"It had stood like this since 1904\" (\n ### T-3042 — Sourced fact cards for eight Prairie Avenue houses, 2026-10-22\n \n The owner asked for interesting, true facts on the cards (the \"Dutch-ish\" house and the paint maker's). Eight new summary records under data/summaries/, each fact graded and sourced from records the project already holds, mostly the district's interpretive markers: 1812 Wheeler (a Dutch-style row house by Burnham & Root for a grain-elevator owner), 1736 McBirney (bought in 1880 for $25,000 by Hugh McBirney, a white lead maker, per chicagology's directory and Tribune transcriptions), 2100 Sherman (Burnham married the owner's daughter while it was building), 1729 Pullman (a 200-seat theatre, pipe organ and bowling alley), 1801 Kimball, 1811 Coleman, 1912 Moulton-Lowden (a future governor's home) and 1919 Field Jr. A summary's `built` may now carry a `phrase` (\"between 1870 and 1876\", \"1864 or 1875\"), placed on the timeline at its earliest year; compile_summaries.py refuses a phrase whose earliest year is not `year`. Left out on purpose: Max Meyer's 2009 house (the record is named Mayer, the marker Meyer, unresolved), Pullman's architect (the marker's Jaffay against others' Jaffray), and any McBirney–Dutch Boy link (no source found).\n+\n+\n+## Canonical26 planted-standing horse — source integration increment (2026-10-23)\n+\n+One reconstructed1835Western Hotel yard horse is proposed through the real scene layer/consumer with exact b479442c standing GLB (3,783,600bytes), canonical unit scale/zero origin, selected dielectric materials and bounded drawn-yard support. It plays only sevket_reconstructed_planted_posture_v1; no old15 head/tail clip, walk/trot, route, rider or gear is composed. Exact full artifact/source lineage is in assets/authored/transport/horse_standing/SOURCE.json. Current primary UI, Welcome/Home, humans, carriage distance/shadow changes and popup behavior are retained.\n+\n+Actual standardGLTFLoader/Mixer129 V2 passed65originalkeys+64midpoints, max contact8.652373712111605e−6m, positional parity1.3646619141056235e−7m, normal parity1.6246314097839457e−6deg. The compact data/transport/parked/standing-horse-planted/loaded129-summary.json pins raw result52841c26764f1ef88def84275da992cc3d51d1289b62cde3d6976155f8e55997; no renderer/GPU context was created. Prior baseline/runtime and walking failures are preserved separately and do not become passes.\n+\n+The standalone source patch was integrated onto DEV e4745b3c5714185079215d06d8072a4791c6de4a, retaining its newer Ames liberty changes. Actual compile_liberties.py, compile_scene.py --all and compile_source_use.py passed; the measured contract/clock/credit/support unit and isolation audit passed. Actual integration fullgate, yard desktop/mobile visuals, published budgets/selection/pause/reduced-motion and photographic completion remain pending. This checkpoint does not close T-2800 or T-2803 and does not claim walking, trot, head/tail composition, tack, teams or riding.\n+\n+The first actual preflight stopped after publication refused an inherited stale ignored Glessner output. The old outputs and dirty ticket clone were preserved; the existing verified-archive materializer restored the current output, and the current canonical ticket clone supplies the worktree. The next preflight published successfully but exhausted temporary storage when the existing ticket-mirror regression copied unrelated recovery archives into its fixture. Both attempts remain non-passes. That regression now excludes only evidence archives and Git internals, retains every ticket/metadata input and the original mirror assertions, and cleans up a failed initial copy. Its actual measured run and the isolation audit passed; a fresh full preflight is required.\n+\n+The final merge-ready dry-run fixture emits its fixed GitHub states as shell-quoted Bash cases rather than starting an unnecessary nested Node interpreter. Every original merger assertion remains; dry-run exit status and output are recorded. Production merge/lock/workflow code is unchanged. A complete1054-step attempt finished with one dry-run fixture failure; the old assertion did not record output, so the exact transient cause is not established. Focused real-merger and deliberately blocked dry-run negative controls are recorded externally; a fresh complete gate is required before commit."},{"sha":"86629f6a93a3a7d33a74162716184167b68d9005","filename":"chicago/4d/docs/measurements/source_use_coverage.md","status":"modified","additions":4,"deletions":4,"changes":8,"blob_url":"https://github.com/kevinrhaas/chicago/blob/fa115d72534e234fe5ac7b94fd2f1a3eb38065c8/chicago%2F4d%2Fdocs%2Fmeasurements%2Fsource_use_coverage.md","raw_url":"https://github.com/kevinrhaas/chicago/raw/fa115d72534e234fe5ac7b94fd2f1a3eb38065c8/chicago%2F4d%2Fdocs%2Fmeasurements%2Fsource_use_coverage.md","contents_url":"https://api.github.com/repos/kevinrhaas/chicago/contents/chicago%2F4d%2Fdocs%2Fmeasurements%2Fsource_use_coverage.md?ref=fa115d72534e234fe5ac7b94fd2f1a3eb38065c8","patch":"@@ -10,7 +10,7 @@ Generated by `tools/compile_source_use.py`; no timestamps.\n | flora | 11 | 11 | 0 |\n | households | 2086 | 1457 | 0 |\n | jaunt claims | 33 | 33 | 0 |\n-| liberties (structured citations) | 703 | 0 | 0 |\n+| liberties (structured citations) | 704 | 0 | 0 |\n | loading facts | 50 | 50 | 0 |\n | people | 3878 | 1655 | 0 |\n | railway | 1 | 1 | 0 |\n@@ -23,10 +23,10 @@ Generated by `tools/compile_source_use.py`; no timestamps.\n | terrain | 30 | 26 | 0 |\n | terrain epochs | 5 | 2 | 0 |\n \n-Registered sources: 413. Index: 165427 bytes / 168000.\n+Registered sources: 414. Index: 165777 bytes / 168000.\n \n-Scene 1812: 39 sources cited by its own records; use map 19112 bytes (`sidecars/1812/sources/uses.json`).\n-Scene 1904: 78 sources cited by its own records; use map 18878 bytes (`sidecars/1904/sources/uses.json`).\n+Scene 1812: 39 sources cited by its own records; use map 19154 bytes (`sidecars/1812/sources/uses.json`).\n+Scene 1904: 78 sources cited by its own records; use map 18920 bytes (`sidecars/1904/sources/uses.json`).\n \n Records are adapter units: a structure and each phase are separate readings; a household and each person are separate readings.\n Claims deduplicate by entity type, entity ID and field path; entities deduplicate independently. Several newspaper issues can support one claim."},{"sha":"e6c878c7675868587036b304543bd4836eb103f5","filename":"chicago/4d/renderers/web/js/main.js","status":"modified","additions":15,"deletions":0,"changes":15,"blob_url":"https://github.com/kevinrhaas/chicago/blob/fa115d72534e234fe5ac7b94fd2f1a3eb38065c8/chicago%2F4d%2Frenderers%2Fweb%2Fjs%2Fmain.js","raw_url":"https://github.com/kevinrhaas/chicago/raw/fa115d72534e234fe5ac7b94fd2f1a3eb38065c8/chicago%2F4d%2Frenderers%2Fweb%2Fjs%2Fmain.js","contents_url":"https://api.github.com/repos/kevinrhaas/chicago/contents/chicago%2F4d%2Frenderers%2Fweb%2Fjs%2Fmain.js?ref=fa115d72534e234fe5ac7b94fd2f1a3eb38065c8","patch":"@@ -67,6 +67,7 @@ import { createFencedGround, fetchPrebuiltYards } from './yards.js';\n import { createSignage } from './signage.js';\n import { createYardGoods } from './yard.js';\n import { createParkedTransport } from './parked-transport.js';\n+import { createStandingHorses } from './standing-horses.js';\n import { keptGround } from './kept-ground.js';\n import { createFrontage, fetchPrebuiltFrontage, pageBuild } from './frontage.js';\n import { setPickRenderer, setPickLog, pickResources } from './gpu-pick.js';\n@@ -2374,6 +2375,7 @@ async function boot() {\n   const yards = await createFencedGround({\n     records: enclosures.records, terrain, confidence, problems,\n     prebuilt: yardsPrebuilt, recordHashes: enclosureHashes,\n+    supportRegions: draws('standing_horses') ? (loaded.scene.static_support_regions ?? []) : [],\n   });\n   performance.measure('yards', 'yards:start');\n   scene3d.add(yards.group);\n@@ -2409,6 +2411,14 @@ async function boot() {\n   });\n   scene3d.add(parkedTransport.group);\n   api.parkedTransport = parkedTransport;\n+  const standingHorses = await createStandingHorses({\n+    dataBase: layerBase('standing_horses'), sceneId: YEAR, confidence, detail: detailLevel,\n+    problems: layerProblems('standing_horses'), hostMissing,\n+    groundHeight: (e, n, recordId, regionId) => yards.drawnBaseHeightAt(e, n, recordId, regionId),\n+  });\n+  scene3d.add(standingHorses.group); settleOnGpu(standingHorses.group);\n+  api.standingHorses = standingHorses;\n+  standingHorses.update(camera);\n   const yard = await createYardGoods({\n     dataBase: layerBase('yard_goods'), terrain, confidence, problems: layerProblems('yard_goods'), hostMissing,\n     lowSpec: coarse,\n@@ -3043,6 +3053,7 @@ async function boot() {\n       refreshGlessnerOcclusion();\n       api.humans?.setTier(level);\n       void parkedTransport.setTier(level);\n+      void standingHorses.setTier(level);\n       applyShadowTier(level);\n       applyFurnitureReach(level);\n       applyGroundDetailReach(level);\n@@ -3098,6 +3109,7 @@ async function boot() {\n     // The figures' LOD ladder follows the tier (T-1788; docs/HUMAN-ASSET-CONTRACT.md § 8).\n     api.humans?.setTier(level);\n     void parkedTransport.setTier(level);\n+    void standingHorses.setTier(level);\n     // The sun's half of the level takes effect on THIS frame rather than after\n     // the replanting: it costs nothing to apply, and a visitor who turns the\n     // setting down on a machine that is struggling should get the cheap half of\n@@ -3971,6 +3983,8 @@ async function boot() {\n     }\n     const vehicle = parkedTransport.pickAt(ndc, camera);\n     if (vehicle?.record && (!hit || vehicle.distance < hit.distance)) hit = vehicle;\n+    const horse = standingHorses.pickAt(ndc, camera);\n+    if (horse?.record && (!hit || horse.distance < hit.distance)) hit = horse;\n     /**\n      * And so can the fort's well, which is the second thing here belonging to no\n      * structure at all: a curb answers with its OWN card record, built by the\n@@ -5026,6 +5040,7 @@ async function boot() {\n     railway.update(camera);\n     flags.update(dt);\n     parkedTransport.update(camera);\n+    standingHorses.update(camera, frameDt, { paused: animationHold || gateOpen });\n     // T-2598: which house pictures are on the GPU, from where the eye ended up; at\n     // most a frame's allowance of them is uploaded here, before the draw.\n     residency?.tick(camera.position);"},{"sha":"ad4b10958456850a94d3b884d1044ca4f79758b2","filename":"chicago/4d/renderers/web/js/standing-horse-card.js","status":"added","additions":28,"deletions":0,"changes":28,"blob_url":"https://github.com/kevinrhaas/chicago/blob/fa115d72534e234fe5ac7b94fd2f1a3eb38065c8/chicago%2F4d%2Frenderers%2Fweb%2Fjs%2Fstanding-horse-card.js","raw_url":"https://github.com/kevinrhaas/chicago/raw/fa115d72534e234fe5ac7b94fd2f1a3eb38065c8/chicago%2F4d%2Frenderers%2Fweb%2Fjs%2Fstanding-horse-card.js","contents_url":"https://api.github.com/repos/kevinrhaas/chicago/contents/chicago%2F4d%2Frenderers%2Fweb%2Fjs%2Fstanding-horse-card.js?ref=fa115d72534e234fe5ac7b94fd2f1a3eb38065c8","patch":"@@ -0,0 +1,28 @@\n+// SPDX-License-Identifier: GPL-3.0-or-later\n+// Modern asset credit is separate from historically graded animal claims.\n+export function standingHorseCard(row, spec) {\n+  const citations = [...new Set([...row.source_ids, spec.source.id])].map(source_id => {\n+    const source = spec.citation_records?.[source_id];\n+    if (!source?.citation || !source.url) throw Error('Standing horse citation does not resolve: ' + source_id);\n+    return { ...source, source_id };\n+  });\n+  return { id: row.id, sidecar: {\n+    name: row.name, phase: null,\n+    change_note: `A reconstructed, unidentified horse in the 1835 Western Hotel yard. Modern model credit (published ${spec.source.publication_date.slice(0, 4)}): ${spec.source.credit} This modern asset credit is not evidence of a particular 1835 horse, breed or owner.`,\n+    placement: { symbolic_location: row.location, position_confidence: 'reconstructed',\n+      position_sources: row.source_ids, position_note: row.note },\n+    attributes: {\n+      animal: { value: 'Standing horse; individual unidentified', confidence: 'reconstructed',\n+        sources: row.source_ids, note: 'Yard context supports horsekeeping; this individual is a reconstruction.' },\n+      breed_owner: { value: 'Unidentified', confidence: 'reconstructed', sources: [],\n+        note: 'No historical breed, owner, measured stature, coat or grooming is attested for this model.' },\n+      state: { value: 'Standing, unhitched, untied and unmounted', confidence: 'reconstructed', sources: [],\n+        note: row.animation?.enabled\n+          ? 'Gentle body weight shifts are reconstructed; hooves stay planted. This horse is unhitched and unmounted; walking and riding are not available.'\n+          : 'Idle activation awaits qualification; no halter, tie rope, harness, rider, driver, boarding, route or physical coupling is enabled.' },\n+    },\n+    citations,\n+    research_note: `${row.note} Modern model credit (${spec.source.publication_date.slice(0, 4)}): ${spec.source.credit} Model adaptations: canonical metre-space derivative at unit scale,\n+      declared whole-root support rotation, yard placement and reconstructed planted body shifts. Original head/tail and walking clips are not composed. ${spec.material_variants[row.material_variant].change_notice}`,\n+  } };\n+}"},{"sha":"3fadc0b5565f4e01fa535bb445745b1113d3c36b","filename":"chicago/4d/renderers/web/js/standing-horse-planted-idle.js","status":"added","additions":97,"deletions":0,"changes":97,"blob_url":"https://github.com/kevinrhaas/chicago/blob/fa115d72534e234fe5ac7b94fd2f1a3eb38065c8/chicago%2F4d%2Frenderers%2Fweb%2Fjs%2Fstanding-horse-planted-idle.js","raw_url":"https://github.com/kevinrhaas/chicago/raw/fa115d72534e234fe5ac7b94fd2f1a3eb38065c8/chicago%2F4d%2Frenderers%2Fweb%2Fjs%2Fstanding-horse-planted-idle.js","contents_url":"https://api.github.com/repos/kevinrhaas/chicago/contents/chicago%2F4d%2Frenderers%2Fweb%2Fjs%2Fstanding-horse-planted-idle.js?ref=fa115d72534e234fe5ac7b94fd2f1a3eb38065c8","patch":"@@ -0,0 +1,97 @@\n+// SPDX-License-Identifier: GPL-3.0-or-later\n+// Play one explicit glTF planted-standing clip; no procedural bone motion/blend.\n+export const PLANTED_SHA = 'b479442cb03ac46eb13c19da15a79cdfaf28dbdf356b116f78de7ce7ecdc60be';\n+export const PLANTED_CLIP = 'sevket_reconstructed_planted_posture_v1';\n+const ROTATIONS = [7, 8, 9, 12, 13, 14, 17, 18, 19, 22, 23, 24];\n+const NAMES = { 1: 'horse_body', 7: 'fore_l_elbow', 8: 'fore_l_carpus', 9: 'fore_l_fetlock',\n+  12: 'fore_r_elbow', 13: 'fore_r_carpus', 14: 'fore_r_fetlock', 17: 'hind_l_stifle',\n+  18: 'hind_l_hock', 19: 'hind_l_fetlock', 22: 'hind_r_stifle', 23: 'hind_r_hock', 24: 'hind_r_fetlock' };\n+const OWNER = Symbol('plantedStandingOwner');\n+const check = (ok, message) => { if (!ok) throw Error('HorseStandingContract: ' + message); };\n+const hash = text => { let h = 2166136261; for (const c of text) { h ^= c.charCodeAt(0); h = Math.imul(h, 16777619); } return h >>> 0; };\n+\n+/** Bytes are SHA-verified by caller before this metadata/inventory guard. */\n+export function validatePlantedStandingHeader(bytes, spec) {\n+  check(spec.runtime_asset?.sha256 === PLANTED_SHA && spec.runtime_asset.bytes === 3783600,\n+    'explicit standing asset identity required');\n+  check(spec.runtime_scale_m_per_unit === 1 && spec.runtime_origin_m?.length === 3\n+    && spec.runtime_origin_m.every(v => v === 0), 'canonical metres require unit scale and zero origin');\n+  check(bytes.byteLength === 3783600 && bytes.byteLength <= 4 * 1024 * 1024, 'standing byte budget changed');\n+  const view = new DataView(bytes);\n+  check(view.getUint32(0, true) === 0x46546c67 && view.getUint32(4, true) === 2\n+    && view.getUint32(8, true) === bytes.byteLength && view.getUint32(16, true) === 0x4e4f534a,\n+  'expected complete glTF2 binary');\n+  const length = view.getUint32(12, true);\n+  check(length > 0 && length <= bytes.byteLength - 20, 'invalid JSON chunk');\n+  const json = JSON.parse(new TextDecoder().decode(new Uint8Array(bytes, 20, length)));\n+  check(!json.extensionsRequired?.length && json.buffers.length === 1 && !json.buffers[0].uri,\n+    'embedded reviewed standing buffer required');\n+  check(json.images.length === 6 && json.images.every(i => Number.isInteger(i.bufferView) && !i.uri)\n+    && json.materials.length === 3, 'standing image/material inventory changed');\n+  check(json.skins.length === 1 && json.skins[0].joints.length === 26\n+    && json.skins[0].joints.every((j, i) => j === i), 'exact reconstructed26 rig required');\n+  check(json.animations.length === 1 && json.animations[0].name === PLANTED_CLIP,\n+    'only planted-standing clip permitted');\n+  const clip = json.animations[0], targets = new Set();\n+  check(clip.channels.length === 13 && clip.samplers.length === 13, 'standing track inventory changed');\n+  for (const channel of clip.channels) {\n+    const { node, path } = channel.target, key = `${node}:${path}`;\n+    check((node === 1 && path === 'translation') || (ROTATIONS.includes(node) && path === 'rotation'),\n+      'unapproved root/head/tail/hoof or walking channel');\n+    check(!targets.has(key) && json.nodes[node].name === NAMES[node], 'standing joint identity changed');\n+    targets.add(key);\n+    const sampler = clip.samplers[channel.sampler], input = json.accessors[sampler.input], output = json.accessors[sampler.output];\n+    check(sampler.interpolation === 'LINEAR' && input.componentType === 5126 && input.type === 'SCALAR'\n+      && input.count === 65 && input.min?.[0] === 0 && input.max?.[0] === 12\n+      && output.componentType === 5126 && output.count === 65 && output.type === (path === 'translation' ? 'VEC3' : 'VEC4'),\n+    'standing65 key/time/interpolation contract changed');\n+  }\n+  let triangles = 0;\n+  for (const mesh of json.meshes) for (const p of mesh.primitives) {\n+    check((p.mode ?? 4) === 4 && p.indices !== undefined, 'indexed standing triangles required');\n+    triangles += json.accessors[p.indices].count / 3;\n+  }\n+  check(json.meshes.length === 3 && triangles === 14986, 'standing mesh/triangle budget changed');\n+  return json;\n+}\n+\n+export function createPlantedStandingHorseIdle({ T, root, clips, verifiedDerivedSha256, instanceId }) {\n+  check(verifiedDerivedSha256 === PLANTED_SHA && typeof instanceId === 'string' && instanceId.length > 0,\n+    'source-bound standing identity required');\n+  check(!root.userData[OWNER], 'standing clone already has an animation owner');\n+  const meshes = []; root.traverse(n => { if (n.isMesh) meshes.push(n); });\n+  check(meshes.length === 3 && meshes.every(m => m.isSkinnedMesh && m.skeleton.bones.length === 26),\n+    'standing skin inventory changed');\n+  const bones = meshes[0].skeleton.bones;\n+  check(meshes.every(m => m.skeleton.bones.every((b, i) => b === bones[i])), 'standing joint order/identity changed');\n+  const clip = clips[0];\n+  check(clips.length === 1 && clip.name === PLANTED_CLIP && clip.duration === 12 && clip.tracks.length === 13,\n+    'single exported standing12s clip required');\n+  const targets = new Set();\n+  for (const track of clip.tracks) {\n+    const parsed = T.PropertyBinding.parseTrackName(track.name), node = T.PropertyBinding.findNode(root, parsed.nodeName);\n+    const joint = bones.indexOf(node), key = `${joint}:${parsed.propertyName}`;\n+    check((joint === 1 && parsed.propertyName === 'position')\n+      || (ROTATIONS.includes(joint) && parsed.propertyName === 'quaternion'), 'unexpected standing track target');\n+    check(node.name === NAMES[joint] && !targets.has(key), 'standing target duplicate or name mismatch'); targets.add(key);\n+    check(track.times.length === 65 && track.times[0] === 0 && track.times[64] === 12,\n+      'loaded standing sample times changed');\n+  }\n+  const mixer = new T.AnimationMixer(root), action = mixer.clipAction(clip);\n+  action.setLoop(T.LoopRepeat, Infinity); action.play(); mixer.setTime(0); root.userData[OWNER] = true;\n+  const delay = 2 * hash(instanceId) / 4294967295, rate = .96 + .08 * hash(instanceId + '|rate') / 4294967295;\n+  let disposed = false, elapsed = 0, age = 0;\n+  return {\n+    update(dt, { visible = true, reducedMotion = false, paused = false } = {}) {\n+      if (disposed) return; check(Number.isFinite(dt) && dt >= 0, 'invalid standing host delta');\n+      if (!visible || reducedMotion || paused) return;\n+      const before = age; age += dt;\n+      const advance = (Math.max(0, age - delay) - Math.max(0, before - delay)) * rate;\n+      elapsed += advance; mixer.update(advance);\n+    },\n+    get status() { return { elapsed_s: elapsed, disposed, clip: PLANTED_CLIP,\n+      initial_rest_delay_s: delay, deterministic_playback_rate: rate, mixer_count: disposed ? 0 : 1,\n+      weight_shift: true, head_tail_composed: false, independent_ear_motion: false, walk: false, trot: false }; },\n+    dispose() { if (disposed) return; disposed = true; mixer.stopAllAction(); mixer.uncacheRoot(root); delete root.userData[OWNER]; },\n+  };\n+}"},{"sha":"56489f9bd8d55d244a6f29a54168b74edb5f2435","filename":"chicago/4d/renderers/web/js/standing-horses.js","status":"added","additions":283,"deletions":0,"changes":283,"blob_url":"https://github.com/kevinrhaas/chicago/blob/fa115d72534e234fe5ac7b94fd2f1a3eb38065c8/chicago%2F4d%2Frenderers%2Fweb%2Fjs%2Fstanding-horses.js","raw_url":"https://github.com/kevinrhaas/chicago/raw/fa115d72534e234fe5ac7b94fd2f1a3eb38065c8/chicago%2F4d%2Frenderers%2Fweb%2Fjs%2Fstanding-horses.js","contents_url":"https://api.github.com/repos/kevinrhaas/chicago/contents/chicago%2F4d%2Frenderers%2Fweb%2Fjs%2Fstanding-horses.js?ref=fa115d72534e234fe5ac7b94fd2f1a3eb38065c8","patch":"@@ -0,0 +1,283 @@\n+// SPDX-License-Identifier: GPL-3.0-or-later\n+// Additive standing development horse; licensed canonical-metre geometry and reconstructed planted standing.\n+import * as THREE from 'three';\n+import { GLTFLoader } from 'three/addons/loaders/GLTFLoader.js';\n+import { clone as cloneSkinned } from 'three/addons/utils/SkeletonUtils.js';\n+import { disposeLoadedAsset } from './scene-loader.js';\n+import { createPlantedStandingHorseIdle, validatePlantedStandingHeader } from './standing-horse-planted-idle.js';\n+import { standingHorseCard as card } from './standing-horse-card.js';\n+\n+const REACH = { full: 70, balanced: 40, light: 0 };\n+const yawOf = bearing => Math.PI - bearing * Math.PI / 180;\n+const sha256 = async bytes => Array.from(new Uint8Array(await crypto.subtle.digest('SHA-256', bytes)),\n+  b => b.toString(16).padStart(2, '0')).join('');\n+const assert = (value, message) => { if (!value) throw Error(message); };\n+\n+function disposeSkeletons(root) {\n+  const skeletons = new Set();\n+  root?.traverse(node => { if (node.skeleton) skeletons.add(node.skeleton); });\n+  for (const skeleton of skeletons) skeleton.dispose();\n+}\n+\n+function disposeSource(asset) {\n+  disposeSkeletons(asset?.scene);\n+  disposeLoadedAsset(asset);\n+}\n+\n+/** Actual skinned positions in the canonical-metre rest frame; no Box3 rest-box shortcut. */\n+function inspectStanding(root, spec) {\n+  root.updateMatrixWorld(true);\n+  root.traverse(node => { if (node.isSkinnedMesh) node.skeleton.update(); });\n+  const point = new THREE.Vector3(), bounds = new THREE.Box3();\n+  const meshes = new Map();\n+  root.traverse(node => {\n+    if (!node.isMesh) return;\n+    assert(node.isSkinnedMesh && !Array.isArray(node.material), 'Expected original three skinned primitives');\n+    assert(node.skeleton.bones.length === 26, 'Horse joint count changed');\n+    assert(node.geometry.getAttribute('skinIndex') && node.geometry.getAttribute('skinWeight')\n+      && node.geometry.getAttribute('uv'), 'Horse skin/UV streams missing');\n+    const ids = new Set(node.geometry.index.array);\n+    for (const id of ids) {\n+      node.getVertexPosition(id, point).applyMatrix4(node.matrixWorld);\n+      assert(point.toArray().every(Number.isFinite), 'Nonfinite horse position');\n+      bounds.expandByPoint(point);\n+    }\n+    meshes.set(node.name, node);\n+  });\n+  assert(meshes.size === 3, 'Horse mesh inventory changed');\n+  for (let i = 0; i < 3; i++) {\n+    assert(Math.abs(bounds.min.getComponent(i) - spec.runtime_bounds_m[0][i]) < 1e-4\n+      && Math.abs(bounds.max.getComponent(i) - spec.runtime_bounds_m[1][i]) < 1e-4,\n+    'Canonical standing bounds disagree with independent decoder');\n+  }\n+  const body = meshes.get(spec.contact_mesh.renderer_name);\n+  assert(body && body.geometry.getAttribute('position').count === spec.contact_mesh.vertices,\n+    'Source contact body does not resolve');\n+  for (const patch of Object.values(spec.contacts)) {\n+    body.getVertexPosition(patch.minimum_vertex_id, point).applyMatrix4(body.matrixWorld);\n+    assert(point.distanceTo(new THREE.Vector3().fromArray(patch.minimum_vertex_canonical_m)) < 1e-4,\n+      'Source minimum-hoof anchor disagrees with independent decoder');\n+  }\n+  const images = new Set(), textures = new Set();\n+  for (const node of meshes.values()) for (const value of Object.values(node.material)) {\n+    if (value?.isTexture) { textures.add(value); images.add(value.image); }\n+  }\n+  let estimatedBytes = 0;\n+  for (const image of images) {\n+    assert(image?.width > 0 && image?.height > 0 && Math.max(image.width, image.height) <= 1024,\n+      'Unreviewed horse texture dimensions');\n+    estimatedBytes += image.width * image.height * 4 * 4 / 3;\n+  }\n+  assert(images.size === 6 && estimatedBytes <= 24 * 1024 * 1024, 'Horse decoded texture budget exceeded');\n+  return { bounds: [bounds.min.toArray(), bounds.max.toArray()], meshes: meshes.size,\n+    textures: textures.size, estimated_texture_mip_bytes: estimatedBytes };\n+}\n+\n+/** Play only the explicit planted-standing26 clip; old head/tail clips are not composed. */\n+function instantiate(asset, spec, row, confidence, groundHeight) {\n+  const root = cloneSkinned(asset.scene);\n+  const clonedGeometry = new Set(), clonedMaterials = new Set(), shadowMaterials = new Set();\n+  let idle = null;\n+  const placement = new THREE.Group(), support = new THREE.Group();\n+  const metric = new THREE.Group(), origin = new THREE.Group();\n+  const retireClone = () => {\n+    placement.removeFromParent(); idle?.dispose(); disposeSkeletons(root);\n+    for (const geometry of clonedGeometry) geometry.dispose();\n+    for (const material of clonedMaterials) material.dispose();\n+    for (const material of shadowMaterials) material.dispose();\n+  };\n+  try {\n+    const variant = spec.material_variants[row.material_variant];\n+    assert(variant && ['source_native', 'organic_dielectric_v1'].includes(row.material_variant),\n+      'Explicit reviewed horse material variant required');\n+    root.traverse(node => {\n+      if (!node.isMesh) return;\n+      node.geometry = node.geometry.clone(); clonedGeometry.add(node.geometry);\n+      node.geometry.setAttribute('_confidence', new THREE.Float32BufferAttribute(\n+        new Float32Array(node.geometry.getAttribute('position').count).fill(1), 1));\n+      node.material = node.material.clone(); clonedMaterials.add(node.material);\n+      if (row.material_variant === 'organic_dielectric_v1') node.material.metalness = 0;\n+      confidence?.patch(node.material);\n+      node.customDepthMaterial = new THREE.MeshDepthMaterial({ depthPacking: THREE.RGBADepthPacking,\n+        side: node.material.side });\n+      node.customDistanceMaterial = new THREE.MeshDistanceMaterial({ side: node.material.side });\n+      for (const material of [node.customDepthMaterial, node.customDistanceMaterial]) {\n+        confidence?.patch(material); shadowMaterials.add(material);\n+      }\n+      node.frustumCulled = false; node.castShadow = false; node.receiveShadow = true;\n+    });\n+    placement.name = row.id; placement.userData.standingHorseId = row.id;\n+    placement.rotation.y = yawOf(row.bearing_deg);\n+    placement.position.set(row.at_local_enu_m[0], 0, -row.at_local_enu_m[1]);\n+    const q = row.support_quaternion_xyzw;\n+    assert(q?.length === 4 && q.every(Number.isFinite) && Math.abs(Math.hypot(...q) - 1) < 1e-7,\n+      'Invalid horse whole-root support quaternion');\n+    const tilt = new THREE.Vector3(0, 1, 0).applyQuaternion(new THREE.Quaternion().fromArray(q)).angleTo(new THREE.Vector3(0, 1, 0));\n+    assert(tilt <= THREE.MathUtils.degToRad(2), 'Horse support tilt exceeds proposed2-degree bound');\n+    assert(q.every((value, i) => Math.abs(value - spec.proposed_static_support_pose.local_quaternion_xyzw[i]) < 1e-12),\n+      'Horse support pose differs from the explicit sidecar proposal');\n+    support.quaternion.fromArray(q);\n+    metric.scale.setScalar(spec.runtime_scale_m_per_unit);\n+    origin.position.fromArray(spec.runtime_origin_m).multiplyScalar(-1);\n+    placement.add(support); support.add(metric); metric.add(origin); origin.add(root);\n+    placement.updateMatrixWorld(true);\n+    const transform = new THREE.Matrix4().makeRotationFromQuaternion(support.quaternion);\n+    const yaw = yawOf(row.bearing_deg), co = Math.cos(yaw), si = Math.sin(yaw);\n+    const points = {};\n+    const sample = values => values.map(v => {\n+      const p = new THREE.Vector3().fromArray(v).applyMatrix4(transform);\n+      const e = row.at_local_enu_m[0] + co * p.x + si * p.z;\n+      const n = row.at_local_enu_m[1] + si * p.x - co * p.z;\n+      const y = groundHeight(e, n, row.ground_record_id, row.ground_support_region_id);\n+      assert(Number.isFinite(y), 'No actual drawn yard base at horse contact sample');\n+      return { y: p.y, ground: y };\n+    });\n+    for (const [name, patch] of Object.entries(spec.contacts)) points[name] = sample(patch.samples_m);\n+    let base = -Infinity;\n+    for (const values of Object.values(points)) for (const p of values) base = Math.max(base, p.ground - p.y);\n+    const gaps = {}, allGaps = [];\n+    for (const [name, values] of Object.entries(points)) {\n+      const valuesGaps = values.map(p => base + p.y - p.ground);\n+      gaps[name] = Math.min(...valuesGaps); allGaps.push(...valuesGaps);\n+    }\n+    assert(Math.max(...Object.values(gaps)) <= row.support_limits.maximum_per_hoof_minimum_gap_m,\n+      'Actual yard surface leaves a horse foot above the proposed contact bound');\n+    assert(Math.min(...allGaps) >= row.support_limits.minimum_sample_clearance_m,\n+      'Horse contact patch penetrates actual yard ground');\n+    // Independently equal10mm clipped-slab metadata, same transform/base: do\n+    // not solve a second offset to conceal a contact-selection discrepancy.\n+    const slabGaps = {};\n+    for (const [name, patch] of Object.entries(spec.contacts)) {\n+      const values = sample(patch.equal_10mm_slab_samples_m);\n+      slabGaps[name] = Math.min(...values.map(p => base + p.y - p.ground));\n+    }\n+    assert(Math.min(...Object.values(slabGaps)) >= row.support_limits.minimum_sample_clearance_m,\n+      'Equal10mm source slab contradicts standing-ground clearance');\n+    placement.position.y = base; placement.updateMatrixWorld(true);\n+    if (row.animation?.enabled) {\n+      assert(spec.idle.enabled && row.animation.clip === spec.idle.clip,\n+        'Explicit qualified horse idle contract required');\n+      idle = createPlantedStandingHorseIdle({ T: THREE, root, clips: asset.animations,\n+        verifiedDerivedSha256: spec.runtime_asset.sha256, instanceId: row.id });\n+    }\n+    return { group: placement, root, asset, row, idle, card: card(row, spec), dispose: retireClone,\n+      receipt: { material_variant: row.material_variant, root_y_m: base,\n+        support_quaternion_xyzw: q, minimum_gap_by_hoof_m: gaps,\n+        equal_10mm_slab_minimum_gaps_m: slabGaps, mixer_count: idle ? 1 : 0,\n+        autoplay: Boolean(idle), original_six_autoplay: false, idle_clip: idle?.status.clip ?? null } };\n+  } catch (error) { retireClone(); throw error; }\n+}\n+\n+/** Separate skinned standing layer; NEVER enters vehicle staticBatches/wheel fitting. */\n+export async function createStandingHorses({ dataBase = null, sceneId, confidence, detail = 'full',\n+  problems = [], hostMissing = () => false, groundHeight = null } = {}) {\n+  const group = new THREE.Group(); group.name = 'standing-horses';\n+  const ray = new THREE.Raycaster(), eye = new THREE.Vector3();\n+  const motionPreference = globalThis.matchMedia?.('(prefers-reduced-motion: reduce)');\n+  let tier = detail, disposed = false, revision = 0, pending = null, active = null, abort = null;\n+  let manifest = null, rows = [], lastCamera = null, attemptedRevision = -1;\n+  const withinReach = () => {\n+    if (!lastCamera || !rows.length || !(REACH[tier] > 0)) return false;\n+    lastCamera.getWorldPosition(eye);\n+    return Math.hypot(eye.x - rows[0].at_local_enu_m[0],\n+      -eye.z - rows[0].at_local_enu_m[1]) < REACH[tier];\n+  };\n+  const retire = () => {\n+    if (active) { active.dispose(); disposeSource(active.asset); active = null; }\n+  };\n+  const out = { group, records: [],\n+    get instances() { return active ? [active] : []; },\n+    get ready() { return pending ?? Promise.resolve(); },\n+    update(camera, dt = 0, { paused = false, reducedMotion = motionPreference?.matches ?? false } = {}) {\n+      if (disposed || !camera) return;\n+      lastCamera = camera;\n+      if (!active) { if (withinReach()) void load(); return; }\n+      camera.getWorldPosition(eye);\n+      const distance = eye.distanceTo(active.group.position);\n+      active.group.visible = !confidence?.hidden?.reconstructed && distance < (REACH[tier] ?? 0);\n+      active.root.traverse(node => {\n+        if (node.isMesh) node.castShadow = active.group.visible && tier === 'full' && distance < 30;\n+      });\n+      let visible = active.group.visible && !globalThis.document?.hidden;\n+      for (let ancestor = group; ancestor; ancestor = ancestor.parent) visible &&= ancestor.visible;\n+      active.idle?.update(dt, { visible, reducedMotion, paused });\n+    },\n+    async setTier(next) {\n+      if (!(next in REACH) || disposed) return;\n+      if (next !== tier) {\n+        tier = next; revision++;\n+        if (tier === 'light') { abort?.abort(); retire(); }\n+      }\n+      if (tier !== 'light') await load();\n+      if (lastCamera) out.update(lastCamera);\n+    },\n+    pickAt(ndc, camera) {\n+      if (!active?.group.visible || disposed || confidence?.hidden?.reconstructed) return null;\n+      for (let ancestor = group; ancestor; ancestor = ancestor.parent) if (!ancestor.visible) return null;\n+      group.updateMatrixWorld(true);\n+      // A source-rest sphere becomes stale when the standing joints move.\n+      // Refresh only on selection, after the current skeleton world matrices.\n+      active.root.traverse(node => {\n+        if (node.isSkinnedMesh) { node.skeleton.update(); node.computeBoundingSphere(); }\n+      });\n+      ray.setFromCamera(ndc ?? new THREE.Vector2(), camera);\n+      const hit = ray.intersectObject(active.root, true)[0];\n+      return hit ? { id: active.row.id, record: active.card, distance: hit.distance, point: hit.point } : null;\n+    },\n+    dispose() {\n+      if (disposed) return;\n+      disposed = true; revision++; abort?.abort(); retire(); group.removeFromParent();\n+    },\n+  };\n+  // Scene/layer and phone-light guards precede ANY model fetch. No inherited\n+  //1835animal appears in another era merely because a loader is mounted.\n+  if (!dataBase || String(sceneId) !== '1835') return out;\n+  if (!groundHeight) { problems.push('standing horses: drawn yard base query unavailable'); return out; }\n+  try {\n+    const response = await fetch(new URL('transport/parked/standing-horses.json', dataBase));\n+    assert(response.ok, `Horse placements HTTP${response.status}`);\n+    manifest = await response.json();\n+    rows = (manifest.scenes[String(sceneId)] ?? []).filter(row => !hostMissing(row.belongs_to));\n+    assert(rows.length <= 1, 'First standing-horse instance budget is one'); out.records = rows;\n+  } catch (error) { problems.push(`standing horses: ${error.message}`); return out; }\n+  async function load() {\n+    if (disposed || tier === 'light' || active || !rows.length || !manifest || !withinReach()) return;\n+    if (pending) { await pending; if (!disposed && tier !== 'light' && !active) await load(); return; }\n+    if (attemptedRevision === revision) return; // A failed load never silently retries.\n+    const mine = revision; attemptedRevision = mine;\n+    const job = (async () => {\n+      let asset = null;\n+      try {\n+        const row = rows[0], model = manifest.models[row.model];\n+        assert(model, 'Standing-horse model not declared');\n+        const sidecarResponse = await fetch(new URL(model.sidecar, dataBase));\n+        assert(sidecarResponse.ok, `Horse sidecar HTTP${sidecarResponse.status}`);\n+        const spec = await sidecarResponse.json();\n+        if (mine !== revision || disposed || tier === 'light') return;\n+        abort = new AbortController();\n+        const file = new URL(model.file, new URL('../', import.meta.url));\n+        const response = await fetch(file, { signal: abort.signal });\n+        assert(response.ok, `Horse GLB HTTP${response.status}`);\n+        const bytes = await response.arrayBuffer();\n+        assert(bytes.byteLength <= 4 * 1024 * 1024, 'Horse download cap exceeded');\n+        assert(await sha256(bytes) === spec.runtime_asset.sha256, 'Horse runtime derivative hash mismatch');\n+        validatePlantedStandingHeader(bytes, spec);\n+        if (mine !== revision || disposed || tier === 'light') return;\n+        asset = await new GLTFLoader().parseAsync(bytes, new URL('.', file).href);\n+        const canonicalReceipt = inspectStanding(asset.scene, spec);\n+        if (mine !== revision || disposed || tier === 'light') return;\n+        const candidate = instantiate(asset, spec, row, confidence, groundHeight);\n+        candidate.receipt.canonical = canonicalReceipt;\n+        active = candidate; asset = null; group.add(active.group);\n+        if (lastCamera) out.update(lastCamera);\n+      } catch (error) {\n+        if (!disposed && mine === revision && error.name !== 'AbortError') problems.push(`standing horses: ${error.message}`);\n+      } finally { abort = null; if (asset) disposeSource(asset); }\n+    })();\n+    pending = job;\n+    try { await job; } finally { if (pending === job) pending = null; }\n+  }\n+  // No GLB download at the distant town spawn: update(camera) starts a single\n+  // lazy load only inside this tier's reach. Await out.ready after that update.\n+  return out;\n+}"},{"sha":"321b82ed36e14f78bdda7fdea562a879fd6e07fe","filename":"chicago/4d/renderers/web/js/yard-static-support.js","status":"added","additions":80,"deletions":0,"changes":80,"blob_url":"https://github.com/kevinrhaas/chicago/blob/fa115d72534e234fe5ac7b94fd2f1a3eb38065c8/chicago%2F4d%2Frenderers%2Fweb%2Fjs%2Fyard-static-support.js","raw_url":"https://github.com/kevinrhaas/chicago/raw/fa115d72534e234fe5ac7b94fd2f1a3eb38065c8/chicago%2F4d%2Frenderers%2Fweb%2Fjs%2Fyard-static-support.js","contents_url":"https://api.github.com/repos/kevinrhaas/chicago/contents/chicago%2F4d%2Frenderers%2Fweb%2Fjs%2Fyard-static-support.js?ref=fa115d72534e234fe5ac7b94fd2f1a3eb38065c8","patch":"@@ -0,0 +1,80 @@\n+// SPDX-License-Identifier: GPL-3.0-or-later\n+// A bounded copy of actual rendered yard triangles, made BEFORE upload release.\n+import * as THREE from 'three';\n+\n+const MAX_REGIONS = 1, MAX_TRIANGLES = 32, MAX_BYTES = 4096;\n+\n+/** Retains only triangles overlapping a declared small ENU support rectangle.\n+ * Does not retain original town arrays, change RELEASE_KEEP or depend on\n+ * ?keep-geometry. Fresh yard batches have contiguous, undeleted instance IDs.\n+ */\n+export function retainYardStaticSupport(group, regions = [], problems = []) {\n+  const retained = new Map(), census = { regions: 0, triangles: 0, bytes: 0, disposed: false };\n+  const out = { census,\n+    heightAt(e, n, recordId, regionId) {\n+      const entry = retained.get(regionId);\n+      if (!entry || census.disposed || entry.recordId !== recordId) return null;\n+      const [[e0, n0], [e1, n1]] = entry.bounds;\n+      if (e < e0 || e > e1 || n < n0 || n > n1) return null;\n+      const z = -n, a = entry.triangles; let highest = -Infinity;\n+      for (let i = 0; i < a.length; i += 9) {\n+        const x0 = a[i], z0 = a[i + 2], dx1 = a[i + 3] - x0, dz1 = a[i + 5] - z0;\n+        const dx2 = a[i + 6] - x0, dz2 = a[i + 8] - z0;\n+        const determinant = dx1 * dz2 - dx2 * dz1;\n+        if (Math.abs(determinant) < 1e-12) continue;\n+        const u = ((e - x0) * dz2 - (z - z0) * dx2) / determinant;\n+        const v = (dx1 * (z - z0) - dz1 * (e - x0)) / determinant;\n+        if (u < -1e-9 || v < -1e-9 || u + v > 1 + 1e-9) continue;\n+        const y = a[i + 1] + u * (a[i + 4] - a[i + 1]) + v * (a[i + 7] - a[i + 1]);\n+        highest = Math.max(highest, y);\n+      }\n+      return Number.isFinite(highest) ? highest : null;\n+    },\n+    dispose() { retained.clear(); census.disposed = true; census.regions = census.triangles = census.bytes = 0; },\n+  };\n+  if (regions.length > MAX_REGIONS) { problems.push('yards: static support region budget exceeded'); return out; }\n+  const point = new THREE.Vector3(), matrix = new THREE.Matrix4();\n+  group.updateMatrixWorld(true);\n+  for (const region of regions) {\n+    try {\n+      const b = region.bounds_enu_m;\n+      if (!region.id || !region.record_id || !Array.isArray(b) || b.flat().length !== 4\n+        || !b.flat().every(Number.isFinite) || b[1][0] <= b[0][0] || b[1][1] <= b[0][1]\n+        || (b[1][0] - b[0][0]) * (b[1][1] - b[0][1]) > 4 || retained.has(region.id)) {\n+        throw Error('Invalid/oversized static support rectangle');\n+      }\n+      const values = [];\n+      for (const mesh of group.children) {\n+        if (mesh.name !== 'yard-worn_earth') continue;\n+        if (!mesh.isBatchedMesh) throw Error('Expected actual yard BatchedMesh');\n+        const position = mesh.geometry.getAttribute('position'), index = mesh.geometry.getIndex();\n+        if (!position?.array || (index && !index.array?.length)) throw Error('Yard arrays released before support snapshot');\n+        for (let instance = 0; instance < mesh.instanceCount; instance++) {\n+          if (!mesh.getVisibleAt(instance)) continue;\n+          const range = mesh.getGeometryRangeAt(mesh.getGeometryIdAt(instance));\n+          mesh.getMatrixAt(instance, matrix).premultiply(mesh.matrixWorld);\n+          for (let i = range.start; i < range.start + range.count; i += 3) {\n+            const triangle = [];\n+            for (let j = 0; j < 3; j++) {\n+              point.fromBufferAttribute(position, index ? index.getX(i + j) : i + j).applyMatrix4(matrix);\n+              if (![point.x, point.y, point.z].every(Number.isFinite)) throw Error('Nonfinite support triangle');\n+              triangle.push(point.x, point.y, point.z);\n+            }\n+            const es = [triangle[0], triangle[3], triangle[6]], ns = [-triangle[2], -triangle[5], -triangle[8]];\n+            if (Math.max(...es) < b[0][0] || Math.min(...es) > b[1][0]\n+              || Math.max(...ns) < b[0][1] || Math.min(...ns) > b[1][1]) continue;\n+            values.push(...triangle);\n+            if (values.length / 9 > MAX_TRIANGLES || (values.length * 8 + census.bytes) > MAX_BYTES) {\n+              throw Error('Static support triangle/byte cap exceeded; horse support unavailable');\n+            }\n+          }\n+        }\n+      }\n+      if (!values.length) throw Error('No actual yard triangles overlap support rectangle');\n+      const triangles = new Float64Array(values);\n+      retained.set(region.id, { recordId: region.record_id, bounds: b, triangles });\n+      census.regions++; census.triangles += triangles.length / 9; census.bytes += triangles.byteLength;\n+    } catch (error) { problems.push(`yards static support: ${error.message}`); }\n+  }\n+  return out;\n+}"},{"sha":"630d10b9441395e25962dbfba0b714efce2168a5","filename":"chicago/4d/renderers/web/js/yards.js","status":"modified","additions":14,"deletions":2,"changes":16,"blob_url":"https://github.com/kevinrhaas/chicago/blob/fa115d72534e234fe5ac7b94fd2f1a3eb38065c8/chicago%2F4d%2Frenderers%2Fweb%2Fjs%2Fyards.js","raw_url":"https://github.com/kevinrhaas/chicago/raw/fa115d72534e234fe5ac7b94fd2f1a3eb38065c8/chicago%2F4d%2Frenderers%2Fweb%2Fjs%2Fyards.js","contents_url":"https://api.github.com/repos/kevinrhaas/chicago/contents/chicago%2F4d%2Frenderers%2Fweb%2Fjs%2Fyards.js?ref=fa115d72534e234fe5ac7b94fd2f1a3eb38065c8","patch":"@@ -64,6 +64,7 @@\n  */\n \n import * as THREE from 'three';\n+import { retainYardStaticSupport } from './yard-static-support.js';\n import { GRIT_TILE_M } from './ground-strip-mask.js';\n import { DIRT_TONES, linearTone, roadGrit } from './streets.js';\n import { swardTexture, swardUniforms } from './terrain.js';\n@@ -772,7 +773,7 @@ function rectRing(frame, u0, u1, v0, v1) {\n  *          async since T-2600: its surfaces are partitioned on the job pool\n  */\n export async function createFencedGround({\n-  records = [], terrain, confidence = null, problems = [], prebuilt = null, recordHashes = null,\n+  records = [], terrain, confidence = null, problems = [], prebuilt = null, recordHashes = null, supportRegions = [],\n } = {}) {\n   const group = new THREE.Group();\n   group.name = 'yard-ground';\n@@ -782,6 +783,8 @@ export async function createFencedGround({\n     census: { interiors: 0, cells: 0, beds: 0, paths: 0, byTreatment: {} },\n     suppressesSward: () => false,\n     treatmentAt: () => null,\n+    drawnBaseHeightAt: () => null,\n+    staticSupport: { regions: 0, triangles: 0, bytes: 0, disposed: false },\n     dispose: () => {},\n     /** T-2711: whether the surfaces came prebuilt, and if not, why not. */\n     prebuilt: { used: false, why: prebuilt ? null : 'none offered' },\n@@ -1086,7 +1089,16 @@ export async function createFencedGround({\n     problems.push('yards: every fenced interior refused its ground — nothing is laid inside '\n       + 'any fence in the town');\n   }\n-  out.dispose = () => { for (const d of disposables) d.dispose?.(); };\n+  // Retain only declared small regions before normal coarse upload-release.\n+  const support = retainYardStaticSupport(group, supportRegions, problems);\n+  out.staticSupport = support.census;\n+  out.drawnBaseHeightAt = (e, n, recordId, regionId) => {\n+    const interior = out.interiors.find(item => item.record === recordId\n+      && pointInPolygon(item.pts, e, n));\n+    if (!interior || interior.treatment !== 'worn_earth') return null;\n+    return support.heightAt(e, n, recordId, regionId);\n+  };\n+  out.dispose = () => { support.dispose(); for (const d of disposables) d.dispose?.(); };\n   return out;\n }\n "},{"sha":"0f101be2925a651d0f5510e56c748b05e44246f1","filename":"chicago/4d/renderers/web/transport/LICENSES.md","status":"modified","additions":5,"deletions":0,"changes":5,"blob_url":"https://github.com/kevinrhaas/chicago/blob/fa115d72534e234fe5ac7b94fd2f1a3eb38065c8/chicago%2F4d%2Frenderers%2Fweb%2Ftransport%2FLICENSES.md","raw_url":"https://github.com/kevinrhaas/chicago/raw/fa115d72534e234fe5ac7b94fd2f1a3eb38065c8/chicago%2F4d%2Frenderers%2Fweb%2Ftransport%2FLICENSES.md","contents_url":"https://api.github.com/repos/kevinrhaas/chicago/contents/chicago%2F4d%2Frenderers%2Fweb%2Ftransport%2FLICENSES.md?ref=fa115d72534e234fe5ac7b94fd2f1a3eb38065c8","patch":"@@ -78,3 +78,8 @@ The public-domain appearance reference is US1893 Studebaker catalogue leaf0095,\n The authored binding files `assets/authored/transport/wagon_parked_fine_wood/{surface.json,surface.bin}` combine original project GPL-3.0-or-later UV/tangent/index charts with the documented CC0 image derivatives; the geometry is freshly regenerated by `tools/transport/generate_parked_wagon_fine_wood.py` through the unchanged original W01 pipeline. `ATTRIBUTION.txt` and `SOURCE.json` preserve creator, URLs, source hashes and transformations. The installed `renderers/web/transport/parked-wagon-fine-wood/wagon-w01.glb` SHA256 is e1e5b4f1d7dfe6bf08cca21e8cfae2e88748a3f6e6c6959753334ae2b0c84dd8. The original parked-wagon asset remains unchanged. The two covered variants retain distinct finish families and take only the separately documented cloth-drape increment.\n \n The covered-cloth refinement under T-2980 changes only the reconstructed inter-bow drape constants (8–10mm to20–28mm over750mm spans), retaining original GPL geometry/source lineage and CC0 analytic texture pixels. Current source/product hashes are in `assets/authored/transport/wagon_covered/SOURCE.json`: core679fc439, blue GLB aaffa339, oak GLB22072e6f. Variant identities, seeded finish colors/aging, yokes, pivots, stands and newer terrain qualification are preserved. This is not an attested historic textile form or physical cloth simulation.\n+\n+\n+## Canonical26 planted-standing horse (T-2800/T-2803)\n+\n+`standing-horse/horse-sevket-v16-planted-standing-v1.glb`: CC BY4.0 derivative of “Horse” by sevketkabatas, https://sketchfab.com/3d-models/horse-53a6eb7ccf054aa2a378dd7ec08f88fe. Exact b479442cb03ac46eb13c19da15a79cdfaf28dbdf356b116f78de7ce7ecdc60be,3,783,600bytes. Canonical-metre surface, reconstructed26 rig/V16skin and planted12s body shift; no original head/tail or walking playback. Hierarchy analogy only: antemeossa Rigged Mid-Poly Horse, CC BY4.0, https://sketchfab.com/3d-models/rigged-mid-poly-horse-fea999c1d8d64eb4a9c2bb1fac1e7d83. Exact rights/change notices and mirrored authored binary are in assets/authored/transport/horse_standing and assets/LICENSES.md. Selected runtime dielectric metalness0 is explicit. No historical individual/breed/photo/gait/riding approval."},{"sha":"3de1aad35ca97afd23643cb15359ccb9b081242a","filename":"chicago/4d/renderers/web/transport/standing-horse/horse-sevket-v16-planted-standing-v1.glb","status":"added","additions":0,"deletions":0,"changes":0,"blob_url":"https://github.com/kevinrhaas/chicago/blob/fa115d72534e234fe5ac7b94fd2f1a3eb38065c8/chicago%2F4d%2Frenderers%2Fweb%2Ftransport%2Fstanding-horse%2Fhorse-sevket-v16-planted-standing-v1.glb","raw_url":"https://github.com/kevinrhaas/chicago/raw/fa115d72534e234fe5ac7b94fd2f1a3eb38065c8/chicago%2F4d%2Frenderers%2Fweb%2Ftransport%2Fstanding-horse%2Fhorse-sevket-v16-planted-standing-v1.glb","contents_url":"https://api.github.com/repos/kevinrhaas/chicago/contents/chicago%2F4d%2Frenderers%2Fweb%2Ftransport%2Fstanding-horse%2Fhorse-sevket-v16-planted-standing-v1.glb?ref=fa115d72534e234fe5ac7b94fd2f1a3eb38065c8"},{"sha":"c45d211ec947f892e2a90158e8cd2768c5fe709a","filename":"chicago/4d/tools/check.sh","status":"modified","additions":3,"deletions":0,"changes":3,"blob_url":"https://github.com/kevinrhaas/chicago/blob/fa115d72534e234fe5ac7b94fd2f1a3eb38065c8/chicago%2F4d%2Ftools%2Fcheck.sh","raw_url":"https://github.com/kevinrhaas/chicago/raw/fa115d72534e234fe5ac7b94fd2f1a3eb38065c8/chicago%2F4d%2Ftools%2Fcheck.sh","contents_url":"https://api.github.com/repos/kevinrhaas/chicago/contents/chicago%2F4d%2Ftools%2Fcheck.sh?ref=fa115d72534e234fe5ac7b94fd2f1a3eb38065c8","patch":"@@ -361,6 +361,9 @@ step \"Catalogue Brougham preserves exact V17 near and genuine11706mid, contacts\n step \"Brougham card and actual near/mid selection preserve catalogue scope, current/historical card contracts, active picking and disposal (T-2794)\" \\\n   node tools/test_brougham_card.mjs\n \n+step \"Canonical planted-standing horse preserves metre scale, allowed clip, clocks, modern credit and bounded drawn-yard support (T-2800/T-2803)\" \\\n+  node tools/test_planted_standing_horse_contract.mjs\n+\n step \"Parked vehicles keep their exact wagon stands and cannot cross era boundaries (T-2979)\" \\\n   python3 tools/transport/check_parked_placements.py\n # Fresh original W01 geometry plus authored project charts and CC0 maps; about 13 s, no browser."},{"sha":"d09791d282d948025c8c9b9ea77b6dec8692eacf","filename":"chicago/4d/tools/step_isolation.json","status":"modified","additions":4,"deletions":0,"changes":4,"blob_url":"https://github.com/kevinrhaas/chicago/blob/fa115d72534e234fe5ac7b94fd2f1a3eb38065c8/chicago%2F4d%2Ftools%2Fstep_isolation.json","raw_url":"https://github.com/kevinrhaas/chicago/raw/fa115d72534e234fe5ac7b94fd2f1a3eb38065c8/chicago%2F4d%2Ftools%2Fstep_isolation.json","contents_url":"https://api.github.com/repos/kevinrhaas/chicago/contents/chicago%2F4d%2Ftools%2Fstep_isolation.json?ref=fa115d72534e234fe5ac7b94fd2f1a3eb38065c8","patch":"@@ -5898,6 +5898,10 @@\n       \"wrote\": [],\n       \"wrote_ignored\": []\n     },\n+    \"tools/test_planted_standing_horse_contract.mjs\": {\n+      \"wrote\": [],\n+      \"wrote_ignored\": []\n+    },\n     \"tools/test_portal_clips.mjs\": {\n       \"wrote\": [],\n       \"wrote_ignored\": []"},{"sha":"6ba1e64e3a5ee8397aada88e554755aa1caa8205","filename":"chicago/4d/tools/test_check_harness.sh","status":"modified","additions":7,"deletions":7,"changes":14,"blob_url":"https://github.com/kevinrhaas/chicago/blob/fa115d72534e234fe5ac7b94fd2f1a3eb38065c8/chicago%2F4d%2Ftools%2Ftest_check_harness.sh","raw_url":"https://github.com/kevinrhaas/chicago/raw/fa115d72534e234fe5ac7b94fd2f1a3eb38065c8/chicago%2F4d%2Ftools%2Ftest_check_harness.sh","contents_url":"https://api.github.com/repos/kevinrhaas/chicago/contents/chicago%2F4d%2Ftools%2Ftest_check_harness.sh?ref=fa115d72534e234fe5ac7b94fd2f1a3eb38065c8","patch":"@@ -343,13 +343,13 @@ fi\n \n # THE DEFAULT ITSELF. T-1289 built the pool and left it off, and for three months the\n # only caller that turned it on was CI — so the sandbox that could not afford a serial\n-# gate was the one running one. A default back at 1 is that regression, silently.\n-default_jobs=\"$(bash -c 'source tools/check_harness.sh; printf \"%s\" \"$CHECK_JOBS\"')\"\n-if [ \"$default_jobs\" -gt 1 ] 2>/dev/null; then\n-  ok \"the pool is on by default ($default_jobs jobs on $(nproc 2>/dev/null || echo '?') cores)\"\n-else\n-  bad \"CHECK_JOBS defaults to [$default_jobs] — a serial gate does not fit a 600 s run (T-1578)\"\n-fi\n+# gate was the one running one. Returning 1 on four available cores is that regression.\n+# Child-local CPU fixtures isolate policy from outer CHECK_JOBS/math-thread limits;\n+# one actual available core legitimately defaults to 1.\n+default_jobs=\"$(bash -c 'unset CHECK_JOBS; nproc() { printf \"4\\n\"; }; source tools/check_harness.sh; printf \"%s\" \"$CHECK_JOBS\"')\"\n+want \"$default_jobs\" \"4\" \"the default uses all four available fixture cores\"\n+one_core_jobs=\"$(bash -c 'unset CHECK_JOBS; nproc() { printf \"1\\n\"; }; source tools/check_harness.sh; printf \"%s\" \"$CHECK_JOBS\"')\"\n+want \"$one_core_jobs\" \"1\" \"a single available fixture core legitimately defaults to one job\"\n want \"$(CHECK_JOBS=1 bash -c 'source tools/check_harness.sh; printf \"%s\" \"$CHECK_JOBS\"')\" \"1\" \\\n      \"…and an explicit CHECK_JOBS still wins, which is the escape hatch\"\n "},{"sha":"bbfd7b44f7097dd450eb68a015723bdd80b4504c","filename":"chicago/4d/tools/test_merge_ready.mjs","status":"modified","additions":14,"deletions":4,"changes":18,"blob_url":"https://github.com/kevinrhaas/chicago/blob/fa115d72534e234fe5ac7b94fd2f1a3eb38065c8/chicago%2F4d%2Ftools%2Ftest_merge_ready.mjs","raw_url":"https://github.com/kevinrhaas/chicago/raw/fa115d72534e234fe5ac7b94fd2f1a3eb38065c8/chicago%2F4d%2Ftools%2Ftest_merge_ready.mjs","contents_url":"https://api.github.com/repos/kevinrhaas/chicago/contents/chicago%2F4d%2Ftools%2Ftest_merge_ready.mjs?ref=fa115d72534e234fe5ac7b94fd2f1a3eb38065c8","patch":"@@ -50,6 +50,12 @@ function run({ list = '', listExit = 0, states = {}, only = '', dry = '' }) {\n   const bin = path.join(box, 'bin');\n   mkdirSync(bin, { recursive: true });\n   const merges = path.join(box, 'merges.txt');\n+  // Resolve the fixed fixture responses here: the fake CLI needs no Node child.\n+  // Shell quoting keeps both case keys and response values literal.\n+  const quoteShell = (value) => \"'\" + String(value).replaceAll(\"'\", \"'\\\\''\") + \"'\";\n+  const stateCases = Object.entries(states)\n+    .map(([number, state]) => `  ${quoteShell(number)}) printf '%s\\\\n' ${quoteShell(state)} ;;`)\n+    .join('\\n');\n \n   writeFileSync(path.join(bin, 'gh'), `#!/usr/bin/env bash\n # the merge itself — recorded, never performed\n@@ -70,9 +76,11 @@ for a in \"$@\"; do\n   esac\n done\n case \"$*\" in\n-  *\".mergeable_state\"*) echo \"$(node -e '\n-      const s=JSON.parse(process.argv[1]); process.stdout.write(s[process.argv[2]]||\"unknown\");\n-    ' ${JSON.stringify(JSON.stringify(states))} \"$N\")\" ;;\n+  *\".mergeable_state\"*)\n+    case \"$N\" in\n+${stateCases}\n+      *) printf '%s\\\\n' 'unknown' ;;\n+    esac ;;\n   *\".head.sha\"*)        echo \"deadbeefdeadbeefdeadbeefdeadbeefdeadbeef\" ;;\n   *\".title\"*)           echo \"a pull request\" ;;\n esac\n@@ -195,8 +203,10 @@ console.log('merge-ready.sh — merges what GitHub calls clean, and nothing else\n  *    no flag at all. */\n {\n   const r = run({ list: '1319\\n', states: { 1319: 'clean' }, dry: '1' });\n+  const diagnostic = `exit ${r.code}; ${r.out.trim() || '(no output)'}`;\n+  check('a dry run exits cleanly', r.code === 0, diagnostic);\n   check('a dry run merges nothing', r.merges === '', r.merges.trim());\n-  check('…and says what it would have done', /WOULD MERGE/.test(r.out));\n+  check('…and says what it would have done', /WOULD MERGE/.test(r.out), diagnostic);\n }\n \n /* 9. MERGE_ONLY THAT MATCHES NOTHING IS LOUD. Drafts and `hold` are filtered out"},{"sha":"acad418643662dea6942b1d42d24b46d5118f26e","filename":"chicago/4d/tools/test_planted_standing_horse_contract.mjs","status":"added","additions":108,"deletions":0,"changes":108,"blob_url":"https://github.com/kevinrhaas/chicago/blob/fa115d72534e234fe5ac7b94fd2f1a3eb38065c8/chicago%2F4d%2Ftools%2Ftest_planted_standing_horse_contract.mjs","raw_url":"https://github.com/kevinrhaas/chicago/raw/fa115d72534e234fe5ac7b94fd2f1a3eb38065c8/chicago%2F4d%2Ftools%2Ftest_planted_standing_horse_contract.mjs","contents_url":"https://api.github.com/repos/kevinrhaas/chicago/contents/chicago%2F4d%2Ftools%2Ftest_planted_standing_horse_contract.mjs?ref=fa115d72534e234fe5ac7b94fd2f1a3eb38065c8","patch":"@@ -0,0 +1,108 @@\n+// Contract/lifecycle unit only; not loaded skin, contact, bounds or visual proof.\n+import assert from 'node:assert/strict';\n+import { readFileSync } from 'node:fs';\n+import { createHash } from 'node:crypto';\n+import { register } from 'node:module';\n+import { standingHorseCard } from '../renderers/web/js/standing-horse-card.js';\n+import { validatePlantedStandingHeader, createPlantedStandingHorseIdle, PLANTED_SHA, PLANTED_CLIP }\n+  from '../renderers/web/js/standing-horse-planted-idle.js';\n+const spec = JSON.parse(readFileSync(new URL('../data/transport/parked/horse-sevket-sidecar.json', import.meta.url)));\n+const buffer = readFileSync(new URL('../renderers/web/transport/standing-horse/horse-sevket-v16-planted-standing-v1.glb', import.meta.url));\n+assert.equal(createHash('sha256').update(buffer).digest('hex'), PLANTED_SHA);\n+const bytes = buffer.buffer.slice(buffer.byteOffset, buffer.byteOffset + buffer.byteLength);\n+const header = validatePlantedStandingHeader(bytes, spec);\n+assert.throws(() => validatePlantedStandingHeader(bytes, { ...spec, runtime_scale_m_per_unit: .36440688373115426 }), /unit scale/);\n+assert.throws(() => validatePlantedStandingHeader(bytes, { ...spec, runtime_origin_m: [.001, 0, 0] }), /unit scale/);\n+assert.throws(() => validatePlantedStandingHeader(bytes.slice(0, -4), spec), /byte budget/);\n+function altered(change) {\n+  const json = structuredClone(header); change(json);\n+  const encoded = new TextEncoder().encode(JSON.stringify(json)), copy = new ArrayBuffer(bytes.byteLength), view = new DataView(copy);\n+  view.setUint32(0, 0x46546c67, true); view.setUint32(4, 2, true); view.setUint32(8, copy.byteLength, true);\n+  view.setUint32(12, encoded.length, true); view.setUint32(16, 0x4e4f534a, true);\n+  new Uint8Array(copy, 20, encoded.length).set(encoded);\n+  return copy; // Synthetic metadata guard control; never passed off as actual GLB.\n+}\n+assert.throws(() => validatePlantedStandingHeader(altered(j => j.skins[0].joints.pop()), spec), /rig/);\n+assert.throws(() => validatePlantedStandingHeader(altered(j => j.animations.push(structuredClone(j.animations[0]))), spec), /only planted/);\n+assert.throws(() => validatePlantedStandingHeader(altered(j => { j.animations[0].channels[0].target.node = 0; }), spec), /unapproved/);\n+assert.throws(() => validatePlantedStandingHeader(altered(j => { j.animations[0].channels[1].target.node = 3; }), spec), /unapproved/);\n+assert.throws(() => validatePlantedStandingHeader(altered(j => { j.animations[0].samplers[0].interpolation = 'STEP'; }), spec), /key\\/time/);\n+assert.throws(() => validatePlantedStandingHeader(altered(j => { j.buffers[0].uri = 'unreviewed.bin'; }), spec), /embedded/);\n+\n+// Exact target identities with a deliberately tiny mixer mock test host-clock\n+// ownership, hold and disposal; physical pose qualification uses real THREE.\n+const bones = header.skins[0].joints.map(i => ({ name: header.nodes[i].name }));\n+const byName = new Map(bones.map(b => [b.name, b]));\n+const meshes = Array.from({ length: 3 }, () => ({ isMesh: true, isSkinnedMesh: true, skeleton: { bones } }));\n+const root = { userData: {}, traverse: fn => meshes.forEach(fn) };\n+const times = Float32Array.from({ length: 65 }, (_, i) => i * 12 / 64);\n+const clip = { name: PLANTED_CLIP, duration: 12, tracks: header.animations[0].channels.map(c => ({\n+  name: `${header.nodes[c.target.node].name}.${c.target.path === 'translation' ? 'position' : 'quaternion'}`, times,\n+})) };\n+let mixer;\n+class Mixer {\n+  constructor() { mixer = this; this.advanced = 0; this.stops = 0; this.uncaches = 0; }\n+  clipAction() { return { setLoop() {}, play() {} }; }\n+  setTime(t) { assert.equal(t, 0); }\n+  update(dt) { this.advanced += dt; }\n+  stopAllAction() { this.stops++; }\n+  uncacheRoot(r) { assert.equal(r, root); this.uncaches++; }\n+}\n+const T = { AnimationMixer: Mixer, LoopRepeat: 2201, PropertyBinding: {\n+  parseTrackName(name) { const [nodeName, propertyName] = name.split('.'); return { nodeName, propertyName }; },\n+  findNode(r, name) { assert.equal(r, root); return byName.get(name); },\n+} };\n+const args = { T, root, clips: [clip], verifiedDerivedSha256: PLANTED_SHA, instanceId: 'western_hotel_yard_standing_horse_01' };\n+const player = createPlantedStandingHorseIdle(args);\n+assert.throws(() => createPlantedStandingHorseIdle(args), /already has/);\n+player.update(3); const advanced = mixer.advanced; assert(advanced > 0);\n+for (const hold of [{ paused: true }, { reducedMotion: true }, { visible: false }]) {\n+  player.update(1, hold); assert.equal(mixer.advanced, advanced);\n+}\n+assert.throws(() => player.update(-1), /host delta/);\n+assert.equal(player.status.weight_shift, true); assert.equal(player.status.head_tail_composed, false);\n+assert.equal(player.status.walk, false); assert.equal(player.status.trot, false);\n+player.dispose(); player.dispose(); player.update(1);\n+assert.equal(mixer.advanced, advanced); assert.equal(mixer.stops, 1); assert.equal(mixer.uncaches, 1);\n+assert.equal(player.status.mixer_count, 0);\n+\n+// Modern asset credit never becomes an historically attested animal attribute.\n+const row = JSON.parse(readFileSync(new URL('../data/transport/parked/standing-horses.json', import.meta.url))).scenes['1835'][0];\n+const card = standingHorseCard(row, spec).sidecar;\n+assert(card.change_note.includes('reconstructed, unidentified horse'));\n+assert(card.change_note.includes(spec.source.credit));\n+assert(card.citations.some(c => c.source_id === spec.source.id && c.url === spec.source.original_url));\n+assert(card.citations.every(c => c.citation && c.url));\n+const missingCredit = structuredClone(spec); delete missingCredit.citation_records[spec.source.id];\n+assert.throws(() => standingHorseCard(row, missingCredit), /citation does not resolve/);\n+for (const value of Object.values(card.attributes)) assert(!(value.sources ?? []).includes(spec.source.id));\n+\n+// Existing bounded yard snapshot helper: actual Two-triangle BatchedMesh,\n+// then simulated normal GPU upload-release. No renderer/context is created.\n+const vendor = new URL('../renderers/web/vendor/three-0.185.1/three.module.js', import.meta.url).href;\n+register(`data:text/javascript,${encodeURIComponent(`export function resolve(s,c,next){if(s==='three')return{url:'${vendor}',shortCircuit:true};return next(s,c);}`)}`, import.meta.url);\n+const RealT = await import('three');\n+const { retainYardStaticSupport } = await import('../renderers/web/js/yard-static-support.js');\n+const geometry = new RealT.BufferGeometry();\n+geometry.setAttribute('position', new RealT.Float32BufferAttribute([0,1,0,1,1.1,0,1,1.3,-1,0,1.2,-1],3));\n+geometry.setIndex([0,1,2,0,2,3]);\n+const yardMesh = new RealT.BatchedMesh(1,4,6,new RealT.MeshBasicMaterial({side:RealT.DoubleSide}));\n+yardMesh.addInstance(yardMesh.addGeometry(geometry)); yardMesh.name='yard-worn_earth';\n+const yardGroup = new RealT.Group(); yardGroup.add(yardMesh); yardGroup.updateMatrixWorld(true);\n+const region={id:'test',record_id:'yard',bounds_enu_m:[[-.05,-.05],[1.05,1.05]]};\n+const problems=[], cache=retainYardStaticSupport(yardGroup,[region],problems);\n+assert.equal(problems.length,0); assert.equal(cache.census.triangles,2); assert.equal(cache.census.bytes,144);\n+const ray = new RealT.Raycaster(); ray.set(new RealT.Vector3(.5,5,-.5),new RealT.Vector3(0,-1,0));\n+const actualY = ray.intersectObject(yardMesh,false)[0].point.y;\n+assert(Math.abs(cache.heightAt(.5,.5,'yard','test')-actualY)<1e-12);\n+yardMesh.geometry.getAttribute('position').array=null;\n+yardMesh.geometry.index.array=new yardMesh.geometry.index.array.constructor(0);\n+assert(Math.abs(cache.heightAt(.5,.5,'yard','test')-actualY)<1e-12);\n+assert.equal(cache.heightAt(.5,.5,'other','test'),null); assert.equal(cache.heightAt(2,2,'yard','test'),null);\n+cache.dispose(); assert.equal(cache.census.bytes,0); assert.equal(cache.heightAt(.5,.5,'yard','test'),null);\n+const capProblems=[]; const capped=retainYardStaticSupport(yardGroup,[region,{...region,id:'second'}],capProblems);\n+assert.equal(capProblems.length,1); assert.equal(capped.census.bytes,0);\n+const lateProblems=[]; const late=retainYardStaticSupport(yardGroup,[region],lateProblems);\n+assert.equal(lateProblems.length,1); assert.equal(late.census.bytes,0);\n+yardMesh.dispose(); geometry.dispose(); yardMesh.material.dispose();\n+console.log('STANDING INTEGRATION UNIT PASS — modern-credit separation and bounded144B actual-yard fixture snapshot survives upload release; late/cap refusals and disposal. No actual town/render/photo proof.');"},{"sha":"f9a5afc8da9fe591c29700b7013a693fda78b1cc","filename":"chicago/4d/tools/test_pr_lap_lock.mjs","status":"modified","additions":42,"deletions":7,"changes":49,"blob_url":"https://github.com/kevinrhaas/chicago/blob/fa115d72534e234fe5ac7b94fd2f1a3eb38065c8/chicago%2F4d%2Ftools%2Ftest_pr_lap_lock.mjs","raw_url":"https://github.com/kevinrhaas/chicago/raw/fa115d72534e234fe5ac7b94fd2f1a3eb38065c8/chicago%2F4d%2Ftools%2Ftest_pr_lap_lock.mjs","contents_url":"https://api.github.com/repos/kevinrhaas/chicago/contents/chicago%2F4d%2Ftools%2Ftest_pr_lap_lock.mjs?ref=fa115d72534e234fe5ac7b94fd2f1a3eb38065c8","patch":"@@ -63,7 +63,8 @@ function runClone(box, name, remote) {\n const tool = (repo, ...args) => {\n   const r = spawnSync('node', [path.join(repo, 'chicago', '4d', 'tools', 'ticket.mjs'), ...args],\n     { cwd: repo, encoding: 'utf8' });\n-  return { code: r.status, out: `${r.stdout ?? ''}${r.stderr ?? ''}`.trim() };\n+  return { code: r.status, signal: r.signal, error: r.error?.message,\n+    out: `${r.stdout ?? ''}${r.stderr ?? ''}`.trim() };\n };\n \n /** The lock as a live run takes it: the REAL `ticket.mjs lap`, from a sibling clone. */\n@@ -80,8 +81,15 @@ function plantAged(box, remote, hours) {\n     GIT_AUTHOR_NAME: 'old', GIT_AUTHOR_EMAIL: 'old@test', GIT_COMMITTER_NAME: 'old', GIT_COMMITTER_EMAIL: 'old@test' };\n   const scratch = path.join(box, `aged-${hours}`);\n   git(box, 'init', '--quiet', scratch);\n-  const tree = spawnSync('git', ['hash-object', '-w', '-t', 'tree', '/dev/null'], { cwd: scratch, encoding: 'utf8' }).stdout.trim();\n-  const c = spawnSync('git', ['commit-tree', tree, '-m', `lap PR #${PR} — a run that died`], { cwd: scratch, encoding: 'utf8', env }).stdout.trim();\n+  const tree = git(scratch, 'hash-object', '-w', '-t', 'tree', '/dev/null').trim();\n+  const aged = spawnSync('git', ['commit-tree', tree, '-m', `lap PR #${PR} — a run that died`], { cwd: scratch, encoding: 'utf8', env });\n+  if (aged.error || aged.status !== 0) {\n+    throw new Error(`could not create the aged marker: ${JSON.stringify({\n+      code: aged.status, signal: aged.signal, error: aged.error?.message,\n+      out: `${aged.stdout ?? ''}${aged.stderr ?? ''}`,\n+    })}`);\n+  }\n+  const c = aged.stdout.trim();\n   git(scratch, 'push', '--quiet', '--force', remote, `${c}:refs/heads/lap/pr-${PR}`);\n }\n \n@@ -236,8 +244,18 @@ function lap({ lock = 'none', midLap = false, noTool = false, source = null }) {\n   // A sibling run, ready to take the lock from inside the lap if the case asks.\n   const sibling = runClone(box, 'sibling', bare);\n   const takeFromInside = midLap\n-    ? `import { spawnSync } from 'node:child_process';\n-spawnSync('node', [${JSON.stringify(path.join(sibling, 'chicago', '4d', 'tools', 'ticket.mjs'))}, 'lap', '${PR}', '--by', 'sibling run'], { cwd: ${JSON.stringify(sibling)} });\n+    ? `import { pathToFileURL } from 'node:url';\n+// This clean fixture rebuilds once with --run, then once with --tail. Invoke\n+// the REAL CLI only on --run; a second take would correctly refuse the first.\n+if (process.argv.includes('--run')) {\n+  const savedCwd = process.cwd(), savedArgv = process.argv;\n+  const ticket = ${JSON.stringify(path.join(sibling, 'chicago', '4d', 'tools', 'ticket.mjs'))};\n+  process.chdir(${JSON.stringify(sibling)});\n+  process.argv = [process.execPath, ticket, 'lap', '${PR}', '--by', 'sibling run'];\n+  await import(pathToFileURL(ticket).href);\n+  process.chdir(savedCwd);\n+  process.argv = savedArgv;\n+}\n `\n     : '';\n   writeFileSync(path.join(tools, 'rederive.mjs'), `${takeFromInside}console.log('[1/1] ok');\\n`);\n@@ -270,6 +288,9 @@ spawnSync('node', [${JSON.stringify(path.join(sibling, 'chicago', '4d', 'tools',\n   git(work, 'push', '--quiet', 'origin', 'dev');\n \n   setLock(box, bare, lock);\n+  // Check THIS sandbox's premise, independently of section A's marker. Keep\n+  // the real status and refusal in a failed push assertion's diagnostics.\n+  const staleMarker = lock === 'stale' ? tool(sibling, 'lap', String(PR), '--status') : null;\n \n   writeFileSync(path.join(bin, 'gh'), `#!/usr/bin/env bash\n case \"$*\" in\n@@ -286,9 +307,14 @@ exit 0\n     env: { ...process.env, PATH: `${bin}:${process.env.PATH}`, GH_TOKEN: 'fake', LAP_BASE: 'dev', LAP_ONLY: '' },\n   });\n   const after = git(box, '--git-dir', bare, 'rev-parse', 'refs/heads/claude/resume-1132').trim();\n+  // Read from the outer test after the lap; the production lap only reads\n+  // markers, so this independently proves the rebuild created a real live one.\n+  const midLapMarker = midLap ? tool(sibling, 'lap', String(PR), '--status') : null;\n   rmSync(box, { recursive: true, force: true });\n   const out = `${r.stdout || ''}${r.stderr || ''}`;\n-  return { code: r.status, out, moved: after !== head, summary: (out.match(/^PR lap: .*$/m) || ['no summary'])[0] };\n+  return { code: r.status, signal: r.signal, error: r.error?.message, out,\n+    moved: after !== head, head, after, staleMarker, midLapMarker,\n+    summary: (out.match(/^PR lap: .*$/m) || ['no summary'])[0] };\n }\n \n console.log('\\npr-lap.sh — a PR a live run is lapping is left to that run');\n@@ -302,14 +328,23 @@ console.log('\\npr-lap.sh — a PR a live run is lapping is left to that run');\n }\n {\n   const r = lap({ lock: 'stale' });\n-  check('a dead run\\'s lock does not block the lap: the PR is lapped and pushed', r.moved && /pushed=1/.test(r.summary), r.summary);\n+  check('the stale-lap sandbox really starts with a dead marker',\n+    r.staleMarker?.code === 0 && /^stale lap\\/pr-7\\b/.test(r.staleMarker.out),\n+    JSON.stringify(r.staleMarker));\n+  const pushed = r.code === 0 && !r.error && r.moved && /pushed=1/.test(r.summary);\n+  check('a dead run\\'s lock does not block the lap: the PR is lapped and pushed',\n+    pushed, pushed ? r.summary : JSON.stringify(r));\n }\n {\n   const r = lap({ lock: 'none' });\n   check('no lock at all: lapped and pushed, as before', r.moved && /pushed=1/.test(r.summary), r.summary);\n }\n {\n   const r = lap({ lock: 'none', midLap: true });\n+  check('the rebuild actually took a live sibling marker before judging the push guard',\n+        r.midLapMarker?.code === 3 && /^held lap\\/pr-7\\b/.test(r.midLapMarker.out)\n+          && /sibling run/.test(r.midLapMarker.out),\n+        r.midLapMarker ? `exit ${r.midLapMarker.code}: ${r.midLapMarker.out}` : 'missing fixture marker read');\n   check('a lock taken WHILE the lap rebuilt stops the push — read again at the push',\n         !r.moved && /took lap\\/pr-7 while this lap rebuilt — NOT pushed/.test(r.out), r.summary);\n   check('…and counts it being-lapped', /being-lapped=1/.test(r.summary), r.summary);"},{"sha":"4ea9a5e9b1e1d266bd5eba9065cac81dbe786326","filename":"chicago/4d/tools/test_ticket_mirror.mjs","status":"modified","additions":16,"deletions":3,"changes":19,"blob_url":"https://github.com/kevinrhaas/chicago/blob/fa115d72534e234fe5ac7b94fd2f1a3eb38065c8/chicago%2F4d%2Ftools%2Ftest_ticket_mirror.mjs","raw_url":"https://github.com/kevinrhaas/chicago/raw/fa115d72534e234fe5ac7b94fd2f1a3eb38065c8/chicago%2F4d%2Ftools%2Ftest_ticket_mirror.mjs","contents_url":"https://api.github.com/repos/kevinrhaas/chicago/contents/chicago%2F4d%2Ftools%2Ftest_ticket_mirror.mjs?ref=fa115d72534e234fe5ac7b94fd2f1a3eb38065c8","patch":"@@ -63,13 +63,26 @@ for (const f of ['ticket.mjs', 'check_published.mjs', 'publish.sh']) {\n // link into the real clone and PUSHED to kevinrhaas/chicago-tickets main (T-1502's pr\n // became 9999). So the copy dereferences, and the test refuses to go on unless the\n // sandbox's tickets/ is a real directory inside the sandbox with no .git anywhere in it.\n-cpSync(path.join(REPO, 'tickets'), path.join(APP, 'tickets'),\n-  { recursive: true, dereference: true, filter: (src) => path.basename(src) !== '.git' });\n+// Recovery evidence is not a ticket input. Copying its archived models made the\n+// standing-horse preflight exhaust /tmp before the mirror assertions could run.\n+// Keep every ticket and metadata file; leave only evidence and Git internals out.\n+const ticketsRoot = path.join(REPO, 'tickets');\n+try {\n+  cpSync(ticketsRoot, path.join(APP, 'tickets'), {\n+    recursive: true, dereference: true,\n+    filter: (src) => path.basename(src) !== '.git'\n+      && path.relative(ticketsRoot, src).split(path.sep)[0] !== 'evidence',\n+  });\n+} catch (error) {\n+  rmSync(tmp, { recursive: true, force: true });\n+  throw error;\n+}\n {\n   const own = path.join(APP, 'tickets');\n   const real = realpathSync(own);\n   const inside = real === own || real.startsWith(realpathSync(tmp) + path.sep);\n-  if (lstatSync(own).isSymbolicLink() || !inside || existsSync(path.join(own, '.git'))) {\n+  if (lstatSync(own).isSymbolicLink() || !inside || existsSync(path.join(own, '.git'))\n+      || existsSync(path.join(own, 'evidence'))) {\n     console.error(`ticket mirror — REFUSED: the sandbox's tickets/ resolves to ${real}, ` +\n       'not to a plain copy inside the sandbox; running on would write to the real tickets repo');\n     rmSync(tmp, { recursive: true, force: true });"}]}
readback_reference_sha256\": \"2179deb652914a49ee16b6c05c2a676587fb05bb746f996f7ecc5d121210c0b1\",\n+  \"fields_built\": 0,\n+  \"solvers\": 0,\n+  \"exports\": 1,\n+  \"inputs_unchanged_after\": true,\n+  \"pending\": \"Khronos validation, actual GLTFLoader/Mixer all65 world/skin/normal/contact readback and actual street visuals before any app intake or activation.\"\n+}"},{"sha":"a5acb210045f1d8775340c71f90a88fc82aade1b","filename":"chicago/4d/data/transport/parked/standing-horse-planted/loaded129-summary.json","status":"added","additions":98,"deletions":0,"changes":98,"blob_url":"https://github.com/kevinrhaas/chicago/blob/fa115d72534e234fe5ac7b94fd2f1a3eb38065c8/chicago%2F4d%2Fdata%2Ftransport%2Fparked%2Fstanding-horse-planted%2Floaded129-summary.json","raw_url":"https://github.com/kevinrhaas/chicago/raw/fa115d72534e234fe5ac7b94fd2f1a3eb38065c8/chicago%2F4d%2Fdata%2Ftransport%2Fparked%2Fstanding-horse-planted%2Floaded129-summary.json","contents_url":"https://api.github.com/repos/kevinrhaas/chicago/contents/chicago%2F4d%2Fdata%2Ftransport%2Fparked%2Fstanding-horse-planted%2Floaded129-summary.json?ref=fa115d72534e234fe5ac7b94fd2f1a3eb38065c8","patch":"@@ -0,0 +1,98 @@\n+{\n+  \"status\": \"LOADED_STANDING65_KEYS64_MIDPOINTS_PASS_ONLY\",\n+  \"key_count\": 65,\n+  \"midpoint_count\": 64,\n+  \"normalization\": [\n+    {\n+      \"mesh\": 0,\n+      \"changed_rows\": 28,\n+      \"changed_components\": 34,\n+      \"maximum_delta\": 5.960464477539063e-08,\n+      \"protected_compared_to_accepted_phase_a\": true,\n+      \"protected_non_tail_rows\": 2306,\n+      \"original_standard_loader_vector_differences_measured_only\": 2\n+    },\n+    {\n+      \"mesh\": 1,\n+      \"changed_rows\": 8,\n+      \"changed_components\": 8,\n+      \"maximum_delta\": 1.4901161193847656e-08,\n+      \"protected_compared_to_accepted_phase_a\": true,\n+      \"protected_non_tail_rows\": 3173,\n+      \"original_standard_loader_vector_differences_measured_only\": 133\n+    },\n+    {\n
id\": \"c0502f43233249198d40bcffe1228a90\",\n+        \"size\": 8328,\n+        \"width\": 1024,\n+        \"url\": \"https://media.sketchfab.com/models/53a6eb7ccf054aa2a378dd7ec08f88fe/thumbnails/11da51f99a444acdabdcec1d57d34037/b0f7ec342fca4a789f4196d3035f3342.jpeg\",\n+        \"height\": 576\n+      },\n+      {\n+        \"uid\": \"aefdc8794bd4438a8a6d6f52ba119f28\",\n+        \"size\": 4999,\n+        \"width\": 720,\n+        \"url\": \"https://media.sketchfab.com/models/53a6eb7ccf054aa2a378dd7ec08f88fe/thumbnails/11da51f99a444acdabdcec1d57d34037/d6235718903e4ce5a8d037a25cd9da5d.jpeg\",\n+        \"height\": 405\n+      },\n+      {\n+        \"uid\": \"465832d6de774ef89de90d5cbd1c1a40\",\n+        \"size\": 1203,\n+        \"width\": 256,\n+        \"url\": \"https://media.sketchfab.com/models/53a6eb7ccf054aa2a378dd7ec08f88fe/thumbnails/11da51f99a444acdabdcec1d57d34037/94f346b599d249048899d112fea5aec5.jpeg\",\n+        \"height\": 144\n+      },\n+      {\n+        \"uid\": \"888cd55f6cd347cc9368c59cc04527bc\",\n+        \"size\": 448,\n+        \"width\": 64,\n+        \"url\": \"https://media.sketchfab.com/models/53a6eb7ccf054aa2a378dd7ec08f88fe/thumbnails/11da51f99a444acdabdcec1d57d34037/5bfd870c4fd74b8dae8203156e3cb306.jpeg\",\n+        \"height\": 36\n+      }\n+    ]\n+  },\n+  \"user\": {\n+    \"uid\": \"2f6f641327e9468bb5cb1eac678deea2\",\n+    \"username\": \"sevketkabatas6153\",\n+    \"displayName\": \"sevketkabatas\",\n+    \"profileUrl\": \"https://sketchfab.com/sevketkabatas6153\",\n+    \"account\": \"basic\",\n+    \"avatar\": {\n+      \"uri\": \"https://api.sketchfab.com/v3/avatars/0b3eacb72e2041f78fe1f2caddb464a2\",\n+      \"images\": [\n+        {\n+          \"size\": 809,\n+          \"width\": 32,\n+          \"url\": \"https://media.sketchfab.com/avatars/0b3eacb72e2041f78fe1f2caddb464a2/1f9bb8571b45449b945d4bd8cb918224.jpeg\",\n+          \"height\": 32\n+        },\n+        {\n+          \"size\": 1371,\n+          \"width\": 48,\n+          \"url\": \"https://media.sketchfab.com/avatars/0b3eacb72e2041f78fe1f2caddb464a2/7a8150832a4b42aa8edc2e00484aa05a.jpeg\",\n+          \"height\": 48\n+        },\n+        {\n+          \"size\": 3389,\n+          \"width\": 90,\n+          \"url\": \"https://media.sketchfab.com/avatars/0b3eacb72e2041f78fe1f2caddb464a2/a911decbbdda4f2d819513d5004c8624.jpeg\",\n+          \"height\": 90\n+        },\n+        {\n+          \"size\": 4104,\n+          \"width\": 100,\n+          \"url\": \"https://media.sketchfab.com/avatars/0b3eacb72e2041f78fe1f2caddb464a2/70257031fc7a47dc8998e0e70e3bb92e.jpeg\",\n+          \"height\": 100\n+        }\n+      ]\n+    },\n+    \"uri\": \"https://api.sketchfab.com/v3/users/2f6f641327e9468bb5cb1eac678deea2\"\n+  },\n+  \"description\": \"\",\n+  \"faceCount\": 14986,\n+  \"createdAt\": \"2021-03-29T11:43:52.159036\",\n+  \"vertexCount\": 7524,\n+  \"isAgeRestricted\": false,\n+  \"archives\": {\n+    \"glb\": {\n+      \"textureCount\": 6,\n+      \"size\": 8300656,\n+      \"type\": \"glb\",\n+      \"textureMaxResolution\": 2048,\n+      \"faceCount\": 14986,\n+      \"vertexCount\": 11556\n+    },\n+    \"gltf\": {\n+      \"textureCount\": 6,\n+      \"size\": 7731404,\n+      \"type\": \"gltf\",\n+      \"textureMaxResolution\": 2048,\n+      \"faceCount\": 14986,\n+      \"vertexCount\": 11556\n+    },\n+    \"source\": {\n+      \"textureCount\": null,\n+      \"size\": 4803245,\n+      \"type\": \"source\",\n+      \"textureMaxResolution\": null,\n+      \"faceCount\": null,\n+      \"vertexCount\": null\n+    },\n+    \"usdz\": {\n+      \"textureCount\": null,\n+      \"size\": 5540734,\n+      \"type\": \"usdz\",\n+      \"textureMaxResolution\": null,\n+      \"faceCount\": null,\n+      \"vertexCount\": null\n+    }\n+  },\n+  \"license\": \"by\"\n+}"},{"sha":"76120cf8e5293543272ad220b261a328467b95bd","filename":"chicago/4d/changelog.d/T-2800.json","status":"added","additions":7,"deletions":0,"changes":7,"blob_url":"https://github.com/kevinrhaas/chicago/blob/fa115d72534e234fe5ac7b94fd2f1a3eb38065c8/chicago%2F4d%2Fchangelog.d%2FT-2800.json","raw_url":"https://github.com/kevinrhaas/chicago/raw/fa115d72534e234fe5ac7b94fd2f1a3eb38065c8/chicago%2F4d%2Fchangelog.d%2FT-2800.json","contents_url":"https://api.github.com/repos/kevinrhaas/chicago/contents/chicago%2F4d%2Fchangelog.d%2FT-2800.json?ref=fa115d72534e234fe5ac7b94fd2f1a3eb38065c8","patch":"@@ -0,0 +1,7 @@\n+{\n+  \"title\": \"A horse shifts its weight in the wagon yard\",\n+  \"kind\": \"feature\",\n+  \"items\": [\n+    \"A reconstructed horse in the 1835 Western Hotel wagon yard shifts gently while standing. It remains unhitched and unmounted.\"\n+  ]\n+}"},{"sha":"e46a6744f1e42df5c64fd5764c95d8150fc64168","filename":"chicago/4d/data/liberties.json","status":"modified","additions":38,"deletions":1,"changes":39,"blob_url":"https://github.com/kevinrhaas/chicago/blob/fa115d72534e234fe5ac7b94fd2f1a3eb38065c8/chicago%2F4d%2Fdata%2Fliberties.json","raw_url":"https://github.com/kevinrhaas/chicago/raw/fa115d72534e234fe5ac7b94fd2f1a3eb38065c8/chicago%2F4d%2Fdata%2Fliberties.json","contents_url":"https://api.github.com/repos/kevinrhaas/chicago/contents/chicago%2F4d%2Fdata%2Fliberties.json?ref=fa115d72534e234fe5ac7b94fd2f1a3eb38065c8","patch":"@@ -3,7 +3,7 @@\n   \"source\": \"docs/LIBERTIES.md\",\n   \"standard\": \"A visitor should be able to tell you which parts we made up.\",\n   \"note\": \"The confidence model covers attributes. These are the decisions that live above any single attribute: scope, omission, simplification, and the choices a visitor would otherwise have to reverse-engineer.\",\n-  \"count\": 703,\n+  \"count\": 704,\n   \"names\": [\n     {\n       \"id\": \"agency_striker_log_house\",\n@@ -51377,6 +51377,43 @@\n         \"T-3048\"\n       ]\n     },\n+    {\n+      \"id\": \"L-standing-horse-development-2800\",\n+      \"title\": \"a planted-standing horse in the Western Hotel yard\",\n+      \"section\": \"per_subject\",\n+      \"subjects\": [\n+        \"western_hotel\"\n+      ],\n+      \"covers\": [],\n+      \"recorded\": \"2026-10-23\",\n+      \"revised\": null,\n+      \"fields\": [\n+        {\n+          \"label\": \"Decision\",\n+          \"text\": \"Add one reconstructed, unidentified horse at E−127.5,N−296.0,heading90degrees in the1835Western Hotel wagon yard, using the existing host/yard record as context rather than evidence of an individual or ownership. The chestnut coat/blaze/stockings, grooming,1.55m withers proxy, exact stand and date are reconstructed. It is unhitched, untied and unmounted.\"\n+        },\n+        {\n+          \"label\": \"What is reconstructed\",\n+          \"text\": \"Licensed modern sevketkabatas Horse rest surface baked to canonical metres and adapted to project26 controls/V16skin; the already baked0.3644068837native scale is NOT applied again. The selected b479 derivative plays one12s planted body shift (4mm lateral,2mm longitudinal,4mm compression) with no original head/tail composition or walking. Existing0.396145degree whole-root support and cloned-material metalness0 are declared adaptations. Rig hierarchy analogy credits antemeossa CC BY4.0; no donor mesh/Walk keys were copied. Modern credit is not an historically graded animal attribute.\"\n+        },\n+        {\n+          \"label\": \"Bounds and limits\",\n+          \"text\": \"Original stationary65 CPU and actual standardGLTFLoader/Mixer65keys+64midpoints passed unchanged surface/contact/loop/normal/meaningful controls, maximum loaded hoof contact8.6523737e−6m. This is not GPU/photo or actual-yard acceptance. One declared0.866317m² support region retains actual drawn yard triangles before normal GPU upload release, under32triangles/4096typed-array bytes and with disposal; no town-wide geometry retention is added. One-instance/reach70/40/0m and full-only30m shadow limits remain. Actual app yard/mobile visual, performance, photographic master, gaits, tack/teams/riders/boarding remain open. Earlier failed walking fields/poses remain failed.\"\n+        },\n+        {\n+          \"label\": \"Sources\",\n+          \"text\": \"sevketkabatas, “Horse”, published 29 March 2021, CC BY 4.0, retrieved via… supplies modern source/rights only; \\\"Town of Chicago.\\\" Chicagology. Transcribing the Inter Ocean of 22 July 1883… supplies historical horsekeeping context only.\"\n+        },\n+        {\n+          \"label\": \"Recorded\",\n+          \"text\": \"2026-10-23.\"\n+        }\n+      ],\n+      \"work_refs\": [\n+        \"T-2800\",\n+        \"T-2803\"\n+      ]\n+    },\n     {\n       \"id\": \"L-glessner-course-relief-3046\",\n       \"title\": \"Glessner's high courses crowned deeper than its low ones, fitted to Taylor 2135's shadows\","},{"sha":"28a9daade7ef63ac05019f7754c84ebabe50d506","filename":"chicago/4d/data/scene.schema.json","status":"modified","additions":66,"deletions":2,"changes":68,"blob_url":"https://github.com/kevinrhaas/chicago/blob/fa115d72534e234fe5ac7b94fd2f1a3eb38065c8/chicago%2F4d%2Fdata%2Fscene.schema.json","raw_url":"https://github.com/kevinrhaas/chicago/raw/fa115d72534e234fe5ac7b94fd2f1a3eb38065c8/chicago%2F4d%2Fdata%2Fscene.schema.json","contents_url":"https://api.github.com/repos/kevinrhaas/chicago/contents/chicago%2F4d%2Fdata%2Fscene.schema.json?ref=fa115d72534e234fe5ac7b94fd2f1a3eb38065c8","patch":"@@ -136,11 +136,12 @@\n           \"street_trees\",\n           \"context\",\n           \"railway\",\n-          \"humans\"\n+          \"humans\",\n+          \"standing_horses\"\n         ]\n       },\n       \"minItems\": 1,\n-      \"description\": \"What the renderer mounts for this scene (T-1739), and nothing it does not list. `terrain` and `water` are the epoch's own ground and water. `structures` is the structure records that resolve at target_date. The rest are the town's derived and authored layers, every one of them written for 1 July 1835 in a directory that carries no date: `flora` (the sward, the timber and the ground's substrate colours), `fauna`, `streets`, `enclosures` (with the ground inside them), `signage`, `yard_goods`, `frontage`, `wharves`, `boats`, `wells`, `residents` (the people directory), `businesses` (the firms register) and `exclusions` (the research record of buildings left out, and the watch list); tools/compile_scene.py compiles the people directory and the exclusions record only for a scene that lists them. The drawer follows the same list (T-1740): `residents` offers the People section and the City, Population and Order book topics, `businesses` the Firms section, `fauna` the wildlife topic, `flora` the plants topic and `exclusions` the not-here and open-questions topics, and a scene that does not list one offers none of what it carries. `street_grid` is a dated layer, data/street_grid/<scene>.json (T-0474, the 1904 Prairie Avenue carriageways, block faces, alleys and parcels). `context` is the faded context city (T-2477): data/context/<scene>.json, generated by tools/build_context_1904.py, simple stand-ins read off the Sanborn sheets and projected past them on every part of the map not yet built. `street_trees` is data/street_trees/<scene>.json (T-2473, the parkway elms planted on that grid's parkway bands). `railway` is a dated layer, data/railway/<scene>.json (T-2478, the 1904 Illinois Central tracks along the lake, their ballast, ties and verges). `humans` is the human figures (T-1788): data/humans/instances/<scene>/index.json and the instance records it names, each bound to a person in that scene's people directory and drawn only as data/humans/contract.json § l1 allows — while L1 is in force, nobody. A scene of another date lists only what is true of it.\"\n+      \"description\": \"What the renderer mounts for this scene (T-1739), and nothing it does not list. `terrain` and `water` are the epoch's own ground and water. `structures` is the structure records that resolve at target_date. The rest are the town's derived and authored layers, every one of them written for 1 July 1835 in a directory that carries no date: `flora` (the sward, the timber and the ground's substrate colours), `fauna`, `streets`, `enclosures` (with the ground inside them), `signage`, `yard_goods`, `frontage`, `wharves`, `boats`, `wells`, `residents` (the people directory), `businesses` (the firms register) and `exclusions` (the research record of buildings left out, and the watch list); tools/compile_scene.py compiles the people directory and the exclusions record only for a scene that lists them. The drawer follows the same list (T-1740): `residents` offers the People section and the City, Population and Order book topics, `businesses` the Firms section, `fauna` the wildlife topic, `flora` the plants topic and `exclusions` the not-here and open-questions topics, and a scene that does not list one offers none of what it carries. `street_grid` is a dated layer, data/street_grid/<scene>.json (T-0474, the 1904 Prairie Avenue carriageways, block faces, alleys and parcels). `context` is the faded context city (T-2477): data/context/<scene>.json, generated by tools/build_context_1904.py, simple stand-ins read off the Sanborn sheets and projected past them on every part of the map not yet built. `street_trees` is data/street_trees/<scene>.json (T-2473, the parkway elms planted on that grid's parkway bands). `railway` is a dated layer, data/railway/<scene>.json (T-2478, the 1904 Illinois Central tracks along the lake, their ballast, ties and verges). `humans` is the human figures (T-1788): data/humans/instances/<scene>/index.json and the instance records it names, each bound to a person in that scene's people directory and drawn only as data/humans/contract.json \\u00a7 l1 allows \\u2014 while L1 is in force, nobody. A scene of another date lists only what is true of it. `standing_horses` is a scene-scoped reconstructed development animal layer from data/transport/parked/standing-horses.json; one licensed canonical26 planted-standing clip, no walking, hitching or riding qualification.\"\n     },\n     \"released\": {\n       \"type\": \"boolean\",\n@@ -243,6 +244,69 @@\n           }\n         }\n       }\n+    },\n+    \"static_support_regions\": {\n+      \"type\": \"array\",\n+      \"maxItems\": 1,\n+      \"description\": \"Optional small scene-authored static support rectangle for an explicitly drawn standing-horse layer. yards.js snapshots only the actual yard base triangles overlapping this region BEFORE normal coarse upload release; the original town CPU geometry still releases. Current renderer independently caps one region,4square metres,32triangles and4096typed-array bytes, with owned disposal; a missing/oversized support cache refuses the horse. Not a collision surface or historical surveying claim.\",\n+      \"items\": {\n+        \"type\": \"object\",\n+        \"required\": [\n+          \"id\",\n+          \"record_id\",\n+          \"bounds_enu_m\",\n+          \"basis\",\n+          \"maximum_region_count\",\n+          \"maximum_region_area_m2\",\n+          \"maximum_retained_triangles\",\n+          \"maximum_retained_typed_array_bytes\",\n+          \"lifetime\"\n+        ],\n+        \"additionalProperties\": false,\n+        \"properties\": {\n+          \"id\": {\n+            \"type\": \"string\",\n+            \"pattern\": \"^[a-z0-9_]+$\"\n+          },\n+          \"record_id\": {\n+            \"type\": \"string\",\n+            \"pattern\": \"^[a-z0-9_]+$\"\n+          },\n+          \"bounds_enu_m\": {\n+            \"type\": \"array\",\n+            \"minItems\": 2,\n+            \"maxItems\": 2,\n+            \"items\": {\n+              \"type\": \"array\",\n+              \"minItems\": 2,\n+              \"maxItems\": 2,\n+              \"items\": {\n+                \"type\": \"number\"\n+              }\n+            }\n+          },\n+          \"basis\": {\n+            \"type\": \"string\",\n+            \"minLength\": 1\n+          },\n+          \"maximum_region_count\": {\n+            \"const\": 1\n+          },\n+          \"maximum_region_area_m2\": {\n+            \"const\": 4\n+          },\n+          \"maximum_retained_triangles\": {\n+            \"const\": 32\n+          },\n+          \"maximum_retained_typed_array_bytes\": {\n+            \"const\": 4096\n+          },\n+          \"lifetime\": {\n+            \"type\": \"string\",\n+            \"minLength\": 1\n+          }\n+        }\n+      }\n     }\n   }\n }"},{"sha":"c0df0cd4478c3a43bd0d06e73140b2457e18ce89","filename":"chicago/4d/data/scenes/1835.json","status":"modified","additions":25,"deletions":2,"changes":27,"blob_url":"https://github.com/kevinrhaas/chicago/blob/fa115d72534e234fe5ac7b94fd2f1a3eb38065c8/chicago%2F4d%2Fdata%2Fscenes%2F1835.json","raw_url":"https://github.com/kevinrhaas/chicago/raw/fa115d72534e234fe5ac7b94fd2f1a3eb38065c8/chicago%2F4d%2Fdata%2Fscenes%2F1835.json","contents_url":"https://api.github.com/repos/kevinrhaas/chicago/contents/chicago%2F4d%2Fdata%2Fscenes%2F1835.json?ref=fa115d72534e234fe5ac7b94fd2f1a3eb38065c8","patch":"@@ -161,8 +161,31 @@\n     \"businesses\",\n     \"exclusions\",\n     \"parked_transport\",\n-    \"humans\"\n+    \"humans\",\n+    \"standing_horses\"\n   ],\n   \"released\": false,\n-  \"note\": \"The first scene. Population roughly 3,265 in the late-1835 count; the town is twenty months old and has grown roughly tenfold in two years. Wabansia and Kinzie's Addition are platted (the Wooley correction was approved 17 June 1835, two weeks before this date) but almost entirely unbuilt. Anchor coordinates are provisional until the datum is verified \\u2014 they are placeholders in the same local frame, not survey positions. Spawn and the near anchors are now derived from the Sauganash's real placement at Lake and Market \\u2014 about 100 m east and 130 m south of the forks confluence \\u2014 rather than from the datum origin, which is in the middle of the river. Both anchors that once pointed at a surveyed corner because their records had not landed have now resolved onto it: Green Tree stands at Lake and Canal looking east at the tavern, and South Water stands in the street at Wells. The South Water anchor was moved there on 2026-08-15 from (260, -95), which was 101 m south of the centreline of the street it is named for and framed a field. Its easting is the Wells corner the South Water records are themselves offset from (OpenStreetMap E 447402.5, N 4637411.6, the West Upper Wacker Drive / North Wells junction, quoted in those records' position notes); its northing is the committed South Water centreline at that easting (data/streets/1835.json), which sits about 9 m south of the modern junction centre because the 1835 line is shifted into the dry half of the platted riverfront corridor. A camera is not a placement, and this one claims nothing about a building. The forks anchor moved from (-20, -30) to (-100, -28) once the river channel was traced: the placeholder stood in the middle of the South Branch. It is now on the west bank at Wolf Point, which is what the name meant, looking east across the confluence and down the main stem. The wharf anchor (2026-08-18, T-0041) stands on the bank 3.6 m out of Newberry & Dole's river wall, looking down the waterward normal of the dock the wharf layer draws there \\u2014 the ground at that point is 0.38 m above the water plane, so it is a stand on the bank and not on the deck, which is not a walk surface. THE SOUTHERN ANCHORS (T-0467, 2026-09-17), and every one of them is a CAMERA and not a placement. T-0464 carried the modelled box south to Twenty-Second Street (n_min -3800) and nothing was reachable down there: the southernmost viewpoint this scene offered was the aerial at n -330, so 3.4 km of modelled ground had no way in except by walking off the edge of the town. Six anchors were added. `fort_dearborn` stands outside the stockade to the south-west at (1100, 175), looking north-east across it \\u2014 the palisade record places the fort square between e 1122 and 1182 and n 191 and 251, so the camera is 22 m clear of its south-west angle and inside no footprint. `lake_shore_south` stands at (1340, -1000) on the sand-ridge belt three-quarters of a mile below the fort, looking south down the shore; the pre-fill lake margin at that row runs about 47 m east of it, which is why the easting is not simply carried down from the fort \\u2014 the traced shore crosses 390 m of easting between Twelfth Street and the box floor, so a fixed easting that is dry at one row is in the lake at another. `sixteenth_prairie` (1396.51, -2949.59), `eighteenth_prairie` (1401.86, -3206.93) and `cermak_prairie` (1407.06, -3764.87) are the three junctions the ticket named, resolved from OpenStreetMap under the same node rule the street control uses and recorded with their node ids in data/traces/south_anchor_control.json. `battle_reach_1812` (1460, -3050) stands on the shore between the first two, looking north back up the beach toward the fort. IT DOES NOT LOCATE THE BATTLE, and its label says so: it names the ZONE T-0470 mapped (data/terrain/1812_evacuation_route.geojson, derived by tools/derive_evacuation_1812.py), which runs from the north end of Heald's 'about a mile and a half' band to Eighteenth Street's south line because the distance and the Eighteenth Street tradition disagree by about a kilometre and the zone spans both rather than choosing. The anchor stands inside that zone near its south end, 157 m north of Eighteenth Street's row, and claims no point in it. Until T-0470 it was labelled 'not yet located', because an anchor that named a spot before the zone was mapped would have been this scene inventing the very thing that ticket existed to adjudicate. WHAT THE LABELS MAY SAY. An anchor name describes what the SELECTED YEAR contains, so two of these carry `conjectural ground` and one carries `the model's south wall`: below Twelfth Street nothing in this corpus states the land at all \\u2014 the terrain spec's `evidence_limit` writes every vertex down there conjectural \\u2014 and a viewpoint that said otherwise would be a claim the ground cannot carry. The modern street names are LOCATORS and are marked as such by being modern; they assert no 1835 street, and the structure layer is offset from none of them. Anchors live in the scene file, one per year, so a later epoch gets its own list rather than inheriting these \\u2014 which is the mechanism that keeps an 1880s mansion out of an 1812 label. tools/measure_anchors.mjs holds all seventeen against the heightfield every anchor is meant to stand on, and tools/check.sh runs it.\"\n+  \"note\": \"The first scene. Population roughly 3,265 in the late-1835 count; the town is twenty months old and has grown roughly tenfold in two years. Wabansia and Kinzie's Addition are platted (the Wooley correction was approved 17 June 1835, two weeks before this date) but almost entirely unbuilt. Anchor coordinates are provisional until the datum is verified \\u2014 they are placeholders in the same local frame, not survey positions. Spawn and the near anchors are now derived from the Sauganash's real placement at Lake and Market \\u2014 about 100 m east and 130 m south of the forks confluence \\u2014 rather than from the datum origin, which is in the middle of the river. Both anchors that once pointed at a surveyed corner because their records had not landed have now resolved onto it: Green Tree stands at Lake and Canal looking east at the tavern, and South Water stands in the street at Wells. The South Water anchor was moved there on 2026-08-15 from (260, -95), which was 101 m south of the centreline of the street it is named for and framed a field. Its easting is the Wells corner the South Water records are themselves offset from (OpenStreetMap E 447402.5, N 4637411.6, the West Upper Wacker Drive / North Wells junction, quoted in those records' position notes); its northing is the committed South Wate
index 000000000..441368abc
--- /dev/null
+++ b/chicago/4d/tools/test_guide_about.mjs
@@ -0,0 +1,208 @@
+#!/usr/bin/env node
+// T-2667 (NAV-1002): Guide › About this destination. The old research hub's topics fold into
+// four cards — How we grade, Sources, Liberties, What lived and grew here — and the order book
+// moves behind Researcher mode (owner ruling 2026-10-16). Holds:
+//   - every topic is in exactly one card, the four visitor cards in that order, and the order
+//     book alone in a researcher card;
+//   - each destination (its scene's own layers, read the way main.js reads them) keeps all four
+//     visitor cards, each with a topic, and 1904 carries no researcher card;
+//   - the hub's markup marks the researcher card `data-researcher`, and nothing a visitor reads
+//     outside it carries an id, a path, "tier", "ticket", "order book" or "commit gate";
+//   - the page keeps every topic's container and mount id, the order book's topic is marked
+//     `data-researcher`, its tab is "About" with the head "About this destination", and
+//     css/skins.css hides a marked element until Researcher mode is on;
+//   - Guide's own block lists the four cards and a fifth only Researcher mode shows, and a tap
+//     asks the page to open that card;
+//   - the source list names a kind of source, never a tier number.
+// The smoke (part 12) opens it in the page, in 1835; part 14 reads the 1904 hub's cards.
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..');
+const read = (p) => fs.readFileSync(path.join(ROOT, p), 'utf8');
+const WEB = 'renderers/web';
+
+// ---- a small DOM, enough for the Guide screen -------------------------------------------
+function makeDoc() {
+  const text = (data) => ({ nodeType: 3, data, parentNode: null, get textContent() { return this.data; },
+    remove() { const p = this.parentNode; if (p) p.childNodes.splice(p.childNodes.indexOf(this), 1); this.parentNode = null; } });
+  const el = (tag) => {
+    const fns = {};
+    const e = {
+      nodeType: 1, tagName: tag.toUpperCase(), childNodes: [], parentNode: null, attrs: {}, dataset: {}, className: '', id: '', type: '',
+      get children() { return this.childNodes.filter((c) => c.nodeType === 1); },
+      get textContent() { return this.childNodes.map((c) => c.textContent).join(''); },
+      set textContent(v) { this.childNodes = []; if (v !== '') this.append(String(v)); },
+      get ownerDocument() { return doc; },
+      setAttribute(k, v) { this.attrs[k] = String(v); }, getAttribute(k) { return this.attrs[k] ?? null; },
+      hasAttribute(k) { return k in this.attrs; },
+      removeAttribute(k) { delete this.attrs[k]; },
+      append(...cs) { for (const c of cs) { const n = typeof c === 'string' ? text(c) : c; n.remove?.(); n.parentNode = e; e.childNodes.push(n); } },
+      replaceChildren(...cs) { for (const c of e.childNodes) c.parentNode = null; e.childNodes = []; e.append(...cs); },
+      remove() { const p = this.parentNode; if (p) p.childNodes.splice(p.childNodes.indexOf(this), 1); this.parentNode = null; },
+      addEventListener(t, f) { (fns[t] ??= []).push(f); },
+      click() { for (const f of fns.click ?? []) f({ preventDefault() {}, stopPropagation() {} }); },
+    };
+    e.classList = {
+      add(c) { const s = new Set(e.className.split(' ').filter(Boolean)); s.add(c); e.className = [...s].join(' '); },
+      remove(c) { e.className = e.className.split(' ').filter((x) => x && x !== c).join(' '); },
+      contains: (c) => e.className.split(' ').includes(c),
+      toggle(c, on) { if (on) this.add(c); else this.remove(c); },
+    };
+    return e;
+  };
+  const doc = { createElement: el, defaultView: { addEventListener() {}, removeEventListener() {}, print() {} } };
+  doc.documentElement = el('html');
+  doc.body = el('body');
+  doc.documentElement.append(doc.body);
+  doc.getElementById = (id) => all(doc.documentElement).find((n) => n.id === id) ?? null;
+  return doc;
+}
+const all = (root, out = []) => { for (const c of root?.children ?? []) { out.push(c); all(c, out); } return out; };
+const byClass = (root, cls) => all(root).filter((e) => e.className.split(' ').includes(cls));
+
+globalThis.document = makeDoc();
+const doc = globalThis.document;
+const { CARDS, TOPIC_IDS, VISITOR_CARDS, hubPlan, hubHtml, topicSpec, cardOf, researcherOn } = await import(`../${WEB}/js/evidence.js`);
+const { mount, unmount } = await import(`../${WEB}/js/apps/guide-view.js`);
+const { t, isResearcherKey, entries } = await import(`../${WEB}/js/strings/index.js`);
+
+// The words a visitor must never read in this section (design doc section 12; the
+// visitor-UI lint's words, and the MED finding's "commit gate").
+const INTERNAL = /\btiers?\b|\btickets?\b|\border[\s-]+books?\b|\bcommit[\s-]+gate\b|\bT-\d{3,4}\b|[a-z0-9]+_[a-z0-9]+|\b[\w-]+\/[\w./-]+\.(json|js|py|md)\b/i;
+
+// ---- the four cards ---------------------------------------------------------------------
+assert.deepEqual(VISITOR_CARDS, ['grading', 'sources', 'liberties', 'living'], 'the four cards, in the design doc\'s order');
+assert.deepEqual(VISITOR_CARDS.map((id) => t(`guide-about.card.${id}`)),
+  ['How we grade', 'Sources', 'Liberties', 'What lived and grew here'], 'each card is named as the ticket names it');
+const filed = CARDS.flatMap((c) => c.topics);
+assert.equal(TOPIC_IDS.length, 11, 'the hub has eleven topics');
+assert.deepEqual([...filed].sort(), [...TOPIC_IDS].sort(), 'every topic is filed under a card');
+assert.equal(new Set(filed).size, filed.length, 'and under one card only');
+const research = CARDS.filter((c) => c.researcher);
+assert.equal(research.length, 1);
+assert.deepEqual(research[0].topics, ['orderbook'], 'the order book, and nothing else, is behind Researcher mode');
+assert.equal(cardOf('orderbook'), 'research');
+// The design doc's own list for this section: city numbers, fauna, plants, exclusions and
+// open questions move under About this destination — onto visitor cards, not the researcher's.
+for (const id of ['city', 'fauna', 'plants', 'exclusions', 'uncertain']) {
+  assert(VISITOR_CARDS.includes(cardOf(id)), `${id} is on a visitor card`);
+}
+
+// ---- each destination keeps all four ------------------------------------------------------
+// The omitted topics, as main.js computes them: a topic is offered only by a scene that
+// lists the layer it reads (DRAWER_TOPICS, T-1740), read from main.js rather than copied.
+const main = read(`${WEB}/js/main.js`);
+const literal = /const DRAWER_TOPICS = \{([^}]*)\}/.exec(main);
+assert(literal, 'main.js carries DRAWER_TOPICS');
+const drawerTopics = Object.fromEntries([...literal[1].matchAll(/(\w+):\s*'(\w+)'/g)].map((m) => [m[1], m[2]]));
+assert(Object.keys(drawerTopics).length >= 7 && drawerTopics.orderbook, 'DRAWER_TOPICS read');
+const omitFor = (year) => {
+  const scene = JSON.parse(read(`data/scenes/${year}.json`));
+  const layers = new Set(scene.layers ?? []);
+  return Object.keys(drawerTopics).filter((id) => !layers.has(drawerTopics[id]));
+};
+for (const year of ['1835', '1904', '1812']) {
+  const omit = omitFor(year);
+  const plan = hubPlan(omit);
+  const visitor = plan.filter((c) => !c.researcher);
+  assert.deepEqual(visitor.map((c) => c.id), VISITOR_CARDS, `${year}: all four cards`);
+  for (const c of visitor) {
+    assert(c.topics.length > 0, `${year}: ${c.id} holds a topic`);
+    assert(c.topics.every((id) => !omit.includes(id)), `${year}: ${c.id} holds no topic the scene omits`);
+  }
+  assert.equal(plan.some((c) => c.researcher), !omit.includes('orderbook'), `${year}: a researcher card only where the order book is`);
+}
+assert.deepEqual(omitFor('1835'), [], '1835 carries every topic');
+assert(!hubPlan(omitFor('1904')).some((c) => c.researcher), '1904 has no order book');
+assert.deepEqual(hubPlan(omitFor('1904')).find((c) => c.id === 'living').topics, ['ground'], '1904: the ground is what lived and grew here');
+
+// ---- the hub's markup -------------------------------------------------------------------------
+const topics = new Map(TOPIC_IDS.map((id) => [id, { ...topicSpec(id), title: id }]));
+const html = hubHtml(hubPlan([]), topics);
+const sections = [...html.matchAll(/<section class="ev-card" data-card="(\w+)"( data-researcher)?/g)].map((m) => [m[1], !!m[2]]);
+assert.deepEqual(sections, [['grading', false], ['sources', false], ['liberties', false], ['living', false], ['research', true]],
+  'four visitor cards, then the researcher card, marked');
+assert.deepEqual([...html.matchAll(/class="ev-tile" type="button" data-topic="(\w+)"/g)].map((m) => m[1]),
+  ['grades', 'city', 'sources', 'liberties', 'exclusions', 'uncertain', 'ground', 'fauna', 'plants', 'population', 'orderbook'],
+  'one tile per topic, inside its card, How we grade first');
+const visitorHtml = html.split('<section class="ev-card" data-card="research"')[0];
+const visible = visitorHtml.replace(/<svg[\s\S]*?<\/svg>/g, '').replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ');
+assert(!INTERNAL.test(visible.replace(/\b(grades|city|sources|liberties|exclusions|uncertain|ground|fauna|plants|population)\b/g, '')),
+  `no internal word outside the researcher card: ${visible.match(INTERNAL)?.[0]}`);
+assert.match(visitorHtml, /class="ev-card-hint">One building&#39;s own sources are on its Sources tab in Inspect\./, 'Sources points to Inspect');
+assert.match(visitorHtml, /class="ev-card-hint">One building&#39;s own Liberties are on its Sources tab in Inspect\./, 'Liberties points to Inspect');
+assert.match(html, /data-researcher[^>]*>[\s\S]*Reconstructing the town/, 'the researcher card is the order book\'s');
+
+// ---- the string table: visitor strings carry no internal word ---------------------------------
+for (const [key, value] of entries().filter(([k]) => k.startsWith('guide-about.'))) {
+  if (isResearcherKey(key)) continue;
+  assert(!INTERNAL.test(value), `${key} carries an internal word: ${value}`);
+}
+assert(isResearcherKey('guide-about.researcher.card') && isResearcherKey('guide-about.researcher.topic.orderbook'),
+  'the order book\'s words are researcher keys');
+assert.match(t('guide-about.researcher.card.line'), /order book/, 'and they may say "order book"');
+
+// ---- the page ------------------------------------------------------------------------------------
+const page = read(`${WEB}/index.html`);
+for (const id of TOPIC_IDS) assert.match(page, new RegExp(`<div class="ev-topic" data-topic="${id}"`), `${id} keeps its container`);
+for (const id of ['evidence-hub', 'city', 'sources', 'liberties', 'liberties-note', 'ground', 'fauna', 'fauna-note', 'plants', 'plants-note',
+  'exclusions', 'exclusions-note', 'uncertain', 'uncertain-note', 'population', 'population-note', 'order-book', 'order-book-note']) {
+  assert.match(page, new RegExp(`id="${id}"`), `#${id} is kept`);
+}
+assert.match(page, /<div class="ev-topic" data-topic="orderbook" data-researcher>/, 'the order book\'s topic is marked for Researcher mode');
+const tab = /<button class="panel-tab" data-tab="evidence"[^>]*>[\s\S]*?<\/button>/.exec(page)?.[0] ?? '';
+assert.match(tab, /data-title="About this destination"/, 'the section\'s head is About this destination');
+assert.match(tab, /<span class="tab-label" data-str="guide-about.tab">About<\/span>/, 'its tab says About');
+assert.equal(t('guide-about.tab.title'), 'About this destination');
+const evidence = page.slice(page.indexOf('<section class="panel-body" data-panel="evidence"'), page.indexOf('<section class="panel-body" data-panel="settings"'));
+const shown = evidence.replace(/<!--[\s\S]*?-->/g, '').split('data-topic="orderbook" data-researcher')[0].replace(/<[^>]+>/g, ' ');
+assert(!/\bcommit[\s-]+gate\b|\border[\s-]+books?\b|\btickets?\b|\btiers?\b/i.test(shown),
+  `the section's own words, outside the order book, name no internal process: ${shown.match(/\bcommit[\s-]+gate\b|\border[\s-]+books?\b|\btickets?\b|\btiers?\b/i)?.[0]}`);
+for (const term of ['Attested', 'Inferred', 'Reconstructed']) assert.match(evidence, new RegExp(`<b>${term}</b> —`), `How we grade spells ${term} as locked`);
+assert.match(read(`${WEB}/css/skins.css`), /html:not\(\[data-researcher-mode\]\)\s*\[data-researcher\]\s*\{\s*display:\s*none/,
+  'a marked element is hidden until Researcher mode is on');
+assert.match(read(`${WEB}/js/census.js`), /<div data-researcher><dt>Derived by<\/dt>/, 'the City\'s tool path is for researchers');
+
+// ---- Researcher mode is read off the root ---------------------------------------------------------
+assert.equal(researcherOn(doc), false);
+doc.documentElement.setAttribute('data-researcher-mode', '');
+assert.equal(researcherOn(doc), true);
+doc.documentElement.removeAttribute('data-researcher-mode');
+
+// ---- Guide's own block -----------------------------------------------------------------------------
+const asked = [];
+const el = doc.createElement('div');
+doc.body.append(el);
+mount(el, { controls: 'keyboard', coarse: false, scene: '1835',
+  actions: { aboutCard: (id) => { asked.push(id); return true; }, guideFaq: () => ({ questions: [] }), jauntCatalog: () => [] } });
+const block = doc.getElementById('guide-about');
+assert(block, 'Guide shows About this destination');
+assert.equal(byClass(block, 'nav-k')[0]?.textContent, 'About this destination');
+const order = byClass(el, 'nav-block').map((b) => b.id);
+assert(order.indexOf('guide-faq') < order.indexOf('guide-about') && order.indexOf('guide-about') < order.indexOf('guide-teachers'),
+  `after the questions, before For teachers: ${order.join(', ')}`);
+const buttons = byClass(block, 'nav-about-card');
+assert.deepEqual(buttons.map((b) => b.dataset.card), [...VISITOR_CARDS, 'research']);
+assert.deepEqual(buttons.filter((b) => b.hasAttribute('data-researcher')).map((b) => b.dataset.card), ['research'],
+  'only the order book\'s button waits for Researcher mode');
+assert.deepEqual(buttons.slice(0, 4).map((b) => byClass(b, 'nav-about-title')[0]?.textContent),
+  ['How we grade', 'Sources', 'Liberties', 'What lived and grew here']);
+const blockText = buttons.filter((b) => !b.hasAttribute('data-researcher')).map((b) => b.textContent).join(' ')
+  + ' ' + byClass(block, 'nav-place')[0]?.textContent + ' ' + byClass(block, 'nav-sub')[0]?.textContent;
+assert(!INTERNAL.test(blockText), `the block reads no internal word: ${blockText.match(INTERNAL)?.[0]}`);
+for (const b of buttons) b.click();
+assert.deepEqual(asked, [...VISITOR_CARDS, 'research'], 'a tap asks the page to open that card');
+unmount(el);
+
+// ---- the source list says what kind a source is ----------------------------------------------------
+const sources = read(`${WEB}/js/sources.js`);
+assert(!/· tier \$\{/.test(sources) && !/'Source tier'/.test(sources) && !/\[DOC\]|\[CONJ\]/.test(sources),
+  'no tier number, tier filter or old grade alias on the source list');
+const { sourceTag } = await import(`../${WEB}/js/inspect-sources.js`);
+assert.equal(sourceTag(3, '1884', '1835'), 'gathered from witnesses', 'Andreas (1884, tier 3) is gathered from witnesses in 1835');
+
+console.log(`test_guide_about: four cards in ${VISITOR_CARDS.length === 4 ? 'every' : 'some'} destination (1835, 1904, 1812), `
+  + `${TOPIC_IDS.length} topics each filed once, the order book behind Researcher mode, ids kept, Guide's block opens each card`);
diff --git a/chicago/4d/tools/test_license.mjs b/chicago/4d/tools/test_license.mjs
new file mode 100644
index 000000000..41c2792b1
--- /dev/null
+++ b/chicago/4d/tools/test_license.mjs
@@ -0,0 +1,219 @@
+#!/usr/bin/env node
+// T-2665 (NAV-805): the Navigator License. Finishing the Field Check awards it once per
+// device (Skip never does; a replay that finishes again keeps the one license), storage
+// behind try/catch, and it shows with the Jaunt keepsakes in the Jaunts app's daybook after
+// a reload. Drives js/license.js with js/tour.js over a fake storage and clock, and
+// js/jaunt-preview.js's real daybook over a small hand-made DOM with the 1835 daybook.
+// No browser; the smoke (part 13) finishes the Field Check and opens the daybook in a page.
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { createLicense, issuedOn, LICENSE_KEY } from '../renderers/web/js/license.js';
+import { createTour, STEPS, TOUR_KEY } from '../renderers/web/js/tour.js';
+import { t } from '../renderers/web/js/strings/index.js';
+
+const ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..');
+const read = (p) => fs.readFileSync(path.join(ROOT, p), 'utf8');
+const store = () => { const m = new Map(); return { getItem: (k) => m.get(k) ?? null, setItem: (k, v) => m.set(k, String(v)), removeItem: (k) => m.delete(k), m }; };
+const refusing = { getItem() { throw new Error('denied'); }, setItem() { throw new Error('denied'); }, removeItem() { throw new Error('denied'); } };
+const WHEN = new Date('2026-10-18T15:00:00Z');
+
+// ---- the words: the design's name, no ids, short lines ------------------------------------
+assert.equal(t('license.title'), 'Navigator License', 'section 11 names it NAVIGATOR LICENSE');
+for (const k of ['form', 'text', 'issued', 'held', 'awarded', 'reset-confirm', 'no-jaunt-keepsakes']) {
+  const s = t(`license.${k}`);
+  assert.ok(s, `license.${k} is in the string table`);
+  assert.doesNotMatch(s, /\b(tier|ticket)s?\b|[a-z]+_[a-z]+|\/|T-\d+/i, `license.${k} carries no id, path, "tier" or "ticket"`);
+  assert.ok(s.split(/\s+/).length <= 14, `license.${k} reads in 14 words or fewer, like a bubble`);
+}
+assert.equal(issuedOn('2026-10-18T15:00:00Z'), 'Oct 18, 2026');
+assert.equal(issuedOn('not a date'), null);
+assert.equal(issuedOn(null), null);
+
+// ---- finishing the Field Check awards it once; Skip never does ---------------------------
+// Runs the real tour to its end: Next on 01, each waiting step's action, Finish on 07.
+function runTour(tour, probe) {
+  tour.start();
+  assert.equal(tour.press(), true);
+  probe.yawDeg = (probe.yawDeg + 90) % 360; tour.tick();
+  probe.e += 6; tour.tick();
+  probe.opens += 1; tour.tick();
+  probe.deeper += 1; tour.tick();
+  probe.confidence = true; probe.confChanges += 1; tour.tick();
+  assert.equal(tour.step, STEPS.length - 1, 'on step 07');
+}
+{
+  const s = store();
+  const license = createLicense({ storage: s, now: () => WHEN });
+  const awards = [];
+  const probe = { yawDeg: 0, e: 0, n: 0, opens: 0, deeper: 0, confidence: false, confChanges: 0, scene: '1835' };
+  const tour = createTour({ probe: () => probe, storage: s, onFinish: () => awards.push(license.award()) });
+  assert.equal(license.held, false, 'nothing held before the tour');
+  assert.equal(license.card(), null, 'and no card');
+
+  // Skip at 07 is not finishing.
+  runTour(tour, probe);
+  tour.skip();
+  assert.deepEqual(awards, [], 'Skip never awards it');
+  assert.equal(license.held, false);
+  assert.equal(s.m.get(LICENSE_KEY), undefined);
+
+  // A replay finished: awarded, dated, on this device.
+  probe.confidence = false;
+  runTour(tour, probe);
+  assert.equal(tour.press(), true, 'Finish on step 07');
+  assert.deepEqual(awards, [true], 'Finish awards it');
+  assert.equal(license.held, true);
+  assert.deepEqual(JSON.parse(s.m.get(LICENSE_KEY)), { earned: WHEN.toISOString() }, 'kept on this device, with the day it was issued');
+  const card = license.card();
+  assert.deepEqual(card, { form: t('license.form'), title: 'Navigator License', text: t('license.text'), line: 'Issued Oct 18, 2026 · Good in every year' });
+
+  // Again: one license.
+  probe.confidence = false;
+  runTour(tour, probe);
+  tour.press();
+  assert.deepEqual(awards, [true, false], 'a replay that finishes again keeps the one license');
+
+  // A reload: a fresh page reads it back.
+  const reloaded = createLicense({ storage: s, now: () => new Date() });
+  assert.equal(reloaded.held, true, 'held after a reload');
+  assert.equal(reloaded.earned, WHEN.toISOString(), 'with its first issue date');
+  assert.equal(reloaded.award(), false, 'and not awarded twice');
+}
+
+// ---- a device that finished before the license existed holds it, undated -----------------
+{
+  const s = store();
+  s.setItem(TOUR_KEY, JSON.stringify({ active: false, step: null, done: true }));
+  const license = createLicense({ storage: s });
+  assert.equal(license.held, true, 'the tour\'s own record says it was finished');
+  assert.equal(license.card().line, 'Good in every year', 'undated: no day is invented');
+  s.setItem(TOUR_KEY, JSON.stringify({ active: false, step: null, done: false }));
+  assert.equal(createLicense({ storage: s }).held, false, 'a skipped tour holds nothing');
+}
+
+// ---- storage refused: no error, held for this page ---------------------------------------
+{
+  const license = createLicense({ storage: refusing, now: () => WHEN });
+  assert.equal(license.held, false);
+  assert.equal(license.award(), true, 'refused storage still awards it');
+  assert.equal(license.held, true, '…held for this page');
+  assert.equal(license.award(), false, '…once');
+  license.forget();
+  assert.equal(license.held, false, 'the harness can forget it');
+  const none = createLicense({ storage: null });
+  assert.equal(none.award(), true, 'no storage at all: nothing throws');
+  const broken = store(); broken.setItem(LICENSE_KEY, '{not json');
+  assert.equal(createLicense({ storage: broken }).held, false, 'a damaged record reads as none, never an error');
+}
+
+// ---- the daybook in the Jaunts app shows it with the Jaunt keepsakes ---------------------
+function makeDom() {
+  const make = (tag) => {
+    const fns = {};
+    const el = {
+      tagName: tag.toUpperCase(), children: [], parent: null, dataset: {}, attrs: {}, hidden: false, disabled: false,
+      title: '', type: '', tabIndex: 0, _text: '', _cls: new Set(),
+      get className() { return [...this._cls].join(' '); }, set className(v) { this._cls = new Set(String(v).split(/\s+/).filter(Boolean)); },
+      classList: null,
+      get textContent() { return this._text + this.children.map((c) => c.textContent).join(''); },
+      set textContent(v) { this._text = String(v ?? ''); this.children = []; },
+      set innerHTML(v) { this._html = v; },
+      get content() { return { firstChild: make('svg') }; },
+      setAttribute(k, v) { this.attrs[k] = String(v); }, getAttribute(k) { return this.attrs[k] ?? null; }, removeAttribute(k) { delete this.attrs[k]; },
+      append(...cs) { for (const c of cs) { if (c == null) continue; const n = typeof c === 'string' ? Object.assign(make('#text'), { _text: c }) : c; n.parent = el; el.children.push(n); } },
+      prepend(...cs) { const old = el.children; el.children = []; el.append(...cs); el.children.push(...old); },
+      replaceChildren(...cs) { el.children = []; el.append(...cs); },
+      addEventListener(type, fn) { (fns[type] ??= []).push(fn); },
+      click() { for (const fn of fns.click ?? []) fn({ preventDefault() {} }); },
+      closest: () => null, focus() {}, scrollIntoView() {}, matches: () => false,
+      get isConnected() { return true; },
+      querySelectorAll(sel) { return walk(el).filter((c) => matches(c, sel)); },
+      querySelector(sel) { return el.querySelectorAll(sel)[0] ?? null; },
+    };
+    el.classList = { add: (...c) => c.forEach((x) => el._cls.add(x)), remove: (...c) => c.forEach((x) => el._cls.delete(x)),
+      contains: (c) => el._cls.has(c), toggle: (c, on = !el._cls.has(c)) => { if (on) el._cls.add(c); else el._cls.delete(c); return on; } };
+    return el;
+  };
+  const walk = (el, out = []) => { for (const c of el.children) { out.push(c); walk(c, out); } return out; };
+  const matches = (el, sel) => sel.split(',').some((s) => {
+    s = s.trim();
+    let m;
+    if ((m = /^\.([\w-]+)$/.exec(s))) return el._cls?.has(m[1]);
+    if ((m = /^\[data-action="([\w-]+)"\]$/.exec(s))) return el.dataset?.action === m[1];
+    if ((m = /^\[data-keepsake="([\w:-]+)"\]$/.exec(s))) return el.dataset?.keepsake === m[1];
+    if ((m = /^([a-z0-9]+)$/.exec(s))) return el.tagName === m[1].toUpperCase();
+    return false;
+  });
+  return { createElement: make };
+}
+globalThis.document = makeDom();
+const { createJauntPreview } = await import('../renderers/web/js/jaunt-preview.js');
+const book = JSON.parse(read('data/sidecars/1835/jaunts/daybook.json'));
+const fetcher = async (url) => {
+  const name = String(url).split('/').pop();
+  const body = name === 'daybook.json' ? book : name === 'catalog.json' ? { scene: '1835', jaunts: [] } : null;
+  return { ok: !!body, status: body ? 200 : 404, json: async () => body };
+};
+async function daybookOf(license, storage) {
+  const root = document.createElement('div');
+  const preview = createJauntPreview({ root, scene: '1835', dataBase: 'https://example.test/', destinations: { byId: () => null }, api: {},
+    fetcher, storage, license, onStart: () => true });
+  await preview.open();
+  return { root, preview };
+}
+const openBook = (root) => { root.querySelector('[data-action="daybook"]').click(); return root.querySelector('.jaunt-daybook'); };
+{
+  const s = store();
+  const license = createLicense({ storage: s, now: () => WHEN });
+  // Not held: the daybook is as it was.
+  let { root } = await daybookOf(license, s);
+  assert.match(root.querySelector('[data-action="daybook"]').textContent, /· 0 kept$/);
+  let view = openBook(root);
+  assert.equal(view.querySelectorAll('[data-keepsake="navigator-license"]').length, 0, 'no license before the tour is finished');
+  assert.match(view.textContent, /No keepsakes yet\./);
+
+  // Awarded, then a reload: a fresh license and daybook from the same storage.
+  license.award();
+  ({ root } = await daybookOf(createLicense({ storage: s }), s));
+  assert.match(root.querySelector('[data-action="daybook"]').textContent, /· 1 kept$/, 'the daybook chip counts it');
+  view = openBook(root);
+  const [card] = view.querySelectorAll('[data-keepsake="navigator-license"]');
+  assert.ok(card, 'shown in the daybook after a reload');
+  assert.ok(card._cls.has('jaunt-keepsake') && card._cls.has('jaunt-keepsake-license'), 'drawn as a keepsake, in its own style');
+  assert.equal(card.parent._cls.has('jaunt-keepsakes'), true, 'on the keepsakes shelf');
+  assert.match(card.textContent, /Navigator License/);
+  assert.match(card.textContent, /Issued Oct 18, 2026/);
+  assert.match(view.textContent, /No jaunt keepsakes yet\./, 'with no jaunt finished, the shelf says so without denying the license');
+  assert.equal(view.querySelectorAll('[data-action="daybook-reset"]').length, 0, 'nothing to reset: the license is not the daybook\'s');
+
+  // With a Jaunt keepsake beside it: the Jaunt's first, the license after; Reset leaves it.
+  let { root: r2, preview } = await daybookOf(createLicense({ storage: s }), s);
+  const journal = await preview.daybook();
+  const family = book.families[0];
+  journal.award({ id: 'test-jaunt', keepsake: { id: 'k', family: family.name, title: 'A Test Memento', text: 'Kept for the test.' } });
+  await preview.open();
+  assert.match(r2.querySelector('[data-action="daybook"]').textContent, /· 2 kept$/);
+  view = openBook(r2);
+  const shelf = view.querySelector('.jaunt-keepsakes');
+  assert.deepEqual(shelf.children.map((c) => c.dataset.keepsake), ['test-jaunt:k', 'navigator-license'], 'with the Jaunt keepsakes, on one shelf');
+  const reset = view.querySelector('[data-action="daybook-reset"]');
+  reset.click();
+  assert.equal(reset.textContent, t('license.reset-confirm'), 'the confirm says the license stays');
+  reset.click();
+  view = r2.querySelector('.jaunt-daybook');
+  assert.deepEqual(view.querySelector('.jaunt-keepsakes').children.map((c) => c.dataset.keepsake), ['navigator-license'], 'Reset daybook leaves it');
+  assert.equal(createLicense({ storage: s }).held, true);
+}
+
+// ---- the page: Finish awards it and says so once; Jaunts gets it ---------------------------
+const main = read('renderers/web/js/main.js');
+assert(/onFinish: \(\) => awardLicense\(\)/.test(main), 'the tour\'s Finish awards it (Skip calls no onFinish)');
+assert(/if \(!license\.award\(\)\) return false;/.test(main), 'the awarded line shows only when it is newly awarded');
+assert(/el\.textContent = license\.awardedText\(\); el\.dataset\.hint = 'license'; el\.hidden = false;/.test(main), 'on the one-line hint, which takes no pointer events');
+assert(/modeNote: \(jaunt\) => jauntWay\(jaunt\)\.note,\n\s+license,/.test(main), 'the Jaunts app\'s daybook is handed the license');
+assert(/api\.license = license;/.test(main), 'the smoke reaches it');
+assert(/\.jaunt-keepsake-license \{[^}]*currentColor/.test(read('renderers/web/css/jaunt.css')), 'drawn in the skin\'s own ink, so every machine skin and both themes carry it');
+
+console.log('test_license: finishing the Field Check awards the Navigator License once per device, and the Jaunts daybook shows it after a reload');
diff --git a/chicago/4d/tools/test_nav_design.mjs b/chicago/4d/tools/test_nav_design.mjs
new file mode 100644
index 000000000..d55f501ab
--- /dev/null
+++ b/chicago/4d/tools/test_nav_design.mjs
@@ -0,0 +1,183 @@
+// T-2641 — Inspect's Design tab (js/inspect-design.js): the style card from the building's style
+// module, the numbered "On this house" hotspots with their grades in place of the attribute table,
+// and Compare styles; a building with no module or record degrades honestly to its own sidecar.
+//
+//   node tools/test_nav_design.mjs
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { designModel, renderDesign, hotspots, plateOf, styleFor, labelOf, valueOf } from '../renderers/web/js/inspect-design.js';
+import { t } from '../renderers/web/js/strings/index.js';
+
+const here = path.dirname(fileURLToPath(import.meta.url));
+const data = path.join(here, '../data');
+const read = (p) => JSON.parse(readFileSync(path.join(data, p), 'utf8'));
+let n = 0;
+const ok = (label, fn) => { fn(); n++; console.log(`  ok ${label}`); };
+
+// ---- a small DOM ------------------------------------------------------------------------------
+function fakeDoc() {
+  const doc = {
+    createElement(tag) {
+      const fns = {};
+      const el = {
+        tagName: tag.toUpperCase(), className: '', dataset: {}, attrs: {}, children: [], _text: '',
+        get textContent() { return this._text + this.children.map((c) => c.textContent).join(''); },
+        set textContent(v) { this._text = String(v); this.children = []; },
+        setAttribute(k, v) { this.attrs[k] = String(v); }, getAttribute(k) { return this.attrs[k] ?? null; },
+        append(...cs) { for (const c of cs) { c.parent = el; el.children.push(c); } },
+        addEventListener(type, fn) { (fns[type] ??= []).push(fn); },
+        click() { for (const fn of fns.click ?? []) fn({ preventDefault() {} }); },
+      };
+      return el;
+    },
+  };
+  return doc;
+}
+const all = (el, out = []) => { for (const c of el.children ?? []) { out.push(c); all(c, out); } return out; };
+const cls = (el, c) => all(el).filter((e) => String(e.className).split(' ').includes(c));
+const dots = [];
+const dot = (d, grade) => { const i = d.createElement('i'); i.className = `fact-dot fact-${grade}`; dots.push(grade); return i; };
+
+const sum = read('summaries/glessner_house.json');
+const sidecar = read('sidecars/1904/glessner_house.json');
+const module = read(`styles/${sum.style}.json`);
+const styles = { [module.id]: module };
+// The scene's pictures file is compiled at publish (never committed), so the plate is read from
+// a stand-in holding exactly the module's picture, public domain, with a held copy.
+const pictures = {
+  image_store: { base_url: 'https://images.example/prairie/' },
+  by_structure: { [module.plate.structure]: [{ id: module.plate.picture, rights: 'public domain', creator: 'Inland Architect Press',
+    years: [1888, 1888], held: { f: 'plate.jpg' } }] },
+};
+const S1904 = { id: '1904' };
+
+ok('labels and values read as words, with their units', () => {
+  assert.equal(labelOf('roof_pitch_deg'), 'Roof pitch');
+  assert.equal(labelOf('wall_height_m'), 'Wall height');
+  assert.equal(labelOf('construction'), 'Built of');
+  assert.equal(labelOf('chimneys'), 'Chimneys');
+  assert.equal(valueOf('roof_pitch_deg', 35), '35°');
+  assert.equal(valueOf('wall_height_m', 2.5), '2.5 m');
+  assert.equal(valueOf('roof_type', 'terracotta_tile'), 'terracotta tile');
+  assert.equal(valueOf('bay_dining', { outline: [[1, 2]] }), '', 'a structured value prints nothing');
+});
+
+ok('Glessner House names the Richardsonian Romanesque module, and the card is the module as written', () => {
+  assert.equal(sum.style, 'richardsonian_romanesque');
+  const m = designModel({ sum, sidecar, styles, pictures, scene: S1904 });
+  assert.equal(m.style.name, 'Richardsonian Romanesque');
+  assert.equal(m.style.description.text, module.description.text);
+  assert.ok(m.style.description.grade, 'the description carries its grade');
+  assert.ok(m.style.cues.length >= 1 && m.style.cues.length <= 4, 'one to four cues, never padded');
+  assert.deepEqual(m.style.cues.map((c) => c.text), module.cues.map((c) => c.text));
+  assert.ok(m.style.cues.every((c) => c.grade), 'every cue is graded');
+  assert.ok(m.style.compare.length >= 1 && m.style.compare.length <= 3 && m.style.compare.every((c) => c.grade && c.name && c.text));
+  assert.equal(m.style.plate.src, 'https://images.example/prairie/plate.jpg');
+  assert.equal(m.style.plate.credit, 'Inland Architect Press · 1888', 'the credit is the pictures file\'s own creator and year');
+  assert.equal(m.style.plate.caption, module.plate.caption);
+});
+
+ok('every cue and Compare line rests on sources the module names (the compiler resolves them)', () => {
+  for (const c of [module.description, ...module.cues, ...module.compare, module.plate]) {
+    assert.ok(c.grade === 'attested' ? c.sources?.length > 0 : (c.note ?? '').trim().length > 0, JSON.stringify(c).slice(0, 80));
+    for (const s of c.sources ?? []) assert.ok(readFileSync(path.join(data, 'sources', `${s}.json`), 'utf8').length > 0, s);
+  }
+});

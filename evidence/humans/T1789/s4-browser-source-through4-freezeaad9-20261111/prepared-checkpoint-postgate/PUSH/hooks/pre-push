#!/usr/bin/env python3
"""One reviewed owned-ref fast-forward only. Preserve any existing pre-push hook."""
from pathlib import Path
import json,os,subprocess,sys
raw=sys.stdin.buffer.read(4097);assert len(raw)<=4096
lines=raw.decode().splitlines();assert len(lines)==1
local_ref,head,remote_ref,remote_oid=lines[0].split()
assert head==os.environ['T1789_EXPECTED_SOURCE_HEAD']
assert remote_ref==os.environ['T1789_EXPECTED_REF']
assert remote_oid==os.environ['T1789_EXPECTED_OLD_HEAD'],'Remote feature changed; normal expected-old push refused'
assert local_ref!='(delete)' and head!='0'*40
out=Path(__file__).resolve().parents[1]/'ADVERTISED-EXPECTED-OLD.json'
assert not out.exists(),'one push attempt only'
original=os.environ.get('T1789_ORIGINAL_PRE_PUSH','')
record=dict(head=head,remote_ref=remote_ref,remote_oid=remote_oid,normal_expected_old_fast_forward=True,force=False,existing_hook=original,existing_hook_returncode=None)
if original:
    assert Path(original).resolve()!=Path(__file__).resolve()
    result=subprocess.run([original,*sys.argv[1:]],input=raw)
    record['existing_hook_returncode']=result.returncode
    out.write_text(json.dumps(record,indent=2)+'\n')
    raise SystemExit(result.returncode)
out.write_text(json.dumps(record,indent=2)+'\n')

+        self.assertAlmostEqual(roof_calls[-1][5],part["back"]+1.6)
+        self.assert_valid_mesh(mesh)
+        self.assertEqual(set(mesh.conf),{1.0})
+        # The opt-in reverses the real roof plane, not the source camera or wall.

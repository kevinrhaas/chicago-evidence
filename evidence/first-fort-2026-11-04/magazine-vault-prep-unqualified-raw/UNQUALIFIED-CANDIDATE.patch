+    wall[-1] = (x1, y1, eave_z)
+    b.add_poly(wall, max(conf, c_wall), M_WALL)
+    b.add_poly([(x, y0, z) for x, _y, z in reversed(wall)], max(conf, c_wall), M_WALL)
+    return crown
 
 

+def interval_pair_results(triangle, fixed, candidates, start, end, depth, tolerance,
+                          totals, on_chunk=None):
+    """Ordered complete pair results; only original defaults use the bounded helper.
+
+    Other CLI-supported tolerances/depths retain the original scalar authority.
+    The full-circle candidate array is supplied unchanged by the original caller.
+    """
+    # Exact Python endpoints match the native CLI. NumPy endpoint arithmetic
+    # may retain another precision; preserve its original scalar semantics.
+    endpoints_supported = (type(start) in (int, float)
+                           and type(end) in (int, float)
+                           and math.isfinite(start) and math.isfinite(end)
+                           and abs(float(end) - float(start)) <= math.pi)
+    if type(depth) is not int or depth != 12 or tolerance != 1e-8 or not endpoints_supported:
+        for k in candidates:
+            result = interval_clear(triangle, fixed[k], start, end, depth, tolerance)
+            totals['scalar_fallback_pairs'] += 1
+            yield int(k), *result
+        return
+    for offset in range(0, len(candidates), INTERVAL_PAIR_CAP):
+        chunk = candidates[offset:offset + INTERVAL_PAIR_CAP]
+        if on_chunk is not None:
+            on_chunk({'candidate_offset': offset, 'candidate_count': len(chunk),
+                      'first_fixed_index': int(chunk[0]), 'last_fixed_index': int(chunk[-1]),
+                      'state': 'ENTERING_BOUNDED_INTERVAL_CHUNK'})
+        repeated = np.repeat(triangle[None], len(chunk), axis=0)
+        results, info = interval_clear_batch(repeated, fixed[chunk], start, end, depth,
+                                             tolerance, scalar=separation, turn=turn)
+        assert len(results) == len(chunk), 'Interval helper omitted or added an independent pair'
+        assert info['pairs'] == len(chunk) and info['pair_order_preserved']
+        totals['accelerated_chunks'] += 1
+        totals['helper_pairs_evaluated'] += len(chunk)
+        totals['max_pairs_per_chunk'] = max(totals['max_pairs_per_chunk'], len(chunk))
+        totals['node_visits'] += info['node_visits']
+        for key in ['scalar_fallback_rows', 'axis_cutoff_ambiguous_rows', 'decision_ambiguous_rows']:
+            totals[key] += info[key]
+        totals['max_owned_helper_workspace_bound_bytes'] = max(
+            totals['max_owned_helper_workspace_bound_bytes'], info['owned_workspace_conservative_bound_bytes'])
+        for k, result in zip(chunk, results):
+            yield int(k), *result
+
+
+def interval_batch_counters():
+    return {'accelerated_chunks': 0, 'helper_pairs_evaluated': 0, 'scalar_fallback_pairs': 0,
+            'max_pairs_per_chunk': 0, 'node_visits': 0, 'scalar_fallback_rows': 0,
+            'axis_cutoff_ambiguous_rows': 0, 'decision_ambiguous_rows': 0,
+            'max_owned_helper_workspace_bound_bytes': 0}
+

ns_url":"https://api.github.com/users/kevinrhaas/orgs","repos_url":"https://api.github.com/users/kevinrhaas/repos","events_url":"https://api.github.com/users/kevinrhaas/events{/privacy}","received_events_url":"https://api.github.com/users/kevinrhaas/received_events","type":"User","user_view_type":"public","site_admin":false},"jobs_url":"https://api.github.com/repos/kevinrhaas/chicago/actions/runs/39851513059/jobs","logs_url":"https://api.github.com/repos/kevinrhaas/chicago/actions/runs/39851513059/logs","check_suite_url":"https://api.github.com/repos/kevinrhaas/chicago/check-suites/108013548366","artifacts_url":"https://api.github.com/repos/kevinrhaas/chicago/actions/runs/39851513059/artifacts","cancel_url":"https://api.github.com/repos/kevinrhaas/chicago/actions/runs/39851513059/cancel","rerun_url":"https://api.github.com/repos/kevinrhaas/chicago/actions/runs/39851513059/rerun","previous_attempt_url":null,"workflow_url":"https://api.github.com/repos/kevinrhaas/chicago/actions/workflows/365585056","head_commit":{"id":"fe1f469bd1d7796258a4de9b33c2a911b4f3985a","tree_id":"f4af73ce48cfa384919791955bfbe38442e844c4","message":"T-3031: Glessner's stable cupola raised and narrowed to both northwest prints (#1210)\n\n* T-3031: Glessner's stable cupola raised and narrowed to both northwest prints\n\nRead through T-2758's re-solved stable-end cameras with each one's local\noffset taken out at the north gable's coping apex, HABS photograph 1 and\nthe c. 1887 Cornell view agree on the cupola's eave (41.9 / 41.75 ft) and\njointly fit a body half-width of 2.73 ft, a 0.72 ft eave, the eave at\n41.87 ft and the apex at 48.19 ft, centre S14.76 (5.3 px RMS over 12\npicks; the build as it stood read 11.5 and 13.8 px). Built: body 5.5 ft\nsquare to 42.0 ft (was 6.0, 41.0), apex 48.2 (was 47.0), eave 0.75 ft\nout (was 1.25) with a 0.5 ft flare, band 39.5-41.6 ft; S14.6 kept.\n\nNew tools/glessner_cupola_read.py writes the dated reading\ndata/comparisons/glessner/stable-cupola.json; T-2758's report re-derived\nagainst the new record. Rebaked glessner_house (archive repacked, K01\nbaseline re-measured, sidecar, source use); the three stable-end match\nrecords reviewed. L-glessner-cupola-height-3031. The dark corner strip\non the cupola's body is filed as T-3036.\n\nCo-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>\n\n* T-3031: gate the stable-cupola reading in check.sh\n\nCo-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>\n\n---------\n\nCo-authored-by: polecat-steward <steward@polecat.live>\nCo-authored-by: Claude Opus 5.5 <noreply@anthropic.com>","timestamp":"2026-10-22T20:44:52Z","author":{"name":"Kevin Haas","email":"kevinroberthaas@gmail.com"},"committer":{"name":"GitHub","email":"noreply@github.com"}},"repository":{"id":1384299918,"node_id":"R_kgDOUoK9jg","name":"chicago","full_name":"kevinrhaas/chicago","private":false,"owner":{"login":"kevinrhaas","id":4193586,"node_id":"MDQ6VXNlcjQxOTM1ODY=","avatar_url":"https://avatars.githubusercontent.com/u/4193586?v=4","gravatar_id":"","url":"https://api.github.com/users/kevinrhaas","html_url":"https://github.com/kevinrhaas","followers_url":"https://api.github.com/users/kevinrhaas/followers","following_url":"https://api.github.com/users/kevinrhaas/following{/other_user}","gists_url":"https://api.github.com/users/kevinrhaas/gists{/gist_id}","starred_url":"https://api.github.com/users/kevinrhaas/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kevinrhaas/subscriptions","organizations_url":"https://api.github.com/users/kevinrhaas/orgs","repos_url":"https://api.github.com/users/kevinrhaas/repos","events_url":"https://api.github.com/users/kevinrhaas/events{/privacy}","received_events_url":"https://api.github.com/users/kevinrhaas/received_events","type":"User","user_view_type":"public","site_admin":false},"html_url":"https://github.com/kevinrhaas/chicago","description":null,"fork":false,"url":"https://api.github.com/repos/kevinrhaas/chicago","forks_url":"https://api.github
evinrhaas/subscriptions","organizations_url":"https://api.github.com/users/kevinrhaas/orgs","repos_url":"https://api.github.com/users/kevinrhaas/repos","events_url":"https://api.github.com/users/kevinrhaas/events{/privacy}","received_events_url":"https://api.github.com/users/kevinrhaas/received_events","type":"User","user_view_type":"public","site_admin":false},"run_attempt":1,"referenced_workflows":[],"run_started_at":"2026-10-22T17:24:10Z","triggering_actor":{"login":"kevinrhaas","id":4193586,"node_id":"MDQ6VXNlcjQxOTM1ODY=","avatar_url":"https://avatars.githubusercontent.com/u/4193586?v=4","gravatar_id":"","url":"https://api.github.com/users/kevinrhaas","html_url":"https://github.com/kevinrhaas","followers_url":"https://api.github.com/users/kevinrhaas/followers","following_url":"https://api.github.com/users/kevinrhaas/following{/other_user}","gists_url":"https://api.github.com/users/kevinrhaas/gists{/gist_id}","starred_url":"https://api.github.com/users/kevinrhaas/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kevinrhaas/subscriptions","organizations_url":"https://api.github.com/users/kevinrhaas/orgs","repos_url":"https://api.github.com/users/kevinrhaas/repos","events_url":"https://api.github.com/users/kevinrhaas/events{/privacy}","received_events_url":"https://api.github.com/users/kevinrhaas/received_events","type":"User","user_view_type":"public","site_admin":false},"jobs_url":"https://api.github.com/repos/kevinrhaas/chicago/actions/runs/39822355862/jobs","logs_url":"https://api.github.com/repos/kevinrhaas/chicago/actions/runs/39822355862/logs","check_suite_url":"https://api.github.com/repos/kevinrhaas/chicago/check-suites/107930992813","artifacts_url":"https://api.github.com/repos/kevinrhaas/chicago/actions/runs/39822355862/artifacts","cancel_url":"https://api.github.com/repos/kevinrhaas/chicago/actions/runs/39822355862/cancel","rerun_url":"https://api.github.com/repos/kevinrhaas/chicago/actions/runs/39822355862/rerun","previous_attempt_url":null,"workflow_url":"https://api.github.com/repos/kevinrhaas/chicago/actions/workflows/365585056","head_commit":{"id":"ab20157759e19cac606f38094d98a4c0f8cb0145","tree_id":"2e7f995b301fe1d121b437e47d3de258fd31d8e6","message":"T-3020: 1736 Prairie's card stops showing the other McBirney house (#1201)\n\n* T-3020: 1736 Prairie's card stops showing the other McBirney house\n\nThe January 1890 Inland Architect plate \"Residence for Hugh J. McBirney\" is the\nson's Tudor stone house at 1625 Prairie. Its library record still listed the\nArt Institute's wrong catalogue address (1736) under addresses, and the library\nplaces a record on every lot its addresses name, so the plate sat on 1736's\nlot: at the top of 1736's card and in its structure grade. The address is\ndropped (the notes keep why). The June 1889 American Architect permit for\nH. J. McBirney's three-storey Burling & Whitehouse dwelling is the same 1625\nhouse and moves there too. 1736's model was built from its own c. 1890\nphotograph and is unchanged.\n\nRebuilding images.json also folds in library edits other PRs left unbuilt:\nthe three 2013 Glessner capital close-ups (now with their evidence reviews and\nimage-store entries) and three Glessner record edits; site-plan.json\nre-derives from the current street grid. Sidecar grades and the built-so-far\nwalk re-derive.\n\nCo-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>\nClaude-Session: https://claude.ai/code/session_01NJn97hJKMH2HzhAx9QwGmJ\n\n* T-3020: record the smoke parts run for this diff (mobile 3,15; desktop 3; desktop 15: all pass)\n\nCo-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>\nClaude-Session: https://claude.ai/code/session_01NJn97hJKMH2HzhAx9QwGmJ\n\n---------\n\nCo-authored-by: Claude <noreply@anthropic.com>","timestamp":"2026-10-22T17:24:06Z","author":{"name":"Kevin Haas","email":"kevinroberthaas@gmail.com"},"committer":{"name":"GitHub","email":"noreply@github.com"}},"repository":{"id":138429991
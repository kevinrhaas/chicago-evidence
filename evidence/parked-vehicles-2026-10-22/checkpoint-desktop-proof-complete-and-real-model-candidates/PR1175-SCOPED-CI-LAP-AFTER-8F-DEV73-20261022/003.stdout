tps://api.github.com/users/kevinrhaas/events{/privacy}","received_events_url":"https://api.github.com/users/kevinrhaas/received_events","type":"User","user_view_type":"public","site_admin":false},"run_attempt":1,"referenced_workflows":[],"run_started_at":"2026-10-22T17:26:59Z","triggering_actor":{"login":"kevinrhaas","id":4193586,"node_id":"MDQ6VXNlcjQxOTM1ODY=","avatar_url":"https://avatars.githubusercontent.com/u/4193586?v=4","gravatar_id":"","url":"https://api.github.com/users/kevinrhaas","html_url":"https://github.com/kevinrhaas","followers_url":"https://api.github.com/users/kevinrhaas/followers","following_url":"https://api.github.com/users/kevinrhaas/following{/other_user}","gists_url":"https://api.github.com/users/kevinrhaas/gists{/gist_id}","starred_url":"https://api.github.com/users/kevinrhaas/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kevinrhaas/subscriptions","organizations_url":"https://api.github.com/users/kevinrhaas/orgs","repos_url":"https://api.github.com/users/kevinrhaas/repos","events_url":"https://api.github.com/users/kevinrhaas/events{/privacy}","received_events_url":"https://api.github.com/users/kevinrhaas/received_events","type":"User","user_view_type":"public","site_admin":false},"jobs_url":"https://api.github.com/repos/kevinrhaas/chicago/actions/runs/39822774077/jobs","logs_url":"https://api.github.com/repos/kevinrhaas/chicago/actions/runs/39822774077/logs","check_suite_url":"https://api.github.com/repos/kevinrhaas/chicago/check-suites/107932225230","artifacts_url":"https://api.github.com/repos/kevinrhaas/chicago/actions/runs/39822774077/artifacts","cancel_url":"https://api.github.com/repos/kevinrhaas/chicago/actions/runs/39822774077/cancel","rerun_url":"https://api.github.com/repos/kevinrhaas/chicago/actions/runs/39822774077/rerun","previous_attempt_url":null,"workflow_url":"https://api.github.com/repos/kevinrhaas/chicago/actions/workflows/365585056","head_commit":{"id":"a1085d0fe5681596bf035a54fe61179f4b050ee0","tree_id":"dc1e38b3ab657ebc53d21a1bd49e24e7156e7939","message":"T-3017: 1904 parkway elms grow as open-grown American elms; leaf cards cut to their leaves (#1199)\n\nThe parkway elm drew as one straight bole under a round crown, and at the\nstreet's mid level every leaf clump was one card of the massed-clump tile,\na fan of sprays, which the owner saw as \"fans of leaves and not branches\".\n\n- tree-model.js: ARCH.ulmus_americana_vase and growElm: clear bole to about a\n  third, 2-4 co-dominant stems that fork again and arch out, branches sweeping\n  out and down, hanging twigs; leaf as sprays hung from the twigs and faced to\n  the street and the ground; every child grows from its parent's wood.\n- Every grown tree's leaf card is cut to its tile's opaque box (LEAF_CROP,\n  printed by generate_tree_atlas.py --crops): same leaves in the same place,\n  about 30% less card area for the GPU to shade and alpha-test.\n- Phone tier (`coarse`): fewer, larger sprays and no sub-pixel branches; the\n  phone's distant ring for the elms comes in to 220 m.\n- Liberty L-elm-vase-3017, changelog entry.\n\n\nClaude-Session: https://claude.ai/code/session_01NTdiK3nVcVcmWAnmkgmfQj\n\nCo-authored-by: Claude <noreply@anthropic.com>","timestamp":"2026-10-22T17:26:55Z","author":{"name":"Kevin Haas","email":"kevinroberthaas@gmail.com"},"committer":{"name":"GitHub","email":"noreply@github.com"}},"repository":{"id":1384299918,"node_id":"R_kgDOUoK9jg","name":"chicago","full_name":"kevinrhaas/chicago","private":false,"owner":{"login":"kevinrhaas","id":4193586,"node_id":"MDQ6VXNlcjQxOTM1ODY=","avatar_url":"https://avatars.githubusercontent.com/u/4193586?v=4","gravatar_id":"","url":"https://api.github.com/users/kevinrhaas","html_url":"https://github.com/kevinrhaas","followers_url":"https://api.github.com/users/kevinrhaas/followers","following_url":"https://api.github.com/users/kevinrhaas/following{/other_user}","gists_url":"https://api.github.com/users/kevinrhaas/gists{/gist_id}","starred_url
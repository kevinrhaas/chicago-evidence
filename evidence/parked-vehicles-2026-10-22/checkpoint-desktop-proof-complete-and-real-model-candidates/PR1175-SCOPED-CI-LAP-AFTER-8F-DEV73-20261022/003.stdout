ouse\nre-emits byte-identical. 1812 rebaked, the Levy side-by-side re-rendered and its match\nrecord's roof item fixed, with the south parapet the print shows recorded open for T-3034.\nThe 1915 Tribune item is a portrait and shows no part of the house.\n\nCo-authored-by: polecat-steward <steward@polecat.live>\nCo-authored-by: Claude Opus 5.5 <noreply@anthropic.com>","timestamp":"2026-10-22T23:05:09Z","author":{"name":"Kevin Haas","email":"kevinroberthaas@gmail.com"},"committer":{"name":"GitHub","email":"noreply@github.com"}},"repository":{"id":1384299918,"node_id":"R_kgDOUoK9jg","name":"chicago","full_name":"kevinrhaas/chicago","private":false,"owner":{"login":"kevinrhaas","id":4193586,"node_id":"MDQ6VXNlcjQxOTM1ODY=","avatar_url":"https://avatars.githubusercontent.com/u/4193586?v=4","gravatar_id":"","url":"https://api.github.com/users/kevinrhaas","html_url":"https://github.com/kevinrhaas","followers_url":"https://api.github.com/users/kevinrhaas/followers","following_url":"https://api.github.com/users/kevinrhaas/following{/other_user}","gists_url":"https://api.github.com/users/kevinrhaas/gists{/gist_id}","starred_url":"https://api.github.com/users/kevinrhaas/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kevinrhaas/subscriptions","organizations_url":"https://api.github.com/users/kevinrhaas/orgs","repos_url":"https://api.github.com/users/kevinrhaas/repos","events_url":"https://api.github.com/users/kevinrhaas/events{/privacy}","received_events_url":"https://api.github.com/users/kevinrhaas/received_events","type":"User","user_view_type":"public","site_admin":false},"html_url":"https://github.com/kevinrhaas/chicago","description":null,"fork":false,"url":"https://api.github.com/repos/kevinrhaas/chicago","forks_url":"https://api.github.com/repos/kevinrhaas/chicago/forks","keys_url":"https://api.github.com/repos/kevinrhaas/chicago/keys{/key_id}","collaborators_url":"https://api.github.com/repos/kevinrhaas/chicago/collaborators{/collaborator}","t
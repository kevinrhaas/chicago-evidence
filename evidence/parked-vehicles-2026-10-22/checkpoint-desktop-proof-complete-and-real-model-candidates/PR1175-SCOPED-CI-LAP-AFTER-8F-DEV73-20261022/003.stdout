m/users/kevinrhaas/received_events","type":"User","user_view_type":"public","site_admin":false},"run_attempt":1,"referenced_workflows":[],"run_started_at":"2026-10-22T17:01:34Z","triggering_actor":{"login":"kevinrhaas","id":4193586,"node_id":"MDQ6VXNlcjQxOTM1ODY=","avatar_url":"https://avatars.githubusercontent.com/u/4193586?v=4","gravatar_id":"","url":"https://api.github.com/users/kevinrhaas","html_url":"https://github.com/kevinrhaas","followers_url":"https://api.github.com/users/kevinrhaas/followers","following_url":"https://api.github.com/users/kevinrhaas/following{/other_user}","gists_url":"https://api.github.com/users/kevinrhaas/gists{/gist_id}","starred_url":"https://api.github.com/users/kevinrhaas/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kevinrhaas/subscriptions","organizations_url":"https://api.github.com/users/kevinrhaas/orgs","repos_url":"https://api.github.com/users/kevinrhaas/repos","events_url":"https://api.github.com/users/kevinrhaas/events{/privacy}","received_events_url":"https://api.github.com/users/kevinrhaas/received_events","type":"User","user_view_type":"public","site_admin":false},"jobs_url":"https://api.github.com/repos/kevinrhaas/chicago/actions/runs/39819029602/jobs","logs_url":"https://api.github.com/repos/kevinrhaas/chicago/actions/runs/39819029602/logs","check_suite_url":"https://api.github.com/repos/kevinrhaas/chicago/check-suites/107921438873","artifacts_url":"https://api.github.com/repos/kevinrhaas/chicago/actions/runs/39819029602/artifacts","cancel_url":"https://api.github.com/repos/kevinrhaas/chicago/actions/runs/39819029602/cancel","rerun_url":"https://api.github.com/repos/kevinrhaas/chicago/actions/runs/39819029602/rerun","previous_attempt_url":null,"workflow_url":"https://api.github.com/repos/kevinrhaas/chicago/actions/workflows/365585056","head_commit":{"id":"7cc10b5fb65c4ec352fe89682b829b28b1dab5f2","tree_id":"41657e8f27acead01307cf28745fd296cc082cb8","message":"T-3006: K01 rounds a corner; 1811 Prairie's entrance block turned on 0.9 m from the 1888 plate (#1196)\n\n* T-3006: K01 rounds a corner; 1811 Prairie's entrance block turned on 0.9 m from the 1888 plate\n\nK01 learns round_corner: a quarter round tangent to the street front and its side\nwall, coursed on the front's own beds in its stone and curved stone by stone, with\na dressed corbel in its last course squaring it out under the cornice, eave and\ncoped gable. 1811's south corner (K01's 'north') is laid on it at 0.9 m, and its\ncorner downpipe stands on the round where the plate draws it. Every other K01,\nK12, K13 and K16 asset re-emits byte-identical; only inputs_sha256 moved.\n\nCo-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>\n\n* T-3006: hold round_corner with its own test; the all-stone rule reads the round as the front's\n\ntools/test_k01_round_corner.py builds 1811's round and refuses a radius past a\nquarter of the block, an unknown key or corner, a pipe before the front's plane\nover the round or buried in it, a pipe behind the flat front, a bay on the round\nand a round with no stone front; check.sh runs it beside the other K01 tests.\nA pipe on the round now stands as far off the curve as a front pipe stands off\nthe front. check_stone_house_kit's as-was rule no longer reads the round, the\nstreet front's own stone turning the corner, as a stone flank.\n\nCo-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>\n\n* T-3006: rebuild the plate's source-use backlinks and measure the round corner's test step\n\ncompile_source_use.py: 1811's round_corner cites the 1888 plate, so the plate's\nbacklinks and the coverage page move. measure_step_isolation.mjs --tool: the new\ntest_k01_round_corner.py step writes nothing in-tree.\n\nCo-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>\n\n* T-3006: rebuild source-use backlinks on the merged tree\n\n---------\n\nCo-authored-by: polecat-steward <steward@polecat.live>\nCo-authored-by: Claude Opus 5.5 <noreply@anthropic.com>\nCo-authored-by: polecat-steward <polecat-steward@users.noreply.github.com>","timestamp":"2026-10-22T17:01:29Z","author":{"name":"Kevin Haas","email":"kevinroberthaas@gmail.com"},"committer":{"name":"GitHub","email":"noreply@github.com"}},"repository":{"id":1384299918,"node_id":"R_kgDOUoK9jg","name":"chicago","full_name":"kevinrhaas/chicago","private":false,"owner":{"login":"kevinrhaas","id":4193586,"node_id":"MDQ6VXNlcjQxOTM1ODY=","avatar_url":"https://avatars.githubusercontent.com/u/4193586?v=4","gravatar_id":"","url":"https://api.github.com/users/kevinrhaas","html_url":"https://github.com/kevinrhaas","followers_url":"https://api.github.com/users/kevinrhaas/followers","following_url":"https://api.github.com/users/kevinrhaas/following{/other_user}","gists_url":"https://api.github.com/users/kevinrhaas/gists{/gist_id}","starred_url":"https://api.github.com/users/kevinrhaas/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kevinrhaas/subscriptions","organizations_url":"https://api.github.com/users/kevinrhaas/orgs","repos_url":"https://api.github.com/users/kevinrhaas/repos","events_url":"https://api.github.com/users/kevinrhaas/events{/privacy}","received_events_url":"https://api.github.com/users/kevinrhaas/received_events","type":"User","user_view_type":"public","site_admin":false},"html_url":"https://github.com/kevinrhaas/chicago","description":null,"fork":false,"url":"https://api.github.com/repos/kevinrhaas/chicago","forks_url":"https://api.github.com/repos/kevinrhaas/chicago/forks","keys_url":"https://api.github.com/repos/kevinrhaas/chicago/keys{/key_id}","collaborators_url":"https://api.github.com/repos/kevinrhaas/chicago/collaborators{/collaborator}","teams_url":"https://api.github.com/repos/kevinrhaas/chicago/teams","hooks_url":"https://api.github.com/repos/kevinrhaas/chicago/hooks","issue_events_url":"https://api.github.com/repos/kevinrhaas/chicago/issues/events{/number}","events_url":"https://api.github.com/repos/kevinrhaas/chicago/events","assignees_ur
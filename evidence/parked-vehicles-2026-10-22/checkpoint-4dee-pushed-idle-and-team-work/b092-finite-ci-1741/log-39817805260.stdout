2026-10-22T16:57:16.1481243Z [36;1mset -uo pipefail[0m
2026-10-22T16:57:16.1481674Z [36;1m# An explicit ask is always honoured: a dispatch names what it wants and[0m
2026-10-22T16:57:16.1482187Z [36;1m# the nightly schedule is the whole point of the workflow. Only `push`[0m
2026-10-22T16:57:16.1482596Z [36;1m# is filtered, because only `push` fans out.[0m
2026-10-22T16:57:16.1482917Z [36;1mif [ "$EV" != "push" ]; then[0m
2026-10-22T16:57:16.1483196Z [36;1m  echo "bake=1" >> "$GITHUB_OUTPUT"[0m
2026-10-22T16:57:16.1483542Z [36;1m  echo "::notice::baking — event is $EV, not a push"; exit 0[0m
2026-10-22T16:57:16.1483863Z [36;1mfi[0m
2026-10-22T16:57:16.1484170Z [36;1m# `dev` itself always bakes. It is the authoritative copy, and it is the[0m
2026-10-22T16:57:16.1484611Z [36;1m# run whose output every branch would otherwise duplicate.[0m
2026-10-22T16:57:16.1484956Z [36;1mif [ "$REF" = "$BASE" ]; then[0m
2026-10-22T16:57:16.1485564Z [36;1m  echo "bake=1" >> "$GITHUB_OUTPUT"[0m
2026-10-22T16:57:16.1485879Z [36;1m  echo "::notice::baking — this is $BASE"; exit 0[0m
2026-10-22T16:57:16.1486170Z [36;1mfi[0m
2026-10-22T16:57:16.1486382Z [36;1mgit fetch origin "$BASE" -q || true[0m
2026-10-22T16:57:16.1486730Z [36;1mCHANGED=$(git diff --name-only "origin/$BASE...HEAD" -- \[0m
2026-10-22T16:57:16.1487089Z [36;1m            'chicago/4d/generators/**' \[0m
2026-10-22T16:57:16.1487391Z [36;1m            'chicago/4d/tools/bake.sh' \[0m
2026-10-22T16:57:16.1487752Z [36;1m            '.github/workflows/chicago-4d-bake.yml' 2>/dev/null)[0m
2026-10-22T16:57:16.1488082Z [36;1mRC=$?[0m
2026-10-22T16:57:16.1488381Z [36;1m# FAIL OPEN, the same way --check-base does. If the diff cannot be taken[0m
2026-10-22T16:57:16.1488848Z [36;1m# — a shallow clone, a base that never fetched — the safe answer is to[0m
2026-10-22T16:57:16.1489301Z [36;1m# bake: a redundant bake costs twenty minutes, a skipped one that was[0m
2026-10-22T16:57:16.1489766Z [36;1m# needed ships stale meshes and the staleness gate then blames the PR.[0m
2026-10-22T16:57:16.1490134Z [36;1mif [ "$RC" -ne 0 ]; then[0m
2026-10-22T16:57:16.1490392Z [36;1m  echo "bake=1" >> "$GITHUB_OUTPUT"[0m
2026-10-22T16:57:16.1490834Z [36;1m  echo "::warning::baking — could not diff against $BASE (exit $RC), so not skipping"; exit 0[0m
2026-10-22T16:57:16.1491248Z [36;1mfi[0m
2026-10-22T16:57:16.1491614Z [36;1mif [ -z "$CHANGED" ]; then[0m
2026-10-22T16:57:16.1491883Z [36;1m  echo "bake=0" >> "$GITHUB_OUTPUT"[0m
2026-10-22T16:57:16.1492304Z [36;1m  echo "::notice::SKIPPING — nothing this branch owns under generators/, tools/bake.sh"[0m
2026-10-22T16:57:16.1492863Z [36;1m  echo "::notice::or this workflow differs from $BASE. Any generators change here came"[0m
2026-10-22T16:57:16.1493375Z [36;1m  echo "::notice::in with the PR lap's merge, and $BASE's own bake covers it."[0m
2026-10-22T16:57:16.1493752Z [36;1m  exit 0[0m
2026-10-22T16:57:16.1493948Z [36;1mfi[0m
2026-10-22T16:57:16.1494230Z [36;1mecho "::notice::this branch's own diff against $BASE touches:"[0m
2026-10-22T16:57:16.1494593Z [36;1mprintf '%s\n' "$CHANGED" | sed 's/^/  /'[0m
2026-10-22T16:57:16.1494975Z [36;1m# SECOND SCREEN, T-1668: the path filter above says this branch could[0m
2026-10-22T16:57:16.1495620Z [36;1m# have staled a mesh. Whether it DID is a question the freshness[0m
2026-10-22T16:57:16.1496073Z [36;1m# register answers in about half a second, and it is the same register[0m
2026-10-22T16:57:16.1496532Z [36;1m# `check.sh` refuses the tree with — so ask it rather than spending[0m
2026-10-22T16:57:16.1497004Z [36;1m# twenty-five minutes of Cycles to find out. The rule, its fail-open[0m
2026-10-22T16:57:16.1497480Z [36;1m# cases and its self-test live in tools/bake_warranted.py; a green pull[0m
2026-10-22T16:57:16.1497930Z [36;1m# request that could not merge inside its own run is why.[0m
2026-10-22T16:57:16.1498493Z [36;1m# Glessner's GLBs are ignored outputs restored from the committed[0m
2026-10-22T16:57:16.1498942Z [36;1m# recovery package. A fresh checkout must materialize that package[0m
2026-10-22T16:57:16.1499407Z [36;1m# before asking whether an output is missing or stale, just as publish[0m
2026-10-22T16:57:16.1499867Z [36;1m# does. The recovery verifier refuses mismatched existing bytes; an[0m
2026-10-22T16:57:16.1500326Z [36;1m# unreadable package keeps the existing fail-open bake decision.[0m
2026-10-22T16:57:16.1500807Z [36;1mif ! python3 chicago/4d/tools/recover_glessner_v4.py --materialize; then[0m
2026-10-22T16:57:16.1501203Z [36;1m  echo "bake=1" >> "$GITHUB_OUTPUT"[0m
2026-10-22T16:57:16.1501715Z [36;1m  echo "::warning::baking — committed asset package could not be materialized, so freshness cannot be established"[0m
2026-10-22T16:57:16.1502205Z [36;1m  exit 0[0m
2026-10-22T16:57:16.1502400Z [36;1mfi[0m
2026-10-22T16:57:16.1502589Z [36;1mWHY=$(mktemp)[0m
2026-10-22T16:57:16.1502830Z [36;1mBAKE=$(printf '%s\n' "$CHANGED" \[0m
2026-10-22T16:57:16.1503164Z [36;1m         | python3 chicago/4d/tools/bake_warranted.py \[0m
2026-10-22T16:57:16.1503536Z [36;1m             --decide --base "origin/$BASE" 2>"$WHY") || BAKE=1[0m
2026-10-22T16:57:16.1503957Z [36;1m# A verdict that is neither answer is not a verdict. Anything else the[0m
2026-10-22T16:57:16.1504415Z [36;1m# script could have printed — nothing at all, a traceback's tail — is[0m
2026-10-22T16:57:16.1504806Z [36;1m# unanswerable, and unanswerable bakes.[0m
2026-10-22T16:57:16.1505094Z [36;1mcase "$BAKE" in[0m
2026-10-22T16:57:16.1505490Z [36;1m  0|1) ;;[0m
2026-10-22T16:57:16.1505841Z [36;1m  *) BAKE=1; echo "bake_warranted.py answered '$BAKE', which is not 0 or 1" >"$WHY" ;;[0m
2026-10-22T16:57:16.1506248Z [36;1mesac[0m
2026-10-22T16:57:16.1506471Z [36;1mecho "bake=$BAKE" >> "$GITHUB_OUTPUT"[0m
2026-10-22T16:57:16.1506760Z [36;1mif [ "$BAKE" = "1" ]; then[0m
2026-10-22T16:57:16.1507034Z [36;1m  echo "::notice::$(tr '\n' ' ' <"$WHY")"[0m
2026-10-22T16:57:16.1507312Z [36;1melse[0m
2026-10-22T16:57:16.1507566Z [36;1m  echo "::notice::SKIPPING — $(tr '\n' ' ' <"$WHY")"[0m
2026-10-22T16:57:16.1507869Z [36;1mfi[0m

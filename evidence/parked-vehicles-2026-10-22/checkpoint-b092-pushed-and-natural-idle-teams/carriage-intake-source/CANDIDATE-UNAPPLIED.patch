+    def side_part(name,sign):
+        ps=[p for p in selected(name) if (p['bounds_root_m']['min'][0]+p['bounds_root_m']['max'][0])*sign>0]
+        if len(ps)!=1:raise ValueError('One measured source '+name+' required per side')
+        return ps[0]
+    def one(name):
+        ps=selected(name)

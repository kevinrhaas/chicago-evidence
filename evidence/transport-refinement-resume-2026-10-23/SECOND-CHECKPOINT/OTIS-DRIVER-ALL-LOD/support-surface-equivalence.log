async function faces(name){const b=read('inputs/'+name),j=glb(b).j,l=new GLTFLoader();l.setMeshoptDecoder(MeshoptDecoder);l.register(()=>({name:'CPU_NO_TEXTURE_LOAD',loadTexture:()=>Promise.resolve(null)}));const g=await l.parseAsync(b.buffer.slice(b.byteOffset,b.byteOffset+b.byteLength),'');g.scene.updateMatrixWorld(true);const obj=[];g.scene.traverse(o=>{if(o.isMesh&&o.name==='vehicle_body_timber')obj.push(o);});assert.equal(obj.length,1);const m=obj[0],a=m.geometry.attributes.position,ix=m.geometry.index.array,ps=Array.from({length:a.count},(_,i)=>V.fromBufferAttribute(a,i).applyMatrix4(m.matrixWorld).toArray()),out={};for(const partname of['driver_bench_plank','driver_footboard']){const part=j.extras.driver_furniture.parts.find(x=>x.name===partname),tris=[];for(let i=0;i<ix.length;i+=3){const tr=[ps[ix[i]],ps[ix[i+1]],ps[ix[i+2]]];if(tr.every(q=>Math.abs(q[1]-part.max_m[1])<1e-6&&q[0]>=part.min_m[0]-1e-6&&q[0]<=part.max_m[0]+1e-6&&q[2]>=part.min_m[2]-1e-6&&q[2]<=part.max_m[2]+1e-6))tris.push(tr.map(v=>JSON.stringify(v)).sort());}assert.equal(tris.length,2);out[partname]={triangles:tris.sort(),sha256:sha(Buffer.from(JSON.stringify(tris.sort())))};}return{sha256:sha(b),surfaces:out};}

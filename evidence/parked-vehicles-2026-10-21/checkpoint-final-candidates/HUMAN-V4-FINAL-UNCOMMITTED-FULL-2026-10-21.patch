+def _slab_points(triangles,lo,hi):
+    result=[]
+    for tri in triangles:
+        poly=[{'p':p,'uv':[],'n':[],'w':{},'basis':{i:1.}} for i,p in enumerate(tri)]
+        poly=_clip(_clip(poly,lambda v:v['p'][1]-lo),lambda v:hi-v['p'][1])
+        result.extend(v['p'] for v in poly)
+    return result

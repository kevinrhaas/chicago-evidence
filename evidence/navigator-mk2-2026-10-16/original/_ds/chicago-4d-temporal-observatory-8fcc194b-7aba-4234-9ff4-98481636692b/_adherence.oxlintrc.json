{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/brand/**",
              "components/controls/**",
              "components/destinations/**",
              "components/instruments/**",
              "components/overlays/**",
              "components/records/**",
              "dev/**",
              "ui_kits/observatory/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Barlow|Barlow Semi Condensed|Instrument Serif|IBM Plex Mono|Cormorant Garamond|Cormorant SC|Courier Prime|League Spartan|Jost|Space Mono|Saira|Share Tech Mono))/i]",
        "message": "Font not provided by the design system. Available: Barlow, Barlow Semi Condensed, Instrument Serif, IBM Plex Mono, Cormorant Garamond, Cormorant SC, Courier Prime, League Spartan, Jost, Space Mono, Saira, Share Tech Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='AcquisitionStatus'] > JSXAttribute > JSXIdentifier[name!=/^(?:message|count|busy|key|ref|className|style|children)$/]",
        "message": "<AcquisitionStatus> doesn't accept that prop. Declared props: message, count, busy."
      },
      {
        "selector": "JSXOpeningElement[name.name='BrandMark'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|code|name|href|showWordmark|key|ref|className|style|children)$/]",
        "message": "<BrandMark> doesn't accept that prop. Declared props: size, code, name, href, showWordmark."
      },
      {
        "selector": "JSXOpeningElement[name.name='Fact'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|grade|wide|key|ref|className|style|children)$/]",
        "message": "<Fact> doesn't accept that prop. Declared props: label, value, grade, wide."
      },
      {
        "selector": "JSXOpeningElement[name.name='Fact'] > JSXAttribute[name.name='grade'] > Literal[value!=/^(?:documented|inferred|conjectural)$/]",
        "message": "<Fact> grade must be one of 'documented' | 'inferred' | 'conjectural'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chronometer'] > JSXAttribute > JSXIdentifier[name!=/^(?:phase|size|note|imageSrc|label|key|ref|className|style|children)$/]",
        "message": "<Chronometer> doesn't accept that prop. Declared props: phase, size, note, imageSrc, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chronometer'] > JSXAttribute[name.name='phase'] > Literal[value!=/^(?:scan|lock|arrive)$/]",
        "message": "<Chronometer> phase must be one of 'scan' | 'lock' | 'arrive'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ConfidenceGrade'] > JSXAttribute > JSXIdentifier[name!=/^(?:grade|label|chip|showLabel|key|ref|className|style|children)$/]",
        "message": "<ConfidenceGrade> doesn't accept that prop. Declared props: grade, label, chip, showLabel."
      },
      {
        "selector": "JSXOpeningElement[name.name='ConfidenceGrade'] > JSXAttribute[name.name='grade'] > Literal[value!=/^(?:documented|inferred|conjectural)$/]",
        "message": "<ConfidenceGrade> grade must be one of 'documented' | 'inferred' | 'conjectural'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DepartureOverlay'] > JSXAttribute > JSXIdentifier[name!=/^(?:year|eyebrow|message|open|inline|onAbort|abortLabel|children|key|ref|className|style|children)$/]",
        "message": "<DepartureOverlay> doesn't accept that prop. Declared props: year, eyebrow, message, open, inline, onAbort, abortLabel, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='EngageButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|arrow|disabled|href|onClick|type|key|ref|className|style|children)$/]",
        "message": "<EngageButton> doesn't accept that prop. Declared props: children, variant, size, arrow, disabled, href, onClick, type."
      },
      {
        "selector": "JSXOpeningElement[name.name='EngageButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost)$/]",
        "message": "<EngageButton> variant must be one of 'primary' | 'secondary' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='EngageButton'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<EngageButton> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='EngageButton'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit)$/]",
        "message": "<EngageButton> type must be one of 'button' | 'submit'."
      },
      {
        "selector": "JSXOpeningElement[name.name='EraArt'] > JSXAttribute > JSXIdentifier[name!=/^(?:kind|key|ref|className|style|children)$/]",
        "message": "<EraArt> doesn't accept that prop. Declared props: kind."
      },
      {
        "selector": "JSXOpeningElement[name.name='EraArt'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:town|avenue|shore)$/]",
        "message": "<EraArt> kind must be one of 'town' | 'avenue' | 'shore'."
      },
      {
        "selector": "JSXOpeningElement[name.name='EraCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:index|name|year|title|body|state|pending|primary|imageSrc|art|footLeft|footRight|href|onClick|key|ref|className|style|children)$/]",
        "message": "<EraCard> doesn't accept that prop. Declared props: index, name, year, title, body, state, pending, primary, imageSrc, art, footLeft, footRight, href, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='EraCard'] > JSXAttribute[name.name='art'] > Literal[value!=/^(?:town|avenue|shore)$/]",
        "message": "<EraCard> art must be one of 'town' | 'avenue' | 'shore'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IndicatorLamp'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|on|blink|tone|size|key|ref|className|style|children)$/]",
        "message": "<IndicatorLamp> doesn't accept that prop. Declared props: label, on, blink, tone, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='Machine'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|name|code|swatch|key|ref|className|style|children)$/]",
        "message": "<Machine> doesn't accept that prop. Declared props: id, name, code, swatch."
      },
      {
        "selector": "JSXOpeningElement[name.name='Masthead'] > JSXAttribute > JSXIdentifier[name!=/^(?:station|status|href|children|key|ref|className|style|children)$/]",
        "message": "<Masthead> doesn't accept that prop. Declared props: station, status, href, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Pill'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|pressed|count|disabled|onClick|key|ref|className|style|children)$/]",
        "message": "<Pill> doesn't accept that prop. Declared props: children, pressed, count, disabled, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='Placard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|note|glyph|tone|key|ref|className|style|children)$/]",
        "message": "<Placard> doesn't accept that prop. Declared props: title, note, glyph, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='Placard'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:solid|stripe)$/]",
        "message": "<Placard> tone must be one of 'solid' | 'stripe'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ResultRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|sub|distance|bearing|grade|active|onClick|key|ref|className|style|children)$/]",
        "message": "<ResultRow> doesn't accept that prop. Declared props: name, sub, distance, bearing, grade, active, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='ResultRow'] > JSXAttribute[name.name='grade'] > Literal[value!=/^(?:documented|inferred|conjectural)$/]",
        "message": "<ResultRow> grade must be one of 'documented' | 'inferred' | 'conjectural'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SearchField'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|placeholder|label|key|ref|className|style|children)$/]",
        "message": "<SearchField> doesn't accept that prop. Declared props: value, onChange, placeholder, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionLine'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|meta|metaValue|children|key|ref|className|style|children)$/]",
        "message": "<SectionLine> doesn't accept that prop. Declared props: title, meta, metaValue, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='TabItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|count|key|ref|className|style|children)$/]",
        "message": "<TabItem> doesn't accept that prop. Declared props: id, label, count."
      },
      {
        "selector": "JSXOpeningElement[name.name='TelemetryItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|state|key|ref|className|style|children)$/]",
        "message": "<TelemetryItem> doesn't accept that prop. Declared props: label, value, state."
      },
      {
        "selector": "JSXOpeningElement[name.name='TelemetryItem'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:normal|ok|warn|alert)$/]",
        "message": "<TelemetryItem> state must be one of 'normal' | 'ok' | 'warn' | 'alert'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toggle'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|checked|onChange|detail|key|ref|className|style|children)$/]",
        "message": "<Toggle> doesn't accept that prop. Declared props: label, checked, onChange, detail."
      },
      {
        "selector": "JSXOpeningElement[name.name='TransitSequence'] > JSXAttribute > JSXIdentifier[name!=/^(?:steps|current|key|ref|className|style|children)$/]",
        "message": "<TransitSequence> doesn't accept that prop. Declared props: steps, current."
      },
      {
        "selector": "JSXOpeningElement[name.name='YearReadout'] > JSXAttribute > JSXIdentifier[name!=/^(?:year|label|size|key|ref|className|style|children)$/]",
        "message": "<YearReadout> doesn't accept that prop. Declared props: year, label, size."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],

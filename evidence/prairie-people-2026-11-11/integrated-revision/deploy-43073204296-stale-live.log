2026-11-11T18:07:20.6849660Z ##[group]Run set -e
2026-11-11T18:07:20.6850036Z [36;1mset -e[0m
2026-11-11T18:07:20.6850409Z [36;1m# `node --check` parses a bare .js as CommonJS, so any ES module[0m
2026-11-11T18:07:20.6851006Z [36;1m# (top-level import/export) fails spuriously. Parse each file as a[0m
2026-11-11T18:07:20.6851502Z [36;1m# module instead — the Joliet game bundle under site/joliet/app/ is[0m
2026-11-11T18:07:20.6851984Z [36;1m# ESM, and its Babylon chunk is several MB, so this also keeps the[0m
2026-11-11T18:07:20.6852464Z [36;1m# check off stdin size limits by pointing at the file directly.[0m
2026-11-11T18:07:20.6852828Z [36;1m#[0m
2026-11-11T18:07:20.6853166Z [36;1m# WALKS THE TREE, NOT THE INDEX (T-0938). This was `git ls-files 'site/**/*.js'`,[0m
2026-11-11T18:07:20.6853670Z [36;1m# which enumerates what is COMMITTED — and the whole of site/4d/ is[0m
2026-11-11T18:07:20.6854407Z [36;1m# generated now, so the 4D renderer's modules would have dropped straight out of[0m
2026-11-11T18:07:20.6854998Z [36;1m# the check that exists to stop a syntax error shipping as a blank page. `find`[0m
2026-11-11T18:07:20.6855547Z [36;1m# asks the tree that is about to be uploaded, which is the tree the question is[0m
2026-11-11T18:07:20.6856019Z [36;1m# about. It runs after the publish above for the same reason.[0m
2026-11-11T18:07:20.6856372Z [36;1mfail=0[0m
2026-11-11T18:07:20.6856650Z [36;1mfor f in $(find site -name '*.js' -type f | sort); do[0m
2026-11-11T18:07:20.6857063Z [36;1m  if ! node --input-type=module --check < "$f" >/dev/null 2>&1; then[0m
2026-11-11T18:07:20.6857495Z [36;1m    # Fall back to script parsing for genuine classic scripts.[0m
2026-11-11T18:07:20.6857874Z [36;1m    if ! node --check "$f" >/dev/null 2>&1; then[0m
2026-11-11T18:07:20.6858183Z [36;1m      echo "SYNTAX FAIL: $f"; fail=1[0m
2026-11-11T18:07:20.6858582Z [36;1m    fi[0m
2026-11-11T18:07:20.6858780Z [36;1m  fi[0m
2026-11-11T18:07:20.6858969Z [36;1mdone[0m
2026-11-11T18:07:20.6859183Z [36;1m[ "$fail" -eq 0 ] || exit 1[0m
2026-11-11T18:07:20.6859438Z [36;1mecho "JS OK"[0m

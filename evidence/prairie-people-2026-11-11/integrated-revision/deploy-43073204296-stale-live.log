2026-11-11T18:07:42.1560256Z ##[group]Run if git fetch origin dev 2>/dev/null; then
2026-11-11T18:07:42.1560746Z [36;1mif git fetch origin dev 2>/dev/null; then[0m
2026-11-11T18:07:42.1561095Z [36;1m  sha="$(git rev-parse --short FETCH_HEAD)"[0m
2026-11-11T18:07:42.1561489Z [36;1m  # The dev HEAD's own commit date, so the preview gate can say how[0m
2026-11-11T18:07:42.1561948Z [36;1m  # old the build is. NOT `date` here: this job also runs on deploys[0m
2026-11-11T18:07:42.1562431Z [36;1m  # of main that leave dev untouched, and an assembly time would age[0m
2026-11-11T18:07:42.1562824Z [36;1m  # the stamp on a branch that never moved.[0m
2026-11-11T18:07:42.1563165Z [36;1m  when="$(git show -s --format=%cI FETCH_HEAD)"[0m
2026-11-11T18:07:42.1563502Z [36;1m  git worktree add _dev-src FETCH_HEAD[0m
2026-11-11T18:07:42.1563907Z [36;1m  # The preview copies _dev-src/site/4d wholesale, and that directory[0m
2026-11-11T18:07:42.1564449Z [36;1m  # does not exist in a fresh worktree: the mirror is generated, not committed[0m
2026-11-11T18:07:42.1564971Z [36;1m  # (T-0938; T-0937 for the board inside it). So the dev worktree gets its own[0m
2026-11-11T18:07:42.1565479Z [36;1m  # publish, exactly as the production tree does above — otherwise /dev/ would[0m
2026-11-11T18:07:42.1566025Z [36;1m  # be an empty preview while production looked fine, which is the failure this[0m
2026-11-11T18:07:42.1566534Z [36;1m  # tier exists to catch. DEV-only delivery refuses any failure before[0m
2026-11-11T18:07:42.1567020Z [36;1m  # upload; the explicit production mode retains its existing fallback.[0m
2026-11-11T18:07:42.1567470Z [36;1m  if ! (cd _dev-src/chicago/4d && bash tools/publish.sh); then[0m
2026-11-11T18:07:42.1567840Z [36;1m    if [ "$DELIVERY_MODE" = dev ]; then[0m
2026-11-11T18:07:42.1568286Z [36;1m      echo '::error::DEV publication failed; refusing to upload a stale or partial preview'[0m
2026-11-11T18:07:42.1568858Z [36;1m      exit 1[0m
2026-11-11T18:07:42.1569092Z [36;1m    fi[0m
2026-11-11T18:07:42.1569408Z [36;1m    echo '::warning::dev-preview: 4D publish failed in the dev worktree'[0m
2026-11-11T18:07:42.1569764Z [36;1m  fi[0m
2026-11-11T18:07:42.1570084Z [36;1m  node .github/chicago-4d-dev-preview.mjs _dev-src "$sha" "$when"[0m
2026-11-11T18:07:42.1570569Z [36;1m  # T-2947: the preview step rewrites every page and build.json, so the dev[0m
2026-11-11T18:07:42.1571059Z [36;1m  # packs are listed again from what it wrote, with dev's own tool.[0m
2026-11-11T18:07:42.1571807Z [36;1m  if [ -f _dev-src/chicago/4d/tools/write_year_packs.mjs ] && [ -d site/4d/dev/packs ]; then[0m
2026-11-11T18:07:42.1572333Z [36;1m    node _dev-src/chicago/4d/tools/write_year_packs.mjs site/4d/dev[0m
2026-11-11T18:07:42.1572841Z [36;1m    if ! node _dev-src/chicago/4d/tools/write_year_packs.mjs --check site/4d/dev; then[0m
2026-11-11T18:07:42.1573276Z [36;1m      if [ "$DELIVERY_MODE" = dev ]; then[0m
2026-11-11T18:07:42.1573686Z [36;1m        echo '::error::DEV year packs failed their owning check; refusing upload'[0m
2026-11-11T18:07:42.1574066Z [36;1m        exit 1[0m
2026-11-11T18:07:42.1574300Z [36;1m      fi[0m
2026-11-11T18:07:42.1574577Z [36;1m      echo '::warning::dev year packs do not match the preview'[0m
2026-11-11T18:07:42.1574904Z [36;1m    fi[0m
2026-11-11T18:07:42.1575100Z [36;1m  fi[0m
2026-11-11T18:07:42.1575327Z [36;1m  git worktree remove --force _dev-src[0m
2026-11-11T18:07:42.1575606Z [36;1melse[0m
2026-11-11T18:07:42.1575825Z [36;1m  if [ "$DELIVERY_MODE" = dev ]; then[0m
2026-11-11T18:07:42.1576229Z [36;1m    echo '::error::DEV ref fetch failed; refusing to upload the old seeded preview'[0m
2026-11-11T18:07:42.1576615Z [36;1m    exit 1[0m
2026-11-11T18:07:42.1576826Z [36;1m  fi[0m
2026-11-11T18:07:42.1577093Z [36;1m  echo "dev-preview: no 'dev' ref yet — skipping /4d/dev/"[0m
2026-11-11T18:07:42.1577417Z [36;1mfi[0m
